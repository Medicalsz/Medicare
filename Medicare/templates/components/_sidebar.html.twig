<aside class="sidebar">

    <div class="sidebar-mobile-header">
        <div class="sidebar-logo">
            <img src="{{ asset('assets/img/logomedicare.png') }}" alt="Medicare">
            <span>Medicare</span>
        </div>
        <button class="close-sidebar" id="closeSidebar">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <nav class="sidebar-nav">

        <!-- Dashboard -->
        <a href="{{ path('app_dashboard') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-home"></i></span>
            <span class="nav-text">Dashboard</span>
        </a>

        <!-- Mes rendez-vous -->
        <a href="{{ path('app_appointments') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_appointments' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-calendar-alt"></i></span>
            <span class="nav-text">Mes rendez-vous</span>
        </a>

        <!-- Cabinets -->
        <a href="{{ path('app_cabinets') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_cabinets' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-hospital"></i></span>
            <span class="nav-text">Cabinets</span>
        </a>

        <!-- Consultations -->
        <a href="{{ path('app_consultations') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_consultations' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-clipboard-list"></i></span>
            <span class="nav-text">Mes consultations</span>
        </a>

        <!-- Forum -->
        <a href="{{ path('app_user_forum_index') }}" class="nav-item {{ app.request.attributes.get('_route') starts with 'app_user_forum_' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-comments"></i></span>
            <span class="nav-text">Forum</span>
        </a>

        <!-- Chat Resumeur -->
        <a href="{{ path('app_chat_resume') }}" class="nav-item {{ app.request.attributes.get('_route') starts with 'app_chat_resume' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-robot"></i></span>
            <span class="nav-text">Chat Resumeur</span>
        </a>

        {% if 'ROLE_PATIENT' in app.user.roles and 'ROLE_MEDECIN' not in app.user.roles %}
        <div class="nav-divider"></div>

        <a href="{{ path('app_demande_medecin') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_demande_medecin' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-stethoscope"></i></span>
            <span class="nav-text">Devenir médecin</span>
        </a>
        {% endif %}

        <div class="nav-divider"></div>

        <!-- Profil -->
        <a href="{{ path('app_profile') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_profile' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-user"></i></span>
            <span class="nav-text">Mon profil</span>
        </a>

        <!-- Paramètres -->
        <a href="{{ path('app_settings') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_settings' ? 'active' : '' }}">
            <span class="nav-icon"><i class="fas fa-cog"></i></span>
            <span class="nav-text">Paramètres</span>
        </a>

    </nav>

    <div class="sidebar-footer">

        <div class="user-profile">
            <div class="user-avatar">
                <span>{{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}</span>
            </div>

            <div class="user-details">
                <div class="user-name">{{ app.user.prenom }} {{ app.user.nom }}</div>

                <div class="user-role">
                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        Administrateur
                    {% elseif 'ROLE_MEDECIN' in app.user.roles %}
                        Médecin
                    {% else %}
                        Patient
                    {% endif %}
                </div>
            </div>
        </div>

        <a href="{{ path('app_logout') }}" class="logout-btn">
            <i class="fas fa-sign-out-alt"></i>
        </a>

    </div>

</aside>
