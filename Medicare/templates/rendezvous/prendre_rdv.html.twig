{% extends 'rendezvous_base.html.twig' %}

{% block title %}Prendre rendez-vous - Medicare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .rdv-card {
            background: white;
            border-radius: 20px;
            padding: 50px;
            max-width: 900px;
            width: 100%;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        }

        /* Stepper */
        .stepper {
            display: flex;
            justify-content: space-between;
            margin-bottom: 50px;
            position: relative;
        }

        .stepper::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            height: 2px;
            background: #e0e0e0;
            z-index: 0;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 1;
            flex: 1;
        }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e0e0e0;
            color: #999;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            margin-bottom: 10px;
            transition: all 0.3s ease;
        }

        .step.active .step-number {
            background: #00BFFF;
            color: white;
            box-shadow: 0 0 0 4px rgba(0, 191, 255, 0.2);
        }

        .step.completed .step-number {
            background: #4CAF50;
            color: white;
        }

        .step-label {
            font-size: 13px;
            color: #999;
            text-align: center;
            font-weight: 500;
        }

        .step.active .step-label {
            color: #00BFFF;
            font-weight: 600;
        }

        /* Étapes */
        .step-content {
            display: none;
        }

        .step-content.active {
            display: block;
        }

        .step-title {
            font-size: 28px;
            color: #1a1a1a;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .step-description {
            color: #666;
            margin-bottom: 30px;
            font-size: 15px;
        }

        /* Choix cards */
        .choice-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .choice-card {
            background: #f8f9fa;
            border: 2px solid #e0e0e0;
            border-radius: 15px;
            padding: 30px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .choice-card:hover {
            border-color: #00BFFF;
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0, 191, 255, 0.2);
        }

        .choice-card.selected {
            background: #e6f7ff;
            border-color: #00BFFF;
            box-shadow: 0 5px 20px rgba(0, 191, 255, 0.3);
        }

        .choice-icon {
            font-size: 50px;
            margin-bottom: 15px;
            color: #00BFFF;
        }

        .choice-title {
            font-size: 18px;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 8px;
        }

        .choice-description {
            font-size: 13px;
            color: #666;
        }

        /* Spécialités */
        .specialties-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .specialty-card {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 20px 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .specialty-card:hover {
            border-color: #00BFFF;
            transform: translateY(-3px);
        }

        .specialty-card.selected {
            background: #00BFFF;
            border-color: #00BFFF;
            color: white;
        }

        .specialty-icon {
            font-size: 35px;
            margin-bottom: 10px;
        }

        .specialty-name {
            font-size: 14px;
            font-weight: 600;
        }

        /* Boutons */
        .step-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
            gap: 15px;
        }

        .btn {
            padding: 14px 30px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 15px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-prev {
            background: #f0f0f0;
            color: #666;
        }

        .btn-prev:hover {
            background: #e0e0e0;
        }

        .btn-next {
            background: #00BFFF;
            color: white;
            flex: 1;
            justify-content: center;
        }

        .btn-next:hover {
            background: #00A8E6;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 191, 255, 0.4);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            .rdv-card {
                padding: 30px 20px;
            }

            .step-label {
                font-size: 11px;
            }

            .step-number {
                width: 35px;
                height: 35px;
            }

            .step-title {
                font-size: 22px;
            }

            .choice-grid {
                grid-template-columns: 1fr;
            }

            .specialties-grid {
                grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="rdv-card">
    <!-- Stepper -->
    <div class="stepper">
        <div class="step active" data-step="1">
            <div class="step-number">1</div>
            <div class="step-label">Pour qui</div>
        </div>
        <div class="step" data-step="2">
            <div class="step-number">2</div>
            <div class="step-label">Spécialité</div>
        </div>
        <div class="step" data-step="3">
            <div class="step-number">3</div>
            <div class="step-label">Docteur</div>
        </div>
        <div class="step" data-step="4">
            <div class="step-number">4</div>
            <div class="step-label">Date & Infos</div>
        </div>
        <div class="step" data-step="5">
            <div class="step-number">5</div>
            <div class="step-label">Confirmation</div>
        </div>
    </div>

    <!-- Étape 1 : Pour qui -->
    <div class="step-content active" data-step="1">
        <h2 class="step-title">Pour qui est ce rendez-vous ?</h2>
        <p class="step-description">Sélectionnez pour qui vous prenez rendez-vous</p>

        <div class="choice-grid">
            <div class="choice-card" data-choice="me">
                <div class="choice-icon">
                    <i class="fas fa-user"></i>
                </div>
                <div class="choice-title">Pour moi</div>
                <div class="choice-description">Mes informations seront utilisées</div>
            </div>

            <div class="choice-card" data-choice="other">
                <div class="choice-icon">
                    <i class="fas fa-user-friends"></i>
                </div>
                <div class="choice-title">Pour un proche</div>
                <div class="choice-description">Vous remplirez ses informations</div>
            </div>
        </div>
    </div>

    <!-- Étape 2 : Spécialité -->
    <div class="step-content" data-step="2">
        <h2 class="step-title">Quelle spécialité recherchez-vous ?</h2>
        <p class="step-description">Choisissez le type de médecin dont vous avez besoin</p>

        <div class="specialties-grid">
            <div class="specialty-card" data-specialty="generaliste">
                <div class="specialty-icon">🩺</div>
                <div class="specialty-name">Généraliste</div>
            </div>
            <div class="specialty-card" data-specialty="cardiologue">
                <div class="specialty-icon">❤️</div>
                <div class="specialty-name">Cardiologue</div>
            </div>
            <div class="specialty-card" data-specialty="dermatologue">
                <div class="specialty-icon">✨</div>
                <div class="specialty-name">Dermatologue</div>
            </div>
            <div class="specialty-card" data-specialty="pediatre">
                <div class="specialty-icon">👶</div>
                <div class="specialty-name">Pédiatre</div>
            </div>
            <div class="specialty-card" data-specialty="dentiste">
                <div class="specialty-icon">🦷</div>
                <div class="specialty-name">Dentiste</div>
            </div>
            <div class="specialty-card" data-specialty="ophtalmologue">
                <div class="specialty-icon">👁️</div>
                <div class="specialty-name">Ophtalmologue</div>
            </div>
            <div class="specialty-card" data-specialty="gynécologue">
                <div class="specialty-icon">🌸</div>
                <div class="specialty-name">Gynécologue</div>
            </div>
            <div class="specialty-card" data-specialty="psychiatre">
                <div class="specialty-icon">🧠</div>
                <div class="specialty-name">Psychiatre</div>
            </div>
        </div>
    </div>

    <!-- Étape 3 : Choisir docteur -->
    <div class="step-content" data-step="3">
        <h2 class="step-title">Choisissez votre médecin</h2>
        <p class="step-description">Sélectionnez le médecin que vous souhaitez consulter</p>
        
        <div id="doctors-list">
            <p style="text-align: center; color: #999; padding: 40px;">
                <i class="fas fa-spinner fa-spin" style="font-size: 40px;"></i><br><br>
                Chargement des médecins...
            </p>
        </div>
    </div>

    <!-- Étape 4 : Date & Infos -->
    <div class="step-content" data-step="4">
        <h2 class="step-title">Date et informations</h2>
        <p class="step-description">Choisissez la date et complétez les informations</p>
        
        <div id="date-info-container">
            <p style="text-align: center; color: #999; padding: 40px;">Étape 4 en construction...</p>
        </div>
    </div>

    <!-- Étape 5 : Confirmation -->
    <div class="step-content" data-step="5">
        <h2 class="step-title">Confirmation</h2>
        <p class="step-description">Vérifiez les détails de votre rendez-vous</p>
        
        <div id="confirmation-container">
            <p style="text-align: center; color: #999; padding: 40px;">Étape 5 en construction...</p>
        </div>
    </div>

    <!-- Boutons de navigation -->
    <div class="step-actions">
        <button class="btn btn-prev" id="prevBtn" style="display: none;">
            <i class="fas fa-arrow-left"></i>
            Précédent
        </button>
        <button class="btn btn-next" id="nextBtn" disabled>
            Suivant
            <i class="fas fa-arrow-right"></i>
        </button>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
let currentStep = 1;
let formData = {
    forWho: null,
    specialty: null,
    doctor: null,
    date: null,
    time: null,
    patientInfo: null
};

// Gestion des choix "Pour qui"
document.querySelectorAll('.choice-card').forEach(card => {
    card.addEventListener('click', function() {
        document.querySelectorAll('.choice-card').forEach(c => c.classList.remove('selected'));
        this.classList.add('selected');
        formData.forWho = this.dataset.choice;
        updateNextButton();
    });
});

// Gestion des spécialités
document.querySelectorAll('.specialty-card').forEach(card => {
    card.addEventListener('click', function() {
        document.querySelectorAll('.specialty-card').forEach(c => c.classList.remove('selected'));
        this.classList.add('selected');
        formData.specialty = this.dataset.specialty;
        updateNextButton();
    });
});

// Boutons de navigation
document.getElementById('nextBtn').addEventListener('click', nextStep);
document.getElementById('prevBtn').addEventListener('click', prevStep);

function nextStep() {
    if (currentStep < 5) {
        currentStep++;
        updateStepDisplay();
    }
}

function prevStep() {
    if (currentStep > 1) {
        currentStep--;
        updateStepDisplay();
    }
}

function updateStepDisplay() {
    // Mettre à jour les step indicators
    document.querySelectorAll('.step').forEach(step => {
        const stepNum = parseInt(step.dataset.step);
        step.classList.remove('active', 'completed');
        
        if (stepNum === currentStep) {
            step.classList.add('active');
        } else if (stepNum < currentStep) {
            step.classList.add('completed');
        }
    });

    // Mettre à jour le contenu
    document.querySelectorAll('.step-content').forEach(content => {
        content.classList.remove('active');
        if (parseInt(content.dataset.step) === currentStep) {
            content.classList.add('active');
        }
    });

    // Charger les médecins quand on arrive à l'étape 3
    if (currentStep === 3 && formData.specialty) {
        loadDoctors();
    }

    // Gérer les boutons
    document.getElementById('prevBtn').style.display = currentStep > 1 ? 'flex' : 'none';
    
    updateNextButton();
}

function updateNextButton() {
    const nextBtn = document.getElementById('nextBtn');
    let canProceed = false;

    switch(currentStep) {
        case 1:
            canProceed = formData.forWho !== null;
            break;
        case 2:
            canProceed = formData.specialty !== null;
            break;
        case 3:
            canProceed = formData.doctor !== null;
            break;
        case 4:
            canProceed = formData.date !== null;
            break;
        case 5:
            nextBtn.textContent = 'Confirmer';
            canProceed = true;
            break;
    }

    nextBtn.disabled = !canProceed;
}

// Charger les médecins selon la spécialité sélectionnée
function loadDoctors() {
    console.log('=== loadDoctors() appelée ===');
    {% if medecins is defined %}
    const medecins = {{ medecins|json_encode|raw }};
    {% else %}
    const medecins = [];
    {% endif %}
    
    console.log('Médecins disponibles:', medecins);
    console.log('Spécialité sélectionnée:', formData.specialty);
    
    const doctorsList = document.getElementById('doctors-list');
    
    if (medecins.length === 0) {
        doctorsList.innerHTML = `
            <div style="text-align: center; padding: 60px 20px; color: #999;">
                <i class="fas fa-exclamation-circle" style="font-size: 64px; margin-bottom: 20px; opacity: 0.3;"></i>
                <h4 style="color: #666; font-weight: 600;">Aucun médecin dans le système</h4>
                <p>Veuillez contacter l'administrateur.</p>
            </div>
        `;
        return;
    }
    
    const selectedSpecialty = formData.specialty;
    
    // Mapping des spécialités sélectionnées vers les spécialités en base
    const specialtyMap = {
        'generaliste': ['généraliste', 'generaliste', 'médecine générale', 'medecine generale'],
        'cardiologue': ['cardiologie', 'cardiologue'],
        'dermatologue': ['dermatologie', 'dermatologue'],
        'pediatre': ['pédiatrie', 'pediatre', 'pédiatre'],
        'dentiste': ['dentiste', 'dentisterie', 'chirurgie dentaire'],
        'ophtalmologue': ['ophtalmologie', 'ophtalmologue'],
        'gynécologue': ['gynécologie', 'gynecologue', 'gynécologue'],
        'psychiatre': ['psychiatrie', 'psychiatre']
    };
    
    // Filtrer les médecins par spécialité
    const filteredDoctors = medecins.filter(medecin => {
        const specialty = medecin.specialite.toLowerCase().trim();
        const mappedSpecialties = specialtyMap[selectedSpecialty] || [selectedSpecialty];
        
        return mappedSpecialties.some(mapped => 
            specialty.includes(mapped.toLowerCase()) || 
            mapped.toLowerCase().includes(specialty)
        );
    });
    
    if (filteredDoctors.length === 0) {
        doctorsList.innerHTML = `
            <div style="text-align: center; padding: 60px 20px; color: #999;">
                <i class="fas fa-user-md" style="font-size: 64px; margin-bottom: 20px; opacity: 0.3;"></i>
                <h4 style="color: #666; font-weight: 600;">Aucun médecin disponible</h4>
                <p>Il n'y a pas encore de ${formData.specialty} enregistré dans notre système.</p>
            </div>
        `;
        return;
    }
    
    // Afficher les médecins
    let html = '<div style="display: flex; flex-direction: column; gap: 15px;">';
    
    filteredDoctors.forEach(medecin => {
        const initials = medecin.user.prenom.charAt(0) + medecin.user.nom.charAt(0);
        html += `
            <div class="doctor-card" data-doctor-id="${medecin.id}" style="border: 2px solid #e0e0e0; border-radius: 15px; padding: 20px; cursor: pointer; transition: all 0.3s ease; display: flex; gap: 20px; align-items: center;">
                <div style="width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 24px; flex-shrink: 0;">
                    ${initials}
                </div>
                <div style="flex: 1;">
                    <h4 style="margin: 0 0 5px 0; font-size: 18px; font-weight: 700; color: #1e1e2d;">
                        Dr. ${medecin.user.prenom} ${medecin.user.nom}
                    </h4>
                    <p style="margin: 0 0 5px 0; color: #00BFFF; font-weight: 600; font-size: 14px;">
                        <i class="fas fa-stethoscope"></i> ${medecin.specialite}
                    </p>
                    ${medecin.cabinet ? `<p style="margin: 0; color: #666; font-size: 14px;"><i class="fas fa-hospital-alt"></i> ${medecin.cabinet}</p>` : ''}
                    ${medecin.bio ? `<p style="margin: 8px 0 0 0; color: #888; font-size: 13px; line-height: 1.4;">${medecin.bio.substring(0, 120)}${medecin.bio.length > 120 ? '...' : ''}</p>` : ''}
                </div>
                <div>
                    <i class="fas fa-check-circle" style="font-size: 24px; color: #4CAF50; display: none;"></i>
                </div>
            </div>
        `;
    });
    
    html += '</div>';
    doctorsList.innerHTML = html;
    
    // Ajouter les événements de sélection
    document.querySelectorAll('.doctor-card').forEach(card => {
        card.addEventListener('click', function() {
            document.querySelectorAll('.doctor-card').forEach(c => {
                c.style.borderColor = '#e0e0e0';
                c.style.background = 'white';
                c.querySelector('.fa-check-circle').style.display = 'none';
            });
            this.style.borderColor = '#00BFFF';
            this.style.background = '#e6f7ff';
            this.querySelector('.fa-check-circle').style.display = 'block';
            
            formData.doctor = parseInt(this.dataset.doctorId);
            updateNextButton();
        });
    });
}

// Debug : afficher les données
console.log('Form Data:', formData);
</script>
{% endblock %}
