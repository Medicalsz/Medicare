{# Admin TopBar Component #}
<nav class="admin-topbar">
    <div class="admin-topbar-container">
        <div class="admin-topbar-left">
            <button class="admin-hamburger" id="adminHamburger">
                <i class="bi bi-list"></i>
            </button>
            <h1 class="admin-title">Administration Medicare</h1>
        </div>

        <div class="admin-topbar-right">
            <div class="admin-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Rechercher...">
            </div>

            <button class="admin-notification" title="Notifications">
                <i class="bi bi-bell"></i>
                <span class="badge">5</span>
            </button>

            <div class="admin-profile-dropdown">
                <button class="admin-profile-btn">
                    <div class="admin-avatar">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div class="admin-info">
                        <span class="admin-name">{% if app.user %}{{ app.user.prenom }} {{ app.user.nom }}{% else %}Utilisateur{% endif %}</span>
                        <span class="admin-role">Administrateur</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="admin-dropdown-menu">
                    <a href="#" class="dropdown-item">
                        <i class="bi bi-person"></i>
                        <span>Mon Profil</span>
                    </a>
                    <a href="#" class="dropdown-item">
                        <i class="bi bi-gear"></i>
                        <span>Paramètres</span>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="{{ path('app_logout') }}" class="dropdown-item logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</nav>
