{# Admin TopBar Component #}
{% set unreadCount = notifications_unread_count() %}
{% set latestNotifications = notifications_latest(5) %}
<nav class="admin-topbar">
    <div class="admin-topbar-container">
        <div class="admin-topbar-left">
            <button class="admin-hamburger" id="adminHamburger">
                <i class="bi bi-list"></i>
            </button>
            <h1 class="admin-title">Administration Medicare</h1>
        </div>

        <div class="admin-topbar-right">
            <div class="admin-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Rechercher...">
            </div>

            <div class="admin-notification-wrap">
                <button class="admin-notification" id="adminNotificationBtn" title="Notifications" type="button" aria-controls="adminNotificationsPanel" aria-expanded="false">
                    <i class="bi bi-bell"></i>
                    {% if unreadCount > 0 %}
                        <span class="badge">{{ unreadCount > 99 ? '99+' : unreadCount }}</span>
                    {% endif %}
                </button>

                <div class="admin-notifications-panel" id="adminNotificationsPanel" hidden>
                    <div class="admin-notifications-header">
                        <strong>Notifications</strong>
                        <form method="post" action="{{ path('app_notifications_read_all') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
                            <button type="submit" class="admin-mark-all-read">Tout marquer lu</button>
                        </form>
                    </div>
                    <div class="admin-notifications-list">
                        {% if latestNotifications is empty %}
                            <div class="admin-notification-item">Aucune notification</div>
                        {% else %}
                            {% for notification in latestNotifications %}
                                {% set adminLink = notification.link|replace({'/dashboard/forum': '/admin/forum'}) %}
                                <a href="{{ adminLink }}" class="admin-notification-item {{ not notification.isRead ? 'unread' : '' }}">
                                    <div class="title">{{ notification.authorName }}</div>
                                    <div class="text">{{ notification.message }}</div>
                                    <div class="time">{{ notification.createdAt|date('d/m/Y H:i') }}</div>
                                </a>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="admin-notifications-footer">
                        <a href="{{ path('app_notifications_index') }}">Voir toutes les notifications</a>
                    </div>
                </div>
            </div>

            <div class="admin-profile-dropdown">
                <button class="admin-profile-btn">
                    <div class="admin-avatar">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div class="admin-info">
                        <span class="admin-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
                        <span class="admin-role">Administrateur</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="admin-dropdown-menu">
                    <a href="#" class="dropdown-item">
                        <i class="bi bi-person"></i>
                        <span>Mon Profil</span>
                    </a>
                    <a href="#" class="dropdown-item">
                        <i class="bi bi-gear"></i>
                        <span>Paramètres</span>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="{{ path('app_logout') }}" class="dropdown-item logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</nav>
