{% extends 'dashboard_base.html.twig' %}

{% block title %}Notifications - Medicare{% endblock %}

{% block body %}
<div class="dashboard-content">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
        <div>
            <h1 class="page-title" style="margin-bottom:4px;">Notifications</h1>
            <p class="page-subtitle" style="margin-bottom:0;">Retrouvez les nouvelles activites du forum.</p>
        </div>
        <form method="post" action="{{ path('app_notifications_read_all') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
            <button type="submit" class="btn btn-secondary">Tout marquer comme lu</button>
        </form>
    </div>

    {% if notifications is empty %}
        <div class="card" style="padding:16px;">Aucune notification pour le moment.</div>
    {% else %}
        <div class="card" style="padding:0;">
            <div>
                {% for notification in notifications %}
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:14px 16px;border-bottom:1px solid #eef2f7;{{ not notification.isRead ? 'background:#f8fbff;' : '' }}">
                        <div>
                            <div style="font-weight:700;">{{ notification.message }}</div>
                            <div style="font-size:12px;color:#6d7b8c;">
                                {{ notification.authorName }} - {{ notification.createdAt|date('d/m/Y H:i') }}
                            </div>
                            <a href="{{ notification.link }}" style="font-size:13px;">Ouvrir le sujet</a>
                        </div>
                        {% if not notification.isRead %}
                            <form method="post" action="{{ path('app_notifications_read', {id: notification.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.id) }}">
                                <button type="submit" class="btn" style="padding:8px 12px;">Marquer lu</button>
                            </form>
                        {% else %}
                            <span style="display:inline-block;padding:4px 10px;border-radius:999px;background:#e9f9ee;color:#2e7d32;font-size:12px;font-weight:700;">Lu</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
