{% extends 'base.html.twig' %}

{% block title %}Donnations - Medicare{% endblock %}

{% block stylesheets %}
  <style>
    .donation-header {
      padding: 120px 0 60px 0;
      background: linear-gradient(135deg, var(--accent-color) 0%, #067d87 100%);
      color: white;
      text-align: center;
    }

    #header {
      background-color: rgba(255, 255, 255, 0.95);
      box-shadow: 0px 2px 15px rgba(0, 0, 0, 0.1);
    }

    .cause-card {
      background: var(--surface-color);
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(0,0,0,0.05);
    }

    .cause-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
    }

    .cause-img {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    .cause-content {
      padding: 25px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .cause-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--heading-color);
      margin-bottom: 15px;
      font-family: var(--heading-font);
    }

    .cause-description {
      color: var(--default-color);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    .btn-donner {
      background: var(--accent-color);
      color: white;
      border: none;
      padding: 12px 25px;
      border-radius: 50px;
      font-weight: 600;
      transition: 0.3s;
      width: 100%;
      text-align: center;
    }

    .btn-donner:hover {
      background: #067d87;
      color: white;
      box-shadow: 0 5px 15px rgba(9, 154, 167, 0.3);
    }

    .empty-state {
      text-align: center;
      padding: 100px 0;
    }
    
    .empty-state i {
      font-size: 4rem;
      color: #dee2e6;
      margin-bottom: 20px;
    }
  </style>
{% endblock %}

{% block body %}
  <main class="main">

    <section class="donation-header">
      <div class="container">
        <h1 data-aos="fade-up">Soutenez nos causes</h1>
        <p data-aos="fade-up" data-aos-delay="100">Votre générosité peut sauver des vies et améliorer le quotidien de nombreux patients.</p>
      </div>
    </section>

    <section id="causes" class="causes section py-5">
      <div class="container">
        <div class="row gy-4">
          {% for cause in causes %}
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
              <div class="cause-card">
                {% if cause.images|length > 0 %}
                  <img src="{{ cause.images[0].urlImage }}" alt="{{ cause.titre }}" class="cause-img">
                {% else %}
                  <img src="{{ asset('assets/img/health/facilities-3.webp') }}" alt="Default Cause" class="cause-img">
                {% endif %}
                <div class="cause-content">
                  <h3 class="cause-title">{{ cause.titre }}</h3>
                  <p class="cause-description">{{ cause.description|slice(0, 150) }}...</p>
                  <a href="{{ path('app_donation_show', {'id': cause.id}) }}" class="btn-donner">En savoir plus</a>
                </div>
              </div>
            </div>
          {% else %}
            <div class="col-12">
              <div class="empty-state">
                <i class="bi bi-heart-pulse"></i>
                <h3>Aucune cause active pour le moment</h3>
                <p>Revenez bientôt pour découvrir de nouvelles opportunités de soutenir nos patients.</p>
                <a href="{{ path('app_home') }}" class="btn btn-outline-primary mt-3">Retour à l'accueil</a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Dr. Chefik Voice Assistant -->
    <div id="dr-chefik-container" style="position: fixed; bottom: 30px; right: 30px; z-index: 1000; display: flex; flex-direction: column; align-items: end;">
      
      <!-- Chat Container -->
      <div id="dr-chefik-chat" style="display: none; background: white; width: 300px; height: 400px; border-radius: 15px; box-shadow: 0 5px 25px rgba(0,0,0,0.15); margin-bottom: 15px; flex-direction: column; overflow: hidden; border: 1px solid #eee;">
        <div style="background: #067d87; color: white; padding: 15px; font-weight: bold; display: flex; justify-content: space-between; align-items: center;">
          <span><i class="bi bi-robot"></i> Dr. Chefik</span>
          <button id="close-chat-btn" style="background: none; border: none; color: white; cursor: pointer;"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <div id="chat-messages" style="flex-grow: 1; padding: 15px; overflow-y: auto; background: #f9f9f9; display: flex; flex-direction: column; gap: 10px;">
        </div>
        
        <div style="padding: 10px; background: white; border-top: 1px solid #eee; display: flex; gap: 5px;">
          <input type="text" id="chat-input" placeholder="Écrivez votre message..." style="flex-grow: 1; border: 1px solid #ddd; padding: 8px 15px; border-radius: 20px; outline: none;">
          <button id="send-btn" style="background: #067d87; color: white; border: none; width: 35px; height: 35px; border-radius: 50%; cursor: pointer;"><i class="bi bi-send-fill"></i></button>
        </div>
      </div>

      <div id="dr-chefik-bubble" style="background: white; padding: 15px; border-radius: 20px 20px 0 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.2); margin-bottom: 10px; display: none; max-width: 250px; font-size: 0.9rem;">
        Bonjour ! Je suis Dr. Chefik.
      </div>
      <button id="dr-chefik-btn" style="width: 70px; height: 70px; border-radius: 50%; background: #067d87; border: none; padding: 0; overflow: hidden; box-shadow: 0 4px 15px rgba(6, 125, 135, 0.4); cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center;">
        <img src="{{ asset('assets/img/dr.png') }}" alt="Dr. Chefik" style="width: 100%; height: 100%; object-fit: cover;">
      </button>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('dr-chefik-btn');
        const bubble = document.getElementById('dr-chefik-bubble');
        const chatContainer = document.getElementById('dr-chefik-chat');
        const chatMessages = document.getElementById('chat-messages');
        const chatInput = document.getElementById('chat-input');
        const sendBtn = document.getElementById('send-btn');
        const closeChatBtn = document.getElementById('close-chat-btn');
        
        let recognition;
        let synthesis = window.speechSynthesis;
        let voices = [];
        let state = 'IDLE'; // IDLE, WAITING_GREETING, WAITING_YES_NO, WAITING_CAUSE_SELECTION
        let topCauses = [];

        // Add message to chat
        function addMessage(text, sender) {
            const div = document.createElement('div');
            div.className = `message ${sender}`;
            div.style.cssText = sender === 'bot' 
                ? 'align-self: flex-start; background: white; padding: 10px 15px; border-radius: 15px 15px 15px 0; box-shadow: 0 2px 5px rgba(0,0,0,0.05); max-width: 85%;'
                : 'align-self: flex-end; background: #067d87; color: white; padding: 10px 15px; border-radius: 15px 15px 0 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); max-width: 85%;';
            div.innerText = text;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Toggle chat
         btn.addEventListener('click', function() {
             if (chatContainer.style.display === 'none') {
                 chatContainer.style.display = 'flex';
                 // Start voice flow if first time
                 if (state === 'IDLE' && chatMessages.children.length === 0) {
                      state = 'WAITING_GREETING';
                      speak("Bonjour, je suis Dr. Chefik, je suis votre assistant.", function() { listen(); });
                 }
             } else {
                 // If chat is open, clicking button toggles mic
                if (btn.classList.contains('listening')) {
                    recognition.stop();
                } else {
                    listen();
                }
            }
        });

        closeChatBtn.addEventListener('click', function() {
            chatContainer.style.display = 'none';
            synthesis.cancel();
            recognition.stop();
            state = 'IDLE';
        });

        // Handle text input
        function handleTextSubmit() {
            const text = chatInput.value.trim();
            if (text) {
                addMessage(text, 'user');
                chatInput.value = '';
                handleInput(text.toLowerCase());
            }
        }

        sendBtn.addEventListener('click', handleTextSubmit);
        chatInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') handleTextSubmit();
        });

        function loadVoices() {
          voices = synthesis.getVoices();
        }

        if (synthesis.onvoiceschanged !== undefined) {
          synthesis.onvoiceschanged = loadVoices;
        }
        loadVoices();

        // Check browser support
        if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
          console.error("Speech recognition not supported");
          // btn.style.display = 'none'; // Keep button for text chat
        } else {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.lang = 'fr-FR';
            recognition.continuous = false;
            recognition.interimResults = false;

            recognition.onresult = function(event) {
              const transcript = event.results[0][0].transcript.toLowerCase();
              console.log("Entendu: " + transcript);
              addMessage(transcript, 'user');
              
              btn.style.transform = 'scale(1)';
              btn.style.background = '#067d87';
              btn.style.boxShadow = '0 4px 15px rgba(6, 125, 135, 0.4)';
    
              handleInput(transcript);
            };
    
            recognition.onstart = function() {
              console.log("Recognition started");
              btn.style.background = '#e74c3c';
              btn.style.boxShadow = '0 0 20px rgba(231, 76, 60, 0.8)';
              bubble.innerHTML = '<span class="text-danger">●</span> Je vous écoute...';
            };
    
            recognition.onerror = function(event) {
              console.error("Speech error", event.error);
              btn.style.transform = 'scale(1)';
              btn.style.background = '#067d87';
              btn.style.boxShadow = '0 4px 15px rgba(6, 125, 135, 0.4)';
              btn.classList.remove('listening');
              
              if (event.error === 'no-speech') {
                 speak("Je n'ai rien entendu. Cliquez sur le bouton pour réessayer.");
                 // state = 'IDLE'; // Keep state to allow retry
              } else if (event.error === 'not-allowed') {
                 addMessage("Erreur: Micro bloqué. Utilisez le chat textuel.", 'bot');
                 bubble.innerText = "Erreur: Micro bloqué.";
                 bubble.style.display = 'block';
              }
            };
    
            recognition.onend = function() {
              console.log("Recognition ended");
              btn.classList.remove('listening');
              btn.style.transform = 'scale(1)';
              btn.style.background = '#067d87';
              btn.style.boxShadow = '0 4px 15px rgba(6, 125, 135, 0.4)';
              
              if (bubble.innerHTML.includes('Je vous écoute')) {
                 bubble.style.display = 'none';
              }
            };
        }

        function speak(text, callback) {
          addMessage(text, 'bot');
          
          if (synthesis.speaking) {
             console.log("Cancelling previous speech");
             synthesis.cancel();
          }
          
          // Small delay to ensure synthesis is truly reset
          setTimeout(() => {
              const utterance = new SpeechSynthesisUtterance(text);
              utterance.lang = 'fr-FR';
              
              // Ensure voices are loaded
              if (voices.length === 0) voices = synthesis.getVoices();
    
              // Try to find a male voice
              const maleVoice = voices.find(v => v.lang.includes('fr') && (v.name.includes('Google') || v.name.includes('Thomas') || v.name.includes('Nicolas') || v.name.includes('Paul')));
              
              if (maleVoice) {
                utterance.voice = maleVoice;
              }
    
              utterance.onend = function() {
                console.log("Speech ended");
                if (callback) {
                    // Small delay before callback (usually listening)
                    setTimeout(callback, 200);
                }
              };
              
              bubble.innerText = text;
              bubble.style.display = 'block';
              synthesis.speak(utterance);
          }, 50);
        }

        function listen() {
          if (!recognition) return;
          
          try {
            // Force stop previous instance
            recognition.stop();
          } catch(e) {}
          
          setTimeout(() => {
            try {
              recognition.start();
              bubble.innerHTML = '<span class="text-danger">●</span> Je vous écoute...';
              bubble.style.display = 'block';
              btn.classList.add('listening');
              btn.style.transform = 'scale(1.1)';
              btn.style.background = '#e74c3c'; // Red when listening
              btn.style.boxShadow = '0 0 20px rgba(231, 76, 60, 0.8)';
            } catch (e) {
              console.error("Recognition already started", e);
            }
          }, 100); // Small delay to ensure audio context is ready
        }
        
        // Remove old event listener on btn if possible (not possible directly, but logic is replaced)
        // Note: In this full replace, we are redefining the script block entirely.

        function handleInput(text) {
          if (state === 'WAITING_GREETING') {
            if (text.includes('bonjour') || text.includes('salut')) {
              state = 'WAITING_YES_NO';
              speak("Vous êtes prêt à donner de l'argent à une cause qui en a besoin ?", function() {
                listen();
              });
            } else {
               speak("Je n'ai pas compris, pouvez-vous répéter ?", function() { listen(); });
            }
          } 
          else if (state === 'WAITING_YES_NO') {
            if (text.includes('non')) {
              state = 'IDLE';
              speak("Ok, si tu as besoin de nouveau de moi n'hésite pas, au revoir", function() {
                bubble.style.display = 'none';
              });
            } else if (text.includes('oui') || text.includes('d\'accord') || text.includes('bien sûr')) {
              // Fetch causes
              fetch('/api/assistant/top-causes')
                .then(response => response.json())
                .then(data => {
                  topCauses = data;
                  if (topCauses.length === 0) {
                    speak("Désolé, je ne trouve aucune cause pour le moment.");
                    state = 'IDLE';
                    return;
                  }
                  
                  let message = "Ok, les causes qui sont le plus dans le besoin sont : ";
                  topCauses.forEach((cause, index) => {
                    message += `${cause.titre}. L'objectif est de ${cause.objectif} dinars et la cause a réussi à amasser ${cause.actuel} dinars. `;
                  });
                  message += "Quelle cause voulez-vous donner de l'argent ?";
                  
                  state = 'WAITING_CAUSE_SELECTION';
                  speak(message, function() {
                    listen();
                  });
                })
                .catch(err => {
                  console.error(err);
                  speak("Désolé, j'ai eu un problème pour récupérer les causes.");
                  state = 'IDLE';
                });
            } else {
              speak("Je n'ai pas compris, pouvez-vous répéter ?", function() { listen(); });
            }
          }
          else if (state === 'WAITING_CAUSE_SELECTION') {
            const selectedCause = topCauses.find(c => text.includes(c.titre.toLowerCase()));
            
            if (selectedCause) {
              speak(`Très bien, j'ouvre la page de donation pour ${selectedCause.titre}.`, function() {
                window.location.href = `/donnation/${selectedCause.id}`;
              });
              state = 'IDLE';
            } else {
              speak("Je n'ai pas compris quelle cause vous avez choisi. Pouvez-vous répéter le titre ?", function() { listen(); });
            }
          }
        }
      });
    </script>

  </main>
{% endblock %}
