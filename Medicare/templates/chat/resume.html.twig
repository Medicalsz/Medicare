{% extends is_granted('ROLE_ADMIN') ? 'admin_base.html.twig' : 'dashboard_base.html.twig' %}

{% block title %}Chat Resumeur - Medicare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .chat-resume-page {
            --chat-bg: #eef3ff;
            --chat-card: #ffffff;
            --chat-border: #dbe4f6;
            --chat-ink: #1d3556;
            --chat-soft: #5b7291;
            --chat-accent: #1f78d1;
            --chat-accent-2: #26a69a;
            --chat-user: linear-gradient(135deg, #1f78d1, #3498db);
            --chat-bot: #f7faff;
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem;
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 1rem;
            background:
                radial-gradient(circle at 15% 10%, rgba(31, 120, 209, 0.12), transparent 30%),
                radial-gradient(circle at 80% 30%, rgba(38, 166, 154, 0.12), transparent 28%),
                var(--chat-bg);
            border: 1px solid #d6e0f4;
            border-radius: 22px;
        }

        .chat-card {
            background: var(--chat-card);
            border: 1px solid var(--chat-border);
            border-radius: 18px;
            box-shadow: 0 12px 28px rgba(35, 65, 112, 0.09);
        }

        .chat-panel {
            display: flex;
            flex-direction: column;
            min-height: 620px;
            overflow: hidden;
        }

        .chat-panel-head {
            padding: 1rem 1rem 0.65rem;
            border-bottom: 1px solid #e8eefb;
            background: linear-gradient(180deg, #ffffff, #fbfdff);
        }

        .chat-panel-head h2 {
            margin: 0;
            color: var(--chat-ink);
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 0.02em;
        }

        .chat-panel-head p {
            margin: 0.25rem 0 0;
            color: var(--chat-soft);
            font-size: 0.9rem;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(245, 250, 255, 0.85)),
                repeating-linear-gradient(0deg, transparent, transparent 34px, rgba(157, 184, 227, 0.07) 35px);
            border-bottom: 1px solid #e5edf8;
        }

        .chat-row {
            display: flex;
            align-items: flex-end;
            gap: 0.5rem;
            margin-bottom: 0.8rem;
            animation: chat-rise 0.22s ease;
        }

        .chat-row.user {
            justify-content: flex-end;
        }

        .chat-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 800;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 8px 18px rgba(26, 66, 120, 0.18);
        }

        .chat-avatar.bot {
            background: linear-gradient(135deg, var(--chat-accent-2), #2ecc71);
        }

        .chat-avatar.user {
            background: linear-gradient(135deg, #4f6f96, #6f8bb1);
        }

        .chat-bubble {
            max-width: 88%;
            padding: 0.62rem 0.82rem;
            border-radius: 14px;
            line-height: 1.45;
            white-space: pre-wrap;
            word-break: break-word;
            font-size: 0.95rem;
        }

        .chat-bubble.user {
            background: var(--chat-user);
            color: #fff;
            border-bottom-right-radius: 4px;
            box-shadow: 0 10px 24px rgba(32, 120, 206, 0.35);
        }

        .chat-bubble.bot {
            background: var(--chat-bot);
            border: 1px solid #d7e3f6;
            color: #224060;
            border-bottom-left-radius: 4px;
            box-shadow: 0 7px 17px rgba(36, 64, 96, 0.08);
        }

        .chat-toolbar {
            padding: 0.75rem 1rem 0.5rem;
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            background: #fbfdff;
        }

        .quick-btn {
            border: 1px solid #c6daf7;
            border-radius: 999px;
            background: #edf5ff;
            color: #265a90;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 0.34rem 0.74rem;
            transition: all 0.18s ease;
        }

        .quick-btn:hover {
            background: #e1efff;
            border-color: #aecdF2;
            transform: translateY(-1px);
        }

        .chat-composer {
            border-top: 1px solid #e5edf8;
            padding: 0.85rem 1rem 1rem;
            display: grid;
            gap: 0.55rem;
            background: #ffffff;
        }

        .chat-loading {
            font-size: 0.85rem;
            color: #4e6f96;
            display: none;
            align-items: center;
            gap: 0.4rem;
        }

        .chat-loading.active {
            display: inline-flex;
        }

        .chat-loading .dots {
            display: inline-flex;
            gap: 0.2rem;
        }

        .chat-loading .dots span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #4e6f96;
            animation: dot-pulse 1s infinite ease-in-out;
        }

        .chat-loading .dots span:nth-child(2) { animation-delay: 0.15s; }
        .chat-loading .dots span:nth-child(3) { animation-delay: 0.3s; }

        .chat-form-row .form-control {
            border: 1px solid #ccd9f0;
            border-radius: 12px;
            min-height: 44px;
        }

        .chat-form-row .btn-primary {
            border-radius: 12px;
            min-width: 110px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--chat-accent), #4ea8de);
            border: 0;
            box-shadow: 0 10px 20px rgba(31, 120, 209, 0.26);
        }

        .chat-form-row {
            display: flex;
            gap: 0.5rem;
        }

        .chat-form-row input {
            flex: 1;
        }

        .chat-source {
            padding: 1rem 1rem 1.1rem;
        }

        .chat-source h3 {
            font-size: 1.03rem;
            margin-bottom: 0.75rem;
            color: #184f89;
            font-weight: 800;
            letter-spacing: 0.02em;
        }

        .source-block {
            background: #f8fbff;
            border: 1px solid #d8e3f6;
            border-radius: 14px;
            padding: 0.8rem;
            margin-bottom: 0.75rem;
        }

        .source-block-title {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #2b5d94;
            margin-bottom: 0.45rem;
        }

        .source-divider {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            margin: 0.65rem 0 0.75rem;
            color: #6f86a4;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 700;
        }

        .source-divider::before,
        .source-divider::after {
            content: "";
            flex: 1;
            border-top: 1px solid #d5e1f6;
        }

        .source-note {
            margin-top: 0.35rem;
            font-size: 0.78rem;
            color: #6a7f9d;
        }

        .examples-label {
            margin: 0.85rem 0 0.45rem;
            font-size: 0.83rem;
            color: #436187;
            font-weight: 700;
        }

        .examples-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .examples-list li {
            margin: 0;
        }

        .example-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            background: #edf4ff;
            border: 1px solid #cfe0f7;
            color: #2e5f98;
            border-radius: 999px;
            padding: 0.3rem 0.62rem;
            font-size: 0.8rem;
            font-weight: 700;
            line-height: 1.25;
        }

        .chat-source .form-control,
        .chat-source .form-select {
            border-radius: 12px;
            border: 1px solid #cedcf3;
        }

        .chat-source .form-label {
            color: #37587f;
            font-size: 0.89rem;
            margin-bottom: 0.35rem;
        }

        @keyframes dot-pulse {
            0%, 80%, 100% { opacity: 0.35; transform: scale(0.8); }
            40% { opacity: 1; transform: scale(1); }
        }

        @keyframes chat-rise {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 992px) {
            .chat-resume-page {
                grid-template-columns: 1fr;
            }

            .chat-panel {
                min-height: 520px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div
    class="chat-resume-page"
    id="chatResumeApp"
    data-message-url="{{ path('app_chat_resume_message') }}"
    data-prefill-topic-id="{{ prefill_topic_id }}"
>
    <aside class="chat-card chat-source">
        <h3>Source du resume</h3>

        <div class="source-block">
            <div class="source-block-title">Option 1 : Sujet du forum</div>
            <label class="form-label fw-bold mb-1">Choisir un sujet</label>
            <select class="form-select" id="chatTopicSelect">
                <option value="">-- Aucun sujet --</option>
                {% for topic in topics %}
                    <option
                        value="{{ topic.id }}"
                        {% if prefill_topic_id == topic.id %}selected{% endif %}
                    >
                        #{{ topic.id }} - {{ topic.title|slice(0, 60) }}{% if topic.title|length > 60 %}...{% endif %}
                    </option>
                {% endfor %}
            </select>
            <div class="source-note">Le chatbot utilisera le contenu du sujet et ses commentaires.</div>
        </div>

        <div class="source-divider">ou</div>

        <div class="source-block">
            <div class="source-block-title">Option 2 : Texte libre</div>
            <label for="chatTextInput" class="form-label fw-bold mb-1">Coller un texte long</label>
            <textarea id="chatTextInput" class="form-control" rows="8" placeholder="Collez ici un texte a resumer..."></textarea>
            <div class="source-note">Conseil: utilisez un texte de 5 a 20 lignes pour un meilleur resultat.</div>
        </div>

        <p class="examples-label">Exemples de message</p>
        <ul class="examples-list">
            {% for sample in test_messages %}
                <li><span class="example-chip">{{ sample }}</span></li>
            {% endfor %}
        </ul>
    </aside>

    <section class="chat-card chat-panel">
        <div class="chat-panel-head">
            <h2>Chatbot Resumeur IA</h2>
            <p>Formulez votre demande: l'assistant fournit une synthese professionnelle et structuree.</p>
        </div>

        <div class="chat-toolbar">
            <button class="quick-btn" type="button" data-quick-message="Fais un resume professionnel en 3 points cles">Resume professionnel</button>
            <button class="quick-btn" type="button" data-quick-message="Donne une synthese executive en 4 phrases">Synthese executive</button>
        </div>

        <div class="chat-messages" id="chatMessages">
            <div class="chat-row bot">
                <span class="chat-avatar bot">IA</span>
                <div class="chat-bubble bot">
                    Bonjour. Je peux produire un resume professionnel, clair et actionnable a partir d'un sujet ou d'un texte libre.
                </div>
            </div>
        </div>

        <div class="chat-composer">
            <div id="chatLoading" class="chat-loading">
                IA en cours de calcul...
                <span class="dots"><span></span><span></span><span></span></span>
            </div>
            <div class="chat-form-row">
                <input
                    type="text"
                    id="chatPromptInput"
                    class="form-control"
                    placeholder="Ex: Donne une synthese executive en 4 phrases avec points cles"
                >
                <button class="btn btn-primary" id="chatSendButton" type="button">Envoyer</button>
            </div>
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/chat-resume.js') }}?v=20260225-1"></script>
{% endblock %}
