{% extends 'admin_base.html.twig' %}

{% block title %}Gestion des Donations{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var map = null;
            var modal = document.getElementById('leafletMapModal');
            
            modal.addEventListener('shown.bs.modal', function () {
                if (!map) {
                    // Initialiser la carte centrée sur la Tunisie
                    map = L.map('leaflet-map').setView([33.8869, 9.5375], 6);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    }).addTo(map);

                    // Données réelles injectées via Twig
                    var locations = [];
                    
                    {% for don in donsArgent %}
                        {% if don.latitude is not null and don.longitude is not null %}
                            locations.push({ 
                                lat: {{ don.latitude|number_format(6, '.', '') }}, 
                                lng: {{ don.longitude|number_format(6, '.', '') }}, 
                                city: "{{ don.adresse|default('Donateur')|e('js') }}", 
                                amount: "{{ don.montant|number_format(2, ',', ' ') }} DT", 
                                donors: 1 
                            });
                        {% endif %}
                    {% endfor %}

                    locations.forEach(function(loc) {
                        var marker = L.marker([loc.lat, loc.lng]).addTo(map);
                        marker.bindPopup(`
                            <div style="text-align: center;">
                                <h6 style="margin: 0 0 5px 0; color: #067d87; font-weight: bold;">${loc.city}</h6>
                                <p style="margin: 0; font-size: 0.9rem;">Montant: <strong>${loc.amount}</strong></p>
                            </div>
                        `);
                    });
                    
                    // Forcer le redimensionnement après l'initialisation pour éviter la carte grise
                    setTimeout(function() {
                        map.invalidateSize();
                    }, 200);

                } else {
                    setTimeout(function() {
                        map.invalidateSize();
                    }, 100);
                }
            });
        });
    </script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
{% endblock %}

{% block body %}
    <div class="admin-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="admin-page-title">Gestion des Donations</h1>
            <p class="admin-page-subtitle">Visualisez et gérez l'ensemble des dons reçus</p>
            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-primary shadow-sm d-flex align-items-center gap-2" 
                        style="border-radius: 12px; padding: 10px 20px; font-weight: 600;"
                        data-bs-toggle="modal" 
                        data-bs-target="#addCauseModal">
                    <i class="bi bi-plus-circle-fill"></i> Ajouter une cause
                </button>
                <button type="button" class="btn btn-outline-primary shadow-sm d-flex align-items-center gap-2" 
                        style="border-radius: 12px; padding: 10px 20px; font-weight: 600;"
                        data-bs-toggle="modal" 
                        data-bs-target="#listCausesModal">
                    <i class="bi bi-list-ul"></i> Toutes les causes
                </button>
                <button type="button" class="btn btn-success shadow-sm d-flex align-items-center gap-2" 
                        style="border-radius: 12px; padding: 10px 20px; font-weight: 600; background-color: #28a745; border-color: #28a745;"
                        data-bs-toggle="modal" 
                        data-bs-target="#leafletMapModal">
                    <i class="bi bi-map-fill"></i> Leaflet
                </button>
            </div>
        </div>
        <div class="search-container d-flex align-items-center gap-2" style="min-width: 400px;">
            <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; flex-grow: 1;">
                <span class="input-group-text bg-white border-0 ps-3">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" id="causeSearch" class="form-control border-0 py-2" placeholder="Rechercher par cause..." style="box-shadow: none;">
            </div>
            <a href="{{ path('app_admin_donations_pdf') }}" class="btn btn-danger shadow-sm d-flex align-items-center gap-2" style="border-radius: 12px; padding: 8px 15px;">
                <i class="bi bi-file-earmark-pdf-fill"></i> PDF
            </a>
        </div>
    </div>

    <!-- Leaflet Map Modal -->
    <div class="modal fade" id="leafletMapModal" tabindex="-1" aria-labelledby="leafletMapModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header bg-success text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="leafletMapModalLabel">
                        <i class="bi bi-map-fill me-2"></i> Carte des Donateurs
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="leaflet-map" style="width: 100%; height: 600px;"></div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <small class="text-muted me-auto"><i class="bi bi-info-circle"></i> Cette carte montre la répartition géographique des dons (Simulation).</small>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 15px;">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {# Section Dons d'Argent #}
    <div class="admin-card mb-5">
        <div class="admin-card-header d-flex justify-content-between align-items-center">
            <h3 class="admin-card-title mb-0">
                <i class="bi bi-cash-stack text-success"></i> Dons d'Argent
            </h3>
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-sm btn-outline-primary border-2 fw-bold d-flex align-items-center gap-2" 
                        style="border-radius: 10px;"
                        data-bs-toggle="modal" 
                        data-bs-target="#statsModal">
                    <i class="bi bi-pie-chart-fill"></i> Statistiques
                </button>
                <span class="admin-badge info">{{ donsArgent|length }} dons</span>
            </div>
        </div>
        <div class="admin-card-body">
            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                                <th>Donateur</th>
                                <th>Cause</th>
                                <th class="sortable" data-sort="amount" style="cursor: pointer; user-select: none;">
                                    Montant <i class="bi bi-arrow-down-up small ms-1 text-muted"></i>
                                </th>
                                <th>Adresse</th>
                                <th>Date</th>
                                <th>Mode</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for don in donsArgent %}
                                <tr class="donation-row" data-cause="{{ don.cause.titre|lower }}" data-amount="{{ don.montant }}">
                                    <td>
                                        <div class="fw-bold">{{ don.donateur.prenom }} {{ don.donateur.nom }}</div>
                                        <small class="text-muted">{{ don.donateur.email }}</small>
                                    </td>
                                    <td>{{ don.cause.titre }}</td>
                                    <td class="fw-bold text-success">{{ don.montant|number_format(2, ',', ' ') }} DT</td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-geo-alt"></i> 
                                            {% if don.statutDon.value == 'confirmé' and not don.isPickupAddressConfirmed %}
                                                <span class="text-warning small italic">En attente de l'utilisateur...</span>
                                            {% else %}
                                                {{ don.adresse|default('N/A') }}
                                            {% endif %}
                                        </small>
                                    </td>
                                    <td>{{ don.dateDon|date('d/m/Y H:i') }}</td>
                                    <td>{{ don.modePaiement.value|capitalize }}</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        {% if don.statutDon.value == 'confirmé' %}
                                            <span class="admin-badge success">Confirmé</span>
                                        {% elseif don.statutDon.value == 'en attente' %}
                                            <span class="admin-badge warning">En attente</span>
                                            <form action="{{ path('app_admin_don_confirm', {id: don.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success border-2 fw-bold" title="Confirmer le don" style="border-radius: 8px;">
                                                    <i class="bi bi-check-lg"></i> Confirmer
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="admin-badge danger">{{ don.statutDon.value|capitalize }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">Aucun don d'argent enregistré.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Section Dons Matériels #}
    <div class="admin-card">
        <div class="admin-card-header">
            <h3 class="admin-card-title">
                <i class="bi bi-box-seam text-primary"></i> Dons Matériels
            </h3>
            <span class="admin-badge info">{{ donsMateriel|length }} dons</span>
        </div>
        <div class="admin-card-body">
            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                                <th>Donateur</th>
                                <th>Cause</th>
                                <th>Matériels</th>
                                <th>Photos</th>
                                <th class="sortable" data-sort="quantity" style="cursor: pointer; user-select: none;">
                                    Quantité <i class="bi bi-arrow-down-up small ms-1 text-muted"></i>
                                </th>
                                <th>Adresse</th>
                                <th>Date</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for don in donsMateriel %}
                                <tr class="donation-row" data-cause="{{ don.cause.titre|lower }}" data-quantity="{{ don.montant|round(0, 'floor') }}">
                                    <td>
                                        <div class="fw-bold">{{ don.donateur.prenom }} {{ don.donateur.nom }}</div>
                                        <small class="text-muted">{{ don.donateur.email }}</small>
                                    </td>
                                    <td>{{ don.cause.titre }}</td>
                                    <td>
                                        <ul class="list-unstyled mb-0 small">
                                            {% for objet in don.objets %}
                                                <li class="d-flex align-items-center mb-1">
                                                    <i class="bi bi-dot me-1"></i> 
                                                    {{ objet.nomObjet }} (x{{ objet.quantite }})
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            {% for objet in don.objets %}
                                                {% if objet.photo %}
                                                    <img src="{{ asset('uploads/donations/' ~ objet.photo) }}" 
                                                         class="img-thumbnail rounded shadow-sm donation-photo-thumb"
                                                         alt="Photo de {{ objet.nomObjet }}"
                                                         style="width: 40px; height: 40px; object-fit: cover; cursor: pointer; transition: transform 0.2s;"
                                                         data-bs-toggle="modal" 
                                                         data-bs-target="#photoZoomModal" 
                                                         data-photo-src="{{ asset('uploads/donations/' ~ objet.photo) }}"
                                                         data-photo-alt="Photo de {{ objet.nomObjet }}"
                                                         onclick="this.style.transform = 'scale(0.95)'; setTimeout(() => this.style.transform = 'scale(1)', 150);">
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold">{{ don.montant|round(0, 'floor') }}</td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-geo-alt"></i> 
                                            {% if don.statutDon.value == 'confirmé' and not don.isPickupAddressConfirmed %}
                                                <span class="text-warning small italic">En attente de l'utilisateur...</span>
                                            {% else %}
                                                {{ don.adresse|default('N/A') }}
                                            {% endif %}
                                        </small>
                                    </td>
                                    <td>{{ don.dateDon|date('d/m/Y H:i') }}</td>
                                    <td>
                                    <div class="d-flex align-items-center gap-2">
                                        {% if don.statutDon.value == 'confirmé' %}
                                            <span class="admin-badge success">Confirmé</span>
                                        {% elseif don.statutDon.value == 'en attente' %}
                                            <span class="admin-badge warning">En attente</span>
                                            <form action="{{ path('app_admin_don_confirm', {id: don.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success border-2 fw-bold" title="Confirmer le don" style="border-radius: 8px;">
                                                    <i class="bi bi-check-lg"></i> Confirmer
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="admin-badge danger">{{ don.statutDon.value|capitalize }}</span>
                                        {% endif %}

                                        {# Bouton Supprimer (Livré) - UNIQUEMENT pour matériel #}
                                        <button type="button" class="btn btn-sm btn-outline-danger border-2 fw-bold" 
                                                style="border-radius: 8px;"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModalMat{{ don.id }}"
                                                title="Marquer comme livré et supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">Aucun don matériel enregistré.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Modals de suppression hors de la table pour éviter les conflits de rendu #}
    {% for don in donsMateriel %}
        <div class="modal fade" id="deleteModalMat{{ don.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden;">
                    <div class="modal-header bg-danger text-white border-0 py-3">
                        <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Attention</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <i class="bi bi-box-seam text-danger mb-3" style="font-size: 3rem;"></i>
                        <p class="mb-0 fs-5 text-dark fw-bold">
                            Cette fonctionnalité de suppression n'est faite que pour lorsque les dons matériels sont arrivés à destination et sont livrés chez nous.
                        </p>
                        <div class="alert alert-warning mt-3 border-0 shadow-sm" style="border-radius: 12px; text-align: left;">
                            <strong>Note :</strong> Si vous confirmez la suppression, ce don sera considéré comme livré et sera supprimé de la base de données.
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0 justify-content-center">
                        <button type="button" class="btn btn-light fw-bold px-4 py-2 me-2" data-bs-dismiss="modal" style="border-radius: 10px; min-width: 120px;">Annuler</button>
                        <form action="{{ path('app_admin_don_delete', {id: don.id}) }}" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger fw-bold px-4 py-2" style="border-radius: 10px; min-width: 120px;">Confirmer la livraison</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    {# Modal Statistiques #}
    <div class="modal fade" id="statsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden;">
                <div class="modal-header border-0 py-4 px-4">
                    <h5 class="modal-title fw-bold fs-4">
                        <i class="bi bi-pie-chart-fill text-primary me-2"></i> Répartition des dons par cause
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-0 text-center">
                    <div class="mb-4">
                        <span class="text-muted d-block mb-1">Montant Total Collecté</span>
                        <h2 class="fw-bold text-success mb-0">{{ totalArgent|number_format(0, '.', ' ') }} DT</h2>
                    </div>
                    <p class="text-muted mb-4 small">Visualisation du pourcentage de chaque cause par rapport au total des dons d'argent reçus.</p>
                    <div style="max-width: 420px; margin: 0 auto;">
                        <canvas id="donationsChart"></canvas>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 justify-content-center">
                    <button type="button" class="btn btn-primary fw-bold px-5 py-2" data-bs-dismiss="modal" style="border-radius: 12px;">Fermer</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- Logique de recherche ---
            const searchInput = document.getElementById('causeSearch');
            const rows = document.querySelectorAll('.donation-row');

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();

                rows.forEach(row => {
                    const causeName = row.getAttribute('data-cause');
                    if (causeName.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                updateNoResultMessages();
            });

            // --- Logique de tri ---
            const sortableHeaders = document.querySelectorAll('.sortable');
            
            sortableHeaders.forEach(header => {
                let ascending = true;
                
                header.addEventListener('click', function() {
                    const sortType = this.getAttribute('data-sort');
                    const table = this.closest('table');
                    const tbody = table.querySelector('tbody');
                    const rowsArray = Array.from(tbody.querySelectorAll('.donation-row'));
                    
                    sortableHeaders.forEach(h => {
                        if (h !== header) {
                            h.querySelector('i').className = 'bi bi-arrow-down-up small ms-1 text-muted';
                        }
                    });

                    rowsArray.sort((a, b) => {
                        const valA = parseFloat(a.getAttribute(`data-${sortType}`));
                        const valB = parseFloat(b.getAttribute(`data-${sortType}`));
                        return ascending ? valA - valB : valB - valA;
                    });

                    const icon = this.querySelector('i');
                    icon.className = ascending ? 'bi bi-arrow-up small ms-1 text-primary' : 'bi bi-arrow-down small ms-1 text-primary';
                    
                    rowsArray.forEach(row => tbody.appendChild(row));
                    ascending = !ascending;
                });
            });

            function updateNoResultMessages() {
                const tableBodies = document.querySelectorAll('tbody');
                tableBodies.forEach(tbody => {
                    const visibleRows = tbody.querySelectorAll('.donation-row[style="display: "], .donation-row:not([style*="display: none"])');
                    let noResultMsg = tbody.querySelector('.no-result-message');
                    
                    if (visibleRows.length === 0) {
                        if (!noResultMsg) {
                            noResultMsg = document.createElement('tr');
                            noResultMsg.className = 'no-result-message';
                            noResultMsg.innerHTML = `<td colspan="10" class="text-center py-4 text-muted italic">Aucun don ne correspond à cette recherche.</td>`;
                            tbody.appendChild(noResultMsg);
                        }
                    } else if (noResultMsg) {
                        noResultMsg.remove();
                    }
                });
            }

            // --- Logique du Graphique (Chart.js) ---
            const statsData = {{ statsCauses|json_encode|raw }};
            const ctx = document.getElementById('donationsChart').getContext('2d');
            
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(statsData),
                    datasets: [{
                        data: Object.values(statsData),
                        backgroundColor: [
                            '#0d6efd', '#198754', '#ffc107', '#dc3545', '#0dcaf0', 
                            '#6610f2', '#fd7e14', '#20c997', '#e83e8c', '#6f42c1'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                font: {
                                    size: 14,
                                    weight: '500'
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    const total = context.dataset.data.reduce((acc, curr) => acc + curr, 0);
                                    const percentage = ((value / total) * 100).toFixed(1);
                                    return ` ${label}: ${value.toLocaleString()} DT (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        });

        function confirmDeleteCause(causeId) {
            Swal.fire({
                title: 'Êtes-vous sûr ?',
                text: "Cette action est irréversible et la cause sera définitivement supprimée.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Oui, supprimer !',
                cancelButtonText: 'Annuler',
                borderRadius: '15px'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('delete-cause-form-' + causeId).submit();
                }
            })
        }
    </script>

    {# Modal Ajouter une Cause #}
    <div class="modal fade" id="addCauseModal" tabindex="-1" aria-labelledby="addCauseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold" id="addCauseModalLabel">Ajouter une nouvelle cause</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="{{ path('app_admin_cause_add') }}" method="POST" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="titre" class="form-label fw-bold">Titre de la cause</label>
                            <input type="text" class="form-control border-2" id="titre" name="titre" required placeholder="Ex: Aide aux enfants défavorisés" style="border-radius: 10px;">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Image d'illustration</label>
                            <div class="card border-2 p-3 mb-2" style="border-radius: 15px; border-style: dashed;">
                                <div class="row g-3">
                                    <div class="col-md-6 border-end">
                                        <label for="imageFile" class="form-label small text-muted">Importer une image locale</label>
                                        <input type="file" class="form-control" id="imageFile" name="imageFile" accept="image/*">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="imageUrl" class="form-label small text-muted">OU mettre l'URL d'une image</label>
                                        <input type="url" class="form-control" id="imageUrl" name="imageUrl" placeholder="https://example.com/image.jpg">
                                    </div>
                                </div>
                            </div>
                            <div class="form-text">Si les deux sont remplis, l'image locale sera prioritaire.</div>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label fw-bold">Description</label>
                            <textarea class="form-control border-2" id="description" name="description" rows="4" required placeholder="Décrivez la cause et ses objectifs..." style="border-radius: 10px;"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="objectif" class="form-label fw-bold">Objectif de montant (DT)</label>
                            <input type="number" class="form-control border-2" id="objectif" name="objectif" required placeholder="Ex: 5000" style="border-radius: 10px;">
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="border-radius: 10px;">Annuler</button>
                        <button type="submit" class="btn btn-primary fw-bold px-4" style="border-radius: 10px;">Enregistrer la cause</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# Modal Liste des Causes #}
    <div class="modal fade" id="listCausesModal" tabindex="-1" aria-labelledby="listCausesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold" id="listCausesModalLabel">Toutes les causes</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="admin-table-container" style="max-height: 400px; overflow-y: auto;">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Cause</th>
                                    <th>Objectif</th>
                                    <th>Montant Collecté</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for causeData in allCauses %}
                                    <tr>
                                        <td>
                                            <div class="fw-bold">{{ causeData.entity.titre }}</div>
                                            <small class="text-muted">{{ causeData.entity.description|slice(0, 50) }}...</small>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-primary">{{ (causeData.entity.objectifMontant|default(0))|number_format(0, '.', ' ') }} DT</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-success">{{ causeData.montant|number_format(2, ',', ' ') }} DT</span>
                                        </td>
                                        <td class="text-end">
                                            <form id="delete-cause-form-{{ causeData.entity.id }}" action="{{ path('app_admin_cause_delete', {id: causeData.entity.id}) }}" method="POST">
                                                <button type="button" class="btn btn-sm btn-outline-danger border-2 fw-bold" 
                                                        style="border-radius: 8px;"
                                                        onclick="confirmDeleteCause({{ causeData.entity.id }})">
                                                    <i class="bi bi-trash-fill"></i> Supprimer
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">Aucune cause trouvée.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="border-radius: 10px;">Fermer</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour zoom photo -->
    <div class="modal fade" id="photoZoomModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0 text-center position-relative">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3 bg-white p-2 rounded-circle" data-bs-dismiss="modal" aria-label="Close"></button>
                    <img src="" id="zoomedPhoto" class="img-fluid rounded shadow-lg" style="max-height: 85vh; border: 4px solid white;" alt="Zoom photo">
                    <div id="photoCaption" class="mt-2 text-white fw-bold text-shadow"></div>
                    <div class="mt-3">
                        <button type="button" id="analyzeBtn" class="btn btn-warning fw-bold shadow-sm" data-analyze-url="{{ path('app_admin_analyze_photo') }}">
                            <i class="bi bi-magic"></i> Vérifier l'état
                        </button>
                        <div id="analysisResult" class="mt-2 badge bg-light text-dark fs-6 d-none p-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var photoModal = document.getElementById('photoZoomModal');
            if (photoModal) {
                var analyzeBtn = photoModal.querySelector('#analyzeBtn');
                var analysisResult = photoModal.querySelector('#analysisResult');
                var modalImg = photoModal.querySelector('#zoomedPhoto');

                photoModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var photoSrc = button.getAttribute('data-photo-src');
                    var photoAlt = button.getAttribute('data-photo-alt');
                    
                    var modalCaption = photoModal.querySelector('#photoCaption');
                    
                    modalImg.src = photoSrc;
                    modalCaption.textContent = photoAlt;
                    
                    // Reset analysis
                    analysisResult.classList.add('d-none');
                    analysisResult.textContent = '';
                    analyzeBtn.disabled = false;
                    analyzeBtn.innerHTML = '<i class="bi bi-magic"></i> Vérifier l\'état';
                });

                analyzeBtn.addEventListener('click', function() {
                    var photoUrl = modalImg.src;
                    var analyzeUrl = this.getAttribute('data-analyze-url');

                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Analyse...';
                    analysisResult.classList.add('d-none');

                    fetch(analyzeUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ photoUrl: photoUrl })
                    })
                    .then(response => response.json())
                    .then(data => {
                        analysisResult.classList.remove('d-none');
                        if (data.condition) {
                            analysisResult.className = 'mt-2 badge fs-6 p-2';
                            if (data.condition.includes('Mauvais')) {
                                analysisResult.classList.add('bg-danger');
                            } else if (data.condition.includes('Très bon')) {
                                analysisResult.classList.add('bg-success');
                            } else if (data.condition.includes('Bon')) {
                                analysisResult.classList.add('bg-info');
                            } else {
                                analysisResult.classList.add('bg-warning', 'text-dark');
                            }
                            analysisResult.textContent = 'État détecté : ' + data.condition;
                        } else if (data.error) {
                            analysisResult.className = 'mt-2 badge bg-danger fs-6 p-2';
                            analysisResult.textContent = 'Erreur : ' + data.error;
                        }
                    })
                    .catch(error => {
                        analysisResult.classList.remove('d-none');
                        analysisResult.className = 'mt-2 badge bg-danger fs-6 p-2';
                        analysisResult.textContent = 'Erreur de communication avec le serveur.';
                        console.error('Error:', error);
                    })
                    .finally(() => {
                        analyzeBtn.disabled = false;
                        analyzeBtn.innerHTML = '<i class="bi bi-magic"></i> Vérifier l\'état';
                    });
                });
            }
        });
    </script>
{% endblock %}
