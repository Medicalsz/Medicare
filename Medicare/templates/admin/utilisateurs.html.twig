{% extends 'admin_base.html.twig' %}

{% block title %}Gestion des Utilisateurs - Admin{% endblock %}

{% block body %}
<div class="admin-page-header">
    <h1 class="admin-page-title">
        <i class="bi bi-people"></i> Gestion des Utilisateurs
    </h1>
    <p class="admin-page-subtitle">Liste complète des utilisateurs de la plateforme</p>
</div>

<div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 30px;">
    <div class="admin-stat-card">
        <div class="admin-stat-icon primary">
            <i class="bi bi-people"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Total Utilisateurs</div>
            <div class="admin-stat-value">{{ users|length }}</div>
        </div>
    </div>
    
    <div class="admin-stat-card">
        <div class="admin-stat-icon success">
            <i class="bi bi-person-check"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Patients</div>
            <div class="admin-stat-value">{{ users|filter(u => 'ROLE_PATIENT' in u.roles)|length }}</div>
        </div>
    </div>
    
    <div class="admin-stat-card">
        <div class="admin-stat-icon warning">
            <i class="bi bi-hospital"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Médecins</div>
            <div class="admin-stat-value">{{ users|filter(u => 'ROLE_MEDECIN' in u.roles)|length }}</div>
        </div>
    </div>
    
    <div class="admin-stat-card">
        <div class="admin-stat-icon info">
            <i class="bi bi-shield-lock"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Administrateurs</div>
            <div class="admin-stat-value">{{ users|filter(u => 'ROLE_ADMIN' in u.roles)|length }}</div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-table"></i> Liste des Utilisateurs
        </h3>
        <div style="display: flex; gap: 10px;">
            <input type="text" id="searchInput" placeholder="Rechercher..." style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 8px; width: 250px;">
        </div>
    </div>
    <div class="admin-card-body">
        <div class="admin-table-container">
            <table class="admin-table" id="usersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom Complet</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Rôles</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>#{{ user.id }}</td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <div style="width: 35px; height: 35px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 14px;">
                                    {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                                </div>
                                <strong>{{ user.prenom }} {{ user.nom }}</strong>
                            </div>
                        </td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.numero }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="admin-badge danger"><i class="bi bi-shield-lock"></i> Admin</span>
                            {% endif %}
                            {%  if 'ROLE_MEDECIN' in user.roles %}
                                <span class="admin-badge warning"><i class="bi bi-hospital"></i> Médecin</span>
                            {% endif %}
                            {% if 'ROLE_PATIENT' in user.roles %}
                                <span class="admin-badge success"><i class="bi bi-person-check"></i> Patient</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.isVerified %}
                                <span class="admin-badge success"><i class="bi bi-check-circle"></i> Vérifié</span>
                            {% else %}
                                <span class="admin-badge warning"><i class="bi bi-clock-history"></i> En attente</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="display: flex; gap: 5px;">
                                <button class="admin-btn admin-btn-secondary btn-sm" title="Voir" 
                                        onclick="viewUser({{ user.id }}, '{{ user.prenom }}', '{{ user.nom }}', '{{ user.email }}', '{{ user.numero }}', '{{ user.adresse }}', {{ user.roles|json_encode }}, {{ user.isVerified ? 'true' : 'false' }})">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a href="{{ path('app_admin_utilisateurs_edit', {id: user.id}) }}" class="admin-btn admin-btn-primary btn-sm" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="admin-btn admin-btn-danger btn-sm" title="Supprimer" onclick="deleteUser({{ user.id }}, '{{ user.prenom }} {{ user.nom }}')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal pour voir les détails -->
<div class="modal fade" id="userDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title" style="font-weight: 700;">
                    <i class="bi bi-person-circle"></i> Détails de l'utilisateur
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 30px;">
                <div style="text-align: center; margin-bottom: 25px;">
                    <div id="userAvatar" style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 42px; margin: 0 auto; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);"></div>
                    <h3 id="userName" style="margin-top: 15px; font-weight: 700; color: #1e1e2d;"></h3>
                    <p id="userId" style="color: #666; font-size: 14px;"></p>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-envelope"></i> Email
                            </p>
                            <p id="userEmail" style="margin: 5px 0 0 0; font-weight: 600; color: #1e1e2d;"></p>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-telephone"></i> Téléphone
                            </p>
                            <p id="userPhone" style="margin: 5px 0 0 0; font-weight: 600; color: #1e1e2d;"></p>
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-geo-alt"></i> Adresse
                            </p>
                            <p id="userAddress" style="margin: 5px 0 0 0; font-weight: 600; color: #1e1e2d;"></p>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-shield-lock"></i> Rôles
                            </p>
                            <div id="userRoles" style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 5px;"></div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-check-circle"></i> Email vérifié
                            </p>
                            <p id="userVerified" style="margin: 8px 0 0 0;"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e0e0e0; padding: 20px;">
                <button type="button" class="admin-btn admin-btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Fermer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation de suppression -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header" style="background: #dc3545; color: white; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title" style="font-weight: 700;">
                    <i class="bi bi-exclamation-triangle-fill"></i> Confirmation de suppression
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 30px; text-align: center;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(220, 53, 69, 0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <i class="bi bi-trash" style="font-size: 40px; color: #dc3545;"></i>
                </div>
                <h4 style="font-weight: 700; color: #1e1e2d; margin-bottom: 10px;">Êtes-vous sûr ?</h4>
                <p style="color: #666; font-size: 15px; margin-bottom: 0;">
                    Vous êtes sur le point de supprimer l'utilisateur<br>
                    <strong id="deleteUserName" style="color: #1e1e2d;"></strong>
                </p>
                <p style="color: #dc3545; font-size: 14px; margin-top: 15px; font-weight: 600;">
                    <i class="bi bi-exclamation-circle"></i> Cette action est irréversible !
                </p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e0e0e0; padding: 20px; justify-content: center; gap: 10px;">
                <button type="button" class="admin-btn admin-btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Annuler
                </button>
                <button type="button" class="admin-btn admin-btn-danger" id="confirmDeleteBtn" onclick="confirmDelete()">
                    <i class="bi bi-trash"></i> Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de succès -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-body" style="padding: 40px; text-align: center;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(40, 167, 69, 0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <i class="bi bi-check-circle-fill" style="font-size: 50px; color: #28a745;"></i>
                </div>
                <h4 style="font-weight: 700; color: #1e1e2d; margin-bottom: 10px;">Suppression réussie !</h4>
                <p style="color: #666; font-size: 15px; margin-bottom: 0;">
                    L'utilisateur a été supprimé avec succès.
                </p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e0e0e0; padding: 20px; justify-content: center;">
                <button type="button" class="admin-btn admin-btn-success" data-bs-dismiss="modal" onclick="location.reload()">
                    <i class="bi bi-check-circle"></i> OK
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Recherche en temps réel
document.getElementById('searchInput').addEventListener('keyup', function() {
    const searchValue = this.value.toLowerCase();
    const rows = document.querySelectorAll('#usersTable tbody tr');
    
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchValue) ? '' : 'none';
    });
});

// Voir détails utilisateur
function viewUser(id, prenom, nom, email, phone, address, roles, isVerified) {
    // Remplir les informations
    document.getElementById('userAvatar').textContent = prenom.charAt(0).toUpperCase() + nom.charAt(0).toUpperCase();
    document.getElementById('userName').textContent = prenom + ' ' + nom;
    document.getElementById('userId').textContent = 'ID: #' + id;
    document.getElementById('userEmail').textContent = email;
    document.getElementById('userPhone').textContent = phone || 'Non renseigné';
    document.getElementById('userAddress').textContent = address || 'Non renseignée';
    
    // Rôles
    const rolesContainer = document.getElementById('userRoles');
    rolesContainer.innerHTML = '';
    
    const roleLabels = {
        'ROLE_ADMIN': { label: 'Admin', class: 'danger' },
        'ROLE_MEDECIN': { label: 'Médecin', class: 'warning' },
        'ROLE_PATIENT': { label: 'Patient', class: 'success' },
        'ROLE_USER': { label: 'User', class: 'info' }
    };
    
    roles.forEach(role => {
        const roleInfo = roleLabels[role] || { label: role, class: 'secondary' };
        const badge = document.createElement('span');
        badge.className = 'admin-badge ' + roleInfo.class;
        badge.textContent = roleInfo.label;
        rolesContainer.appendChild(badge);
    });
    
    // Email vérifié
    const verifiedContainer = document.getElementById('userVerified');
    if (isVerified) {
        verifiedContainer.innerHTML = '<span class="admin-badge success"><i class="bi bi-check-circle-fill"></i> Oui</span>';
    } else {
        verifiedContainer.innerHTML = '<span class="admin-badge warning"><i class="bi bi-exclamation-circle-fill"></i> Non</span>';
    }
    
    // Afficher la modal
    const modal = new bootstrap.Modal(document.getElementById('userDetailsModal'));
    modal.show();
}

// Supprimer utilisateur avec confirmation
let deleteUserId = null;

function deleteUser(id, name) {
    deleteUserId = id;
    document.getElementById('deleteUserName').textContent = name;
    
    const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    modal.show();
}

function confirmDelete() {
    if (!deleteUserId) return;
    
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/utilisateurs/' + deleteUserId + '/delete';
    
    document.body.appendChild(form);
    form.submit();
    
    // Fermer la modal de confirmation
    const confirmModal = bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'));
    confirmModal.hide();
    
    // Afficher la modal de succès
    setTimeout(() => {
        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
        successModal.show();
    }, 500);
}
</script>
{% endblock %}
