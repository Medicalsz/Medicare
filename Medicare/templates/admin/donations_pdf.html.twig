<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Donations - Medicare</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #099aa7;
            padding-bottom: 10px;
        }
        .header h1 {
            color: #099aa7;
            margin: 0;
            text-transform: uppercase;
        }
        .header p {
            margin: 5px 0 0;
            color: #666;
        }
        .section-title {
            background-color: #f4f4f4;
            padding: 8px 12px;
            margin-top: 20px;
            margin-bottom: 10px;
            font-weight: bold;
            color: #099aa7;
            border-left: 4px solid #099aa7;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th {
            background-color: #099aa7;
            color: white;
            text-align: left;
            padding: 8px;
        }
        td {
            border-bottom: 1px solid #eee;
            padding: 8px;
            vertical-align: top;
        }
        .amount {
            font-weight: bold;
            color: #28a745;
            text-align: right;
        }
        .qty {
            font-weight: bold;
            color: #007bff;
            text-align: center;
        }
        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            text-align: center;
            font-size: 10px;
            color: #999;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }
        .badge {
            padding: 3px 6px;
            border-radius: 4px;
            font-size: 10px;
            text-transform: uppercase;
        }
        .status-confirmé { background-color: #d1e7dd; color: #0f5132; }
        .status-en_attente { background-color: #fff3cd; color: #856404; }
        .item-list {
            margin: 0;
            padding-left: 15px;
            list-style-type: none;
        }
        .item-list li:before {
            content: "• ";
            color: #099aa7;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Medicare - Rapport des Donations</h1>
        <p>Généré le {{ "now"|date("d/m/Y H:i") }}</p>
    </div>

    <div class="section-title">Dons d'Argent</div>
    <table>
        <thead>
            <tr>
                <th width="20%">Donateur</th>
                <th width="25%">Cause</th>
                <th width="15%" style="text-align: right;">Montant</th>
                <th width="15%">Date</th>
                <th width="15%">Mode</th>
                <th width="10%">Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for don in donsArgent %}
                <tr>
                    <td>
                        <strong>{{ don.donateur.prenom }} {{ don.donateur.nom }}</strong><br>
                        <small>{{ don.donateur.email }}</small>
                    </td>
                    <td>{{ don.cause.titre }}</td>
                    <td class="amount">{{ don.montant|number_format(2, ',', ' ') }} DT</td>
                    <td>{{ don.dateDon|date('d/m/Y') }}</td>
                    <td>{{ don.modePaiement.value|capitalize }}</td>
                    <td>
                        <span class="badge status-{{ don.statutDon.value|lower }}">
                            {{ don.statutDon.value }}
                        </span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align: center;">Aucun don d'argent enregistré.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="section-title">Dons Matériels</div>
    <table>
        <thead>
            <tr>
                <th width="20%">Donateur</th>
                <th width="25%">Cause</th>
                <th width="30%">Matériels</th>
                <th width="10%" style="text-align: center;">Qté</th>
                <th width="15%">Date</th>
            </tr>
        </thead>
        <tbody>
            {% for don in donsMateriel %}
                <tr>
                    <td>
                        <strong>{{ don.donateur.prenom }} {{ don.donateur.nom }}</strong><br>
                        <small>{{ don.donateur.email }}</small>
                    </td>
                    <td>{{ don.cause.titre }}</td>
                    <td>
                        <ul class="item-list">
                            {% for objet in don.objets %}
                                <li>{{ objet.nomObjet }} (x{{ objet.quantite }})</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td class="qty">{{ don.montant|round(0, 'floor') }}</td>
                    <td>{{ don.dateDon|date('d/m/Y') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="text-align: center;">Aucun don matériel enregistré.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        © {{ "now"|date("Y") }} Medicare - Système de Gestion des Donations. Document confidentiel.
    </div>
</body>
</html>
