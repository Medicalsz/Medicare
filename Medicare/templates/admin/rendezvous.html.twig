{% extends 'admin_base.html.twig' %}

{% block title %}Gestion des Rendez-vous - Admin{% endblock %}

{% block body %}
<div class="admin-page-header">
    <h1 class="admin-page-title">
        <i class="bi bi-calendar-check"></i> Gestion des Rendez-vous
    </h1>
    <p class="admin-page-subtitle">Liste complète des rendez-vous médicaux</p>
</div>

<div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 30px;">
    <div class="admin-stat-card">
        <div class="admin-stat-icon info">
            <i class="bi bi-calendar-check"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Total Rendez-vous</div>
            <div class="admin-stat-value">{{ rendezVous|length }}</div>
        </div>
    </div>
    
    <div class="admin-stat-card">
        <div class="admin-stat-icon success">
            <i class="bi bi-check-circle"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Confirmés</div>
            <div class="admin-stat-value">{{ rendezVous|filter(r => r.statut.value == 'confirme')|length }}</div>
        </div>
    </div>
    
    <div class="admin-stat-card">
        <div class="admin-stat-icon warning">
            <i class="bi bi-clock-history"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">En attente</div>
            <div class="admin-stat-value">{{ rendezVous|filter(r => r.statut.value == 'en_attente')|length }}</div>
        </div>
    </div>
    
    <div class="admin-stat-card">
        <div class="admin-stat-icon danger">
            <i class="bi bi-x-circle"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Annulés</div>
            <div class="admin-stat-value">{{ rendezVous|filter(r => r.statut.value == 'annule')|length }}</div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-table"></i> Liste des Rendez-vous
        </h3>
        <input type="text" id="searchInput" placeholder="Rechercher..." style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 8px; width: 250px;">
    </div>
    <div class="admin-card-body">
        <div class="admin-table-container">
            <table class="admin-table" id="rdvTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Médecin</th>
                        <th>Date</th>
                        <th>Heure</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rdv in rendezVous %}
                    <tr>
                        <td>#{{ rdv.id }}</td>
                        <td>
                            <strong>{{ rdv.patient.user.prenom }} {{ rdv.patient.user.nom }}</strong>
                        </td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-hospital" style="color: #f59e0b;"></i>
                                <span>Dr {{ rdv.medecin.user.prenom }} {{ rdv.medecin.user.nom }}</span>
                            </div>
                        </td>
                        <td>{{ rdv.date|date('d/m/Y') }}</td>
                        <td>{{ rdv.heure|date('H:i') }}</td>
                        <td>
                            {% if rdv.statut.value == 'confirme' %}
                                <span class="admin-badge success">
                                    <i class="bi bi-check-circle"></i> Confirmé
                                </span>
                            {% elseif rdv.statut.value == 'en_attente' %}
                                <span class="admin-badge warning">
                                    <i class="bi bi-clock-history"></i> En attente
                                </span>
                            {% elseif rdv.statut.value == 'annule' %}
                                <span class="admin-badge danger">
                                    <i class="bi bi-x-circle"></i> Annulé
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="display: flex; gap: 5px;">
                                <button class="admin-btn admin-btn-secondary btn-sm" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="admin-btn admin-btn-primary btn-sm" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="admin-btn admin-btn-danger btn-sm" title="Annuler">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.getElementById('searchInput').addEventListener('keyup', function() {
    const searchValue = this.value.toLowerCase();
    const rows = document.querySelectorAll('#rdvTable tbody tr');
    
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchValue) ? '' : 'none';
    });
});
</script>
{% endblock %}
