{% extends 'admin_base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/admindashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <h1 class="admin-page-title">Dashboard Administration</h1>
        <p class="admin-page-subtitle">Bienvenue dans votre espace d'administration Medicare</p>
    </div>

    {# Stats Cards #}
    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon primary">
                <i class="bi bi-people"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Total Utilisateurs</div>
                <div class="admin-stat-value">1,234</div>
                <div class="admin-stat-change positive">
                    <i class="bi bi-arrow-up"></i> +12% ce mois
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon success">
                <i class="bi bi-person-heart"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Patients Actifs</div>
                <div class="admin-stat-value">856</div>
                <div class="admin-stat-change positive">
                    <i class="bi bi-arrow-up"></i> +8% ce mois
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon warning">
                <i class="bi bi-hospital"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Médecins</div>
                <div class="admin-stat-value">142</div>
                <div class="admin-stat-change positive">
                    <i class="bi bi-arrow-up"></i> +5 ce mois
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon info">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Rendez-vous</div>
                <div class="admin-stat-value">523</div>
                <div class="admin-stat-change negative">
                    <i class="bi bi-arrow-down"></i> -3% ce mois
                </div>
            </div>
        </div>
    </div>

    <div class="admin-page-header mt-4">
        <h2 class="admin-page-title" style="font-size: 28px;">Stats Forum</h2>
        <p class="admin-page-subtitle">Indicateurs analytiques de l'activite communautaire</p>
    </div>

    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon primary">
                <i class="bi bi-chat-square-text"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Total Sujets</div>
                <div class="admin-stat-value">{{ forum_stats.total_topics }}</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon info">
                <i class="bi bi-chat-left-text"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Total Commentaires</div>
                <div class="admin-stat-value">{{ forum_stats.total_comments }}</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon success">
                <i class="bi bi-calendar-plus"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Sujets Aujourd'hui</div>
                <div class="admin-stat-value">+{{ forum_stats.topics_today }}</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon warning">
                <i class="bi bi-chat-left-dots"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Commentaires Aujourd'hui</div>
                <div class="admin-stat-value">+{{ forum_stats.comments_today }}</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon warning">
                <i class="bi bi-flag"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Sujets Signales</div>
                <div class="admin-stat-value">{{ forum_stats.reported_topics }}</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon danger">
                <i class="bi bi-chat-left-text-fill"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Commentaires Signales</div>
                <div class="admin-stat-value">{{ forum_stats.reported_comments }}</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon primary">
                <i class="bi bi-stars"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Top Categorie</div>
                <div class="admin-stat-value" style="font-size: 26px;">{{ forum_stats.top_category }}</div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-graph-up-arrow"></i> Activite Forum (7 jours)
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="admin-table-container">
                        <table class="admin-table" id="forumActivityTable">
                            <thead>
                                <tr>
                                    <th>
                                        <button type="button" class="admin-activity-sort-btn admin-sort-btn" data-sort-key="day" aria-label="Trier par jour">
                                            Jour <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="admin-activity-sort-btn admin-sort-btn" data-sort-key="topics" aria-label="Trier par sujets">
                                            Sujets <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="admin-activity-sort-btn admin-sort-btn" data-sort-key="comments" aria-label="Trier par commentaires">
                                            Commentaires <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th>Tendance</th>
                                </tr>
                            </thead>
                            <tbody id="forumActivityBody">
                                {% for row in forum_activity_rows %}
                                    <tr data-day="{{ row.date_key }}" data-topics="{{ row.topics }}" data-comments="{{ row.comments }}">
                                        <td>{{ row.day }}</td>
                                        <td>{{ row.topics }}</td>
                                        <td>{{ row.comments }}</td>
                                        <td>
                                            <div class="d-flex flex-column gap-1" style="min-width: 180px;">
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: {{ row.topic_pct }}%"></div>
                                                </div>
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-info" role="progressbar" style="width: {{ row.comment_pct }}%"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-shield-exclamation"></i> Moderation / Signalements
                    </h3>
                </div>
                <div class="admin-card-body">
                    <form method="get" action="{{ path('app_admin_dashboard') }}" class="mb-3" id="moderationFiltersForm">
                        <div class="btn-group w-100 mb-2" role="group" aria-label="Filtre signalements">
                            <a class="btn btn-outline-primary btn-sm {% if moderation_filters.type == 'all' %}active{% endif %}" href="{{ path('app_admin_dashboard', {moderation_type: 'all', moderation_order: moderation_filters.order, moderation_search: moderation_filters.search}) }}">Tous</a>
                            <a class="btn btn-outline-primary btn-sm {% if moderation_filters.type == 'topics' %}active{% endif %}" href="{{ path('app_admin_dashboard', {moderation_type: 'topics', moderation_order: moderation_filters.order, moderation_search: moderation_filters.search}) }}">Sujets signales</a>
                            <a class="btn btn-outline-primary btn-sm {% if moderation_filters.type == 'comments' %}active{% endif %}" href="{{ path('app_admin_dashboard', {moderation_type: 'comments', moderation_order: moderation_filters.order, moderation_search: moderation_filters.search}) }}">Commentaires signales</a>
                        </div>
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text bg-primary-subtle text-primary border-primary-subtle"><i class="bi bi-search"></i></span>
                            <input
                                type="search"
                                class="form-control"
                                name="moderation_search"
                                id="moderationSearchInput"
                                value="{{ moderation_filters.search }}"
                                placeholder="Rechercher par utilisateur"
                                maxlength="100"
                            >
                        </div>
                        <div class="d-flex gap-2">
                            <input type="hidden" name="moderation_type" value="{{ moderation_filters.type }}">
                            <select class="form-select form-select-sm" name="moderation_order" id="moderationOrderSelect">
                                <option value="desc" {% if moderation_filters.order == 'desc' %}selected{% endif %}>Date: plus recente</option>
                                <option value="asc" {% if moderation_filters.order == 'asc' %}selected{% endif %}>Date: plus ancienne</option>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
                        </div>
                    </form>

                    {% if moderation_items is empty %}
                        <div class="alert alert-success py-2 mb-0">Aucun signalement pour ce filtre.</div>
                    {% else %}
                        <div class="alert alert-warning py-2 mb-2 d-none" id="moderationNoMatchAlert">Aucun resultat pour cette recherche.</div>
                        {% for item in moderation_items %}
                            <div class="border rounded p-2 mb-2 bg-primary-subtle js-moderation-item" style="--bs-bg-opacity: .22;" data-author="{{ item.author|lower }}">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <span class="badge text-bg-primary mb-1">{{ item.type == 'topic' ? 'Sujet' : 'Commentaire' }}</span>
                                        <div class="fw-semibold">{{ item.title|slice(0, 38) }}{% if item.title|length > 38 %}...{% endif %}</div>
                                        <div class="small text-muted">Par {{ item.author ?: 'Utilisateur inconnu' }}</div>
                                        <div class="small text-muted">Raison: {{ item.reason }}</div>
                                        <div class="small mt-1">{{ item.content_preview|slice(0, 70) }}{% if item.content_preview|length > 70 %}...{% endif %}</div>
                                    </div>
                                    <div class="small text-muted text-end">
                                        {{ item.reported_at ? item.reported_at|date('d/m/Y H:i') : '-' }}
                                    </div>
                                </div>
                                <div class="moderation-actions mt-2">
                                    <a href="{{ path('app_admin_forum_show', {id: item.topic_id}) }}" class="admin-btn admin-btn-secondary btn-sm">Voir</a>
                                    {% if item.type == 'topic' %}
                                        <form method="post" action="{{ path('app_admin_forum_resolve_topic_report', {id: item.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('resolve_topic_report_' ~ item.id) }}">
                                            <button class="admin-btn admin-btn-secondary btn-sm" type="submit">Masquer</button>
                                        </form>
                                        <form method="post" action="{{ path('app_admin_forum_delete', {id: item.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce sujet ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ item.id) }}">
                                            <button class="admin-btn admin-btn-secondary btn-sm" type="submit">Supprimer</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('app_admin_forum_resolve_comment_report', {id: item.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('resolve_comment_report_' ~ item.id) }}">
                                            <button class="admin-btn admin-btn-secondary btn-sm" type="submit">Masquer</button>
                                        </form>
                                        <form method="post" action="{{ path('app_admin_forum_delete_comment', {id: item.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ item.id) }}">
                                            <button class="admin-btn admin-btn-secondary btn-sm" type="submit">Supprimer</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-calendar-event"></i> Rendez-vous Récents
                    </h3>
                    <button class="admin-btn admin-btn-primary">
                        <i class="bi bi-plus-circle"></i> Nouveau
                    </button>
                </div>
                <div class="admin-card-body">
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Médecin</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Marie Dupont</td>
                                    <td>Dr. Jean Martin</td>
                                    <td>15/02/2026 14:30</td>
                                    <td><span class="admin-badge success">Confirmé</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Pierre Lemoine</td>
                                    <td>Dr. Sophie Bernard</td>
                                    <td>16/02/2026 09:00</td>
                                    <td><span class="admin-badge warning">En attente</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Claire Dubois</td>
                                    <td>Dr. Luc Petit</td>
                                    <td>16/02/2026 11:00</td>
                                    <td><span class="admin-badge success">Confirmé</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Thomas Moreau</td>
                                    <td>Dr. Anne Lefebvre</td>
                                    <td>17/02/2026 15:45</td>
                                    <td><span class="admin-badge danger">Annulé</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-graph-up"></i> Activités
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="activity-item mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon primary" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-person-plus"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">Nouvel utilisateur</div>
                                <small style="color: #888;">Il y a 5 minutes</small>
                            </div>
                        </div>
                    </div>

                    <div class="activity-item mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon success" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">RDV confirmé</div>
                                <small style="color: #888;">Il y a 15 minutes</small>
                            </div>
                        </div>
                    </div>

                    <div class="activity-item mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon warning" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">Nouveau médecin</div>
                                <small style="color: #888;">Il y a 1 heure</small>
                            </div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon info" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-file-text"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">Rapport généré</div>
                                <small style="color: #888;">Il y a 2 heures</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-bell"></i> Notifications
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="alert alert-warning mb-2" role="alert">
                        <strong>5</strong> demandes médecins en attente
                    </div>
                    <div class="alert alert-info mb-2" role="alert">
                        <strong>12</strong> nouveaux messages
                    </div>
                    <div class="alert alert-success" role="alert">
                        Système à jour
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
