{% extends 'admin_base.html.twig' %}

{% block title %}Gestion des Médecins - Admin{% endblock %}

{% block body %}
<div class="admin-page-header">
    <h1 class="admin-page-title">
        <i class="bi bi-hospital"></i> Gestion des Médecins
    </h1>
    <p class="admin-page-subtitle">Liste complète des médecins de la plateforme</p>
</div>

<div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 30px;">
    <div class="admin-stat-card">
        <div class="admin-stat-icon warning">
            <i class="bi bi-hospital"></i>
        </div>
        <div class="admin-stat-content">
            <div class="admin-stat-label">Total Médecins</div>
            <div class="admin-stat-value">{{ medecins|length }}</div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-table"></i> Liste des Médecins
        </h3>
        <input type="text" id="searchInput" placeholder="Rechercher..." style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 8px; width: 250px;">
    </div>
    <div class="admin-card-body">
        <div class="admin-table-container">
            <table class="admin-table" id="medecinsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom Complet</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Spécialité</th>
                        <th>Cabinet</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for medecin in medecins %}
                    <tr>
                        <td>#{{ medecin.id }}</td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <div style="width: 35px; height: 35px; border-radius: 50%; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 14px;">
                                    {{ medecin.user.prenom|first|upper }}{{ medecin.user.nom|first|upper }}
                                </div>
                                <strong>Dr {{ medecin.user.prenom }} {{ medecin.user.nom }}</strong>
                            </div>
                        </td>
                        <td>{{ medecin.user.email }}</td>
                        <td>{{ medecin.user.numero }}</td>
                        <td>
                            <span class="admin-badge info">
                                <i class="bi bi-stethoscope"></i> {{ medecin.specialite }}
                            </span>
                        </td>
                        <td>{{ medecin.cabinet }}</td>
                        <td>
                            <button class="admin-btn admin-btn-secondary btn-sm" title="Voir détails" 
                                    onclick="viewMedecin({{ medecin.id }}, '{{ medecin.user.prenom }}', '{{ medecin.user.nom }}', '{{ medecin.user.email }}', '{{ medecin.user.numero }}', '{{ medecin.specialite ?? 'Non renseignée' }}', '{{ medecin.cabinet ?? 'Non renseigné' }}')">
                                <i class="bi bi-eye"></i> Voir
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal détails médecin -->
<div class="modal fade" id="medecinDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: white; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title" style="font-weight: 700;">
                    <i class="bi bi-stethoscope"></i> Détails du médecin
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 30px;">
                <div style="text-align: center; margin-bottom: 25px;">
                    <div id="medecinAvatar" style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 42px; margin: 0 auto; box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);"></div>
                    <h3 id="medecinName" style="margin-top: 15px; font-weight: 700; color: #1e1e2d;"></h3>
                    <p id="medecinId" style="color: #666; font-size: 14px;"></p>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-envelope"></i> Email
                            </p>
                            <p id="medecinEmail" style="margin: 5px 0 0 0; font-weight: 600; color: #1e1e2d;"></p>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-telephone"></i> Téléphone
                            </p>
                            <p id="medecinPhone" style="margin: 5px 0 0 0; font-weight: 600; color: #1e1e2d;"></p>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-heart-pulse"></i> Spécialité
                            </p>
                            <p id="medecinSpeciality" style="margin: 5px 0 0 0; font-weight: 600; color: #ffc107;"></p>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                            <p style="margin: 0; color: #666; font-size: 12px; text-transform: uppercase; font-weight: 600;">
                                <i class="bi bi-hospital"></i> Cabinet
                            </p>
                            <p id="medecinCabinet" style="margin: 5px 0 0 0; font-weight: 600; color: #1e1e2d;"></p>
                        </div>
                    </div>
                </div>

                <div style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.1) 0%, rgba(255, 152, 0, 0.1) 100%); padding: 15px; border-radius: 10px; margin-top: 20px;">
                    <p style="margin: 0; color: #666; font-size: 13px;">
                        <i class="bi bi-info-circle"></i> Pour modifier les informations de ce médecin, rendez-vous dans la section <strong>Utilisateurs</strong>.
                    </p>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e0e0e0; padding: 20px;">
                <button type="button" class="admin-btn admin-btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Fermer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('searchInput').addEventListener('keyup', function() {
    const searchValue = this.value.toLowerCase();
    const rows = document.querySelectorAll('#medecinsTable tbody tr');
    
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchValue) ? '' : 'none';
    });
});

// Voir détails médecin
function viewMedecin(id, prenom, nom, email, phone, speciality, cabinet) {
    document.getElementById('medecinAvatar').textContent = prenom.charAt(0).toUpperCase() + nom.charAt(0).toUpperCase();
    document.getElementById('medecinName').textContent = 'Dr. ' + prenom + ' ' + nom;
    document.getElementById('medecinId').textContent = 'Médecin #' + id;
    document.getElementById('medecinEmail').textContent = email;
    document.getElementById('medecinPhone').textContent = phone || 'Non renseigné';
    document.getElementById('medecinSpeciality').textContent = speciality;
    document.getElementById('medecinCabinet').textContent = cabinet;
    
    const modal = new bootstrap.Modal(document.getElementById('medecinDetailsModal'));
    modal.show();
}
</script>
{% endblock %}
