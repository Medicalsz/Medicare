{% extends 'dashboard_base.html.twig' %}

{% block title %}Forum - Medicare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/forum-modern.css') }}?v=20260221-2">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const menuButtons = document.querySelectorAll('.forum-modern .forum-ellipsis-btn');

            const closeAllMenus = function () {
                document.querySelectorAll('.forum-modern .dropdown-menu.show').forEach(function (menu) {
                    menu.classList.remove('show');
                });
            };

            menuButtons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const menu = button.parentElement.querySelector('.dropdown-menu');
                    const isOpen = menu && menu.classList.contains('show');
                    closeAllMenus();
                    if (menu && !isOpen) {
                        menu.classList.add('show');
                    }
                });
            });

            document.addEventListener('click', function () {
                closeAllMenus();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllMenus();
                }
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="dashboard-content forum-modern forum-page">
    <div class="forum-header forum-user-index-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <p class="forum-kicker mb-1">Forum Medicare</p>
            <h1 class="page-title mb-2">Discussions de la communaute</h1>
            <p class="page-subtitle mb-0">Consultez les sujets existants, publiez vos questions et commentez.</p>
        </div>
        <a href="{{ path('app_user_forum_new') }}" class="btn btn-primary forum-cta forum-user-new-btn">
            <i class="fas fa-plus me-2"></i>Nouveau sujet
        </a>
    </div>
    <div class="forum-kind-tabs mb-3">
        <a href="{{ path('app_user_forum_index', {kind: 'article'}) }}" class="forum-kind-tab {{ current_kind == 'article' ? 'active' : '' }}">
            Articles
        </a>
        <a href="{{ path('app_user_forum_index', {kind: 'video'}) }}" class="forum-kind-tab {{ current_kind == 'video' ? 'active' : '' }}">
            Videos medicales
        </a>
    </div>

    {% if topics is empty %}
        <div class="forum-empty forum-user-list-start text-center py-5">
            <div class="forum-empty-icon mb-3"><i class="fas fa-comments"></i></div>
            <h2 class="h4 mb-2">Aucun sujet pour le moment</h2>
            <p class="text-muted mb-4">Soyez le premier a lancer une discussion.</p>
            <a href="{{ path('app_user_forum_new') }}" class="btn btn-primary">Creer un sujet</a>
        </div>
    {% else %}
        <div class="forum-topic-grid forum-user-list-start forum-showcase-grid">
            {% for topic in topics %}
                {% set commentsCount = topic.comments|length %}
                {% set latestComment = commentsCount > 0 ? (topic.comments|last) : null %}
                {% set viewsCount = topic.content|length + (commentsCount * 17) %}
                {% set reaction = user_reaction_map[topic.id] ?? null %}
                {% set reactionCounts = reaction_counts[topic.id] ?? {'like': 0, 'love': 0, 'total': 0} %}
                <article class="forum-topic-card forum-showcase-card">
                    <div class="forum-topic-card-menu dropdown">
                        <button class="btn btn-sm btn-light forum-ellipsis-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">...</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" action="{{ path('app_user_forum_report_topic', {id: topic.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('report_topic_' ~ topic.id) }}">
                                    <input type="hidden" name="reason" value="Sujet signale par utilisateur">
                                    <button type="submit" class="dropdown-item">Signaler</button>
                                </form>
                            </li>
                            {% if app.user and (is_granted('ROLE_ADMIN') or app.user.id == topic.author.id) %}
                                <li>
                                    <form method="post" action="{{ path('app_user_forum_hide_topic', {id: topic.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('hide_topic_' ~ topic.id) }}">
                                        <button type="submit" class="dropdown-item">Masquer</button>
                                    </form>
                                </li>
                                <li>
                                    <form method="post" action="{{ path('app_user_forum_delete_topic', {id: topic.id}) }}" onsubmit="return confirm('Supprimer ce sujet ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                                        <button type="submit" class="dropdown-item text-danger">Supprimer</button>
                                    </form>
                                </li>
                            {% endif %}
                        </ul>
                    </div>

                    <h3 class="forum-showcase-title">
                        {{ topic.title|slice(0, 56) }}{% if topic.title|length > 56 %}...{% endif %}
                    </h3>
                    {% if topic.isVideoType %}
                        <span class="forum-kind-badge mb-2"><i class="fas fa-play-circle me-1"></i>Video medicale</span>
                        {% include 'dashboard/forum/_video_player.html.twig' with {topic: topic} %}
                    {% endif %}

                    <p class="forum-showcase-excerpt">
                        {% set preview = topic.summary ?: topic.content %}
                        {{ preview|striptags|slice(0, 120) }}{% if preview|length > 120 %}...{% endif %}
                    </p>

                    <p class="forum-showcase-date">
                        Dernier commentaire : {{ (latestComment ? latestComment.createdAt : topic.createdAt)|date('d/m/Y') }}
                    </p>

                    <div class="forum-showcase-avatars">
                        {% set shown = 0 %}
                        {% for comment in topic.comments|reverse %}
                            {% if shown < 3 %}
                                <span class="forum-avatar-mini" title="{{ comment.author.prenom }} {{ comment.author.nom }}">
                                    {{ (comment.author.prenom|first ~ comment.author.nom|first)|upper }}
                                </span>
                                {% set shown = shown + 1 %}
                            {% endif %}
                        {% endfor %}
                        {% if shown == 0 %}
                            <span class="forum-avatar-mini" title="{{ topic.author.prenom }} {{ topic.author.nom }}">
                                {{ (topic.author.prenom|first ~ topic.author.nom|first)|upper }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="forum-showcase-footer">
                        <div class="forum-showcase-metrics">
                            <span><i class="fas fa-eye"></i>{{ viewsCount }}</span>
                            <span><i class="fas fa-comment-alt"></i>{{ commentsCount }}</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_user_forum_show', {id: topic.id}) }}" class="btn btn-sm btn-outline-secondary forum-btn-back">
                                <i class="fas fa-eye me-2"></i>Voir
                            </a>
                            <a href="{{ path('app_user_forum_show', {id: topic.id}) }}" class="btn forum-comment-btn">
                                <i class="fas fa-reply me-2"></i>Commenter
                            </a>
                        </div>
                    </div>

                    <div class="forum-reaction-bar mt-2">
                        <form method="post" action="{{ path('app_user_forum_react', {id: topic.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('react_topic_' ~ topic.id) }}">
                            <input type="hidden" name="type" value="like">
                            <button type="submit" class="forum-react-btn {{ reaction == 'like' ? 'active' : '' }}">
                                👍 J'aime <span class="count">{{ reactionCounts.like }}</span>
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_user_forum_react', {id: topic.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('react_topic_' ~ topic.id) }}">
                            <input type="hidden" name="type" value="love">
                            <button type="submit" class="forum-react-btn love {{ reaction == 'love' ? 'active' : '' }}">
                                ❤️ J'adore <span class="count">{{ reactionCounts.love }}</span>
                            </button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

