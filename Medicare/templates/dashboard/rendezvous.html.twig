{% extends 'dashboard_base.html.twig' %}

{% block title %}Mes rendez-vous - Medicare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .appointments-page {
            padding: 30px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .page-header h1 {
            font-size: 32px;
            color: #1a1a1a;
            font-weight: 700;
            margin: 0;
        }

        .btn-new-appointment {
            background: linear-gradient(135deg, #667eea 0%, 100%);
            color: white;
            padding: 14px 28px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-new-appointment:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .btn-new-appointment i {
            font-size: 18px;
        }

        .appointments-count {
            color: #666;
            font-size: 16px;
            margin-bottom: 25px;
        }

        .appointments-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: 25px;
            margin-top: 25px;
        }

        .appointment-card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border: 1px solid #f0f0f0;
            position: relative;
            overflow: hidden;
        }

        .appointment-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .appointment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .doctor-info {
            display: flex;
            gap: 18px;
            margin-bottom: 20px;
        }

        .doctor-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
            background: linear-gradient(135deg, #667eea 0%,  100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 26px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        .doctor-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .doctor-details {
            flex: 1;
        }

        .doctor-name {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 5px;
        }

        .doctor-specialty {
            color: #667eea;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .appointment-info {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #555;
            font-size: 14px;
        }

        .info-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #f8f9ff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #667eea;
            font-size: 16px;
            flex-shrink: 0;
        }

        .info-content {
            flex: 1;
        }

        .info-label {
            font-size: 12px;
            color: #999;
            margin-bottom: 2px;
        }

        .info-value {
            font-weight: 600;
            color: #333;
        }

        .appointment-status {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .status-confirme {
            background: #d4edda;
            color: #155724;
        }

        .status-en_attente {
            background: #fff3cd;
            color: #856404;
        }

        .status-annule {
            background: #f8d7da;
            color: #721c24;
        }

        .card-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-view {
            flex: 1;
            background: linear-gradient(135deg, #667eea  100%);
            color: white;
            padding: 12px 20px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        }

        .empty-state-icon {
            font-size: 80px;
            color: #e0e0e0;
            margin-bottom: 25px;
        }

        .empty-state h2 {
            font-size: 24px;
            color: #333;
            margin-bottom: 12px;
        }

        .empty-state p {
            color: #666;
            font-size: 16px;
            margin-bottom: 30px;
        }

        @media (max-width: 768px) {
            .appointments-page {
                padding: 20px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .page-header h1 {
                font-size: 26px;
            }

            .appointments-grid {
                grid-template-columns: 1fr;
            }

            .btn-new-appointment {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="appointments-page">
    <!-- En-tête avec titre et bouton -->
    <div class="page-header">
        <h1><i class="fas fa-calendar-check"></i> Mes rendez-vous</h1>
        <a href="{{ path('app_prendre_rdv') }}" class="btn-new-appointment">
            <i class="fas fa-plus"></i>
            Prendre rendez-vous
        </a>
    </div>

    {% if rendezVous is not empty %}
        <div class="appointments-count">
            <i class="fas fa-info-circle"></i> 
            Vous avez <strong>{{ rendezVous|length }}</strong> rendez-vous{% if rendezVous|length > 1 %}s{% endif %}
        </div>

        <!-- Grille de cards des rendez-vous -->
        <div class="appointments-grid">
            {% for rdv in rendezVous %}
                <div class="appointment-card">
                    <!-- Statut -->
                    <span class="appointment-status status-{{ rdv.statut.value }}">
                        {% if rdv.statut.value == 'confirme' %}
                            ✓ Confirmé
                        {% elseif rdv.statut.value == 'en_attente' %}
                            ⏱ En attente
                        {% elseif rdv.statut.value == 'annule' %}
                            ✗ Annulé
                        {% endif %}
                    </span>

                    <!-- Informations du médecin -->
                    <div class="doctor-info">
                        <div class="doctor-avatar">
                            {% if rdv.medecin.user.photo ?? false %}
                                <img src="{{ asset('uploads/doctors/' ~ rdv.medecin.user.photo) }}" 
                                     alt="Dr {{ rdv.medecin.user.nom }}">
                            {% else %}
                                {{ rdv.medecin.user.prenom|first|upper }}{{ rdv.medecin.user.nom|first|upper }}
                            {% endif %}
                        </div>
                        <div class="doctor-details">
                            <div class="doctor-name">
                                Dr {{ rdv.medecin.user.prenom }} {{ rdv.medecin.user.nom }}
                            </div>
                            <div class="doctor-specialty">
                                <i class="fas fa-stethoscope"></i> {{ rdv.medecin.specialite }}
                            </div>
                        </div>
                    </div>

                    <!-- Informations du rendez-vous -->
                    <div class="appointment-info">
                        <!-- Cabinet -->
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-hospital"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Cabinet</div>
                                <div class="info-value">{{ rdv.medecin.cabinet }}</div>
                            </div>
                        </div>

                        <!-- Date et heure -->
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-calendar-day"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Date et heure</div>
                                <div class="info-value">
                                    {{ rdv.date|date('d/m/Y') }} à {{ rdv.heure|date('H:i') }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="card-actions">
                        <a href="#" class="btn-view">
                            <i class="fas fa-eye"></i>
                            Voir les détails
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}
        <!-- État vide -->
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-calendar-times"></i>
            </div>
            <h2>Aucun rendez-vous</h2>
            <p>Vous n'avez pas encore de rendez-vous médical.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
