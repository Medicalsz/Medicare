{% extends 'dashboard_base.html.twig' %}

{% block title %}Forum - Medicare{% endblock %}

{% block body %}
<div class="dashboard-content py-4">
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold text-primary mb-1">Forum</h1>
            <p class="text-muted fs-5">Échangez avec la communauté Medicare</p>
        </div>
        <a href="{{ path('forum_new') }}" class="btn btn-primary btn-lg px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i> Nouveau sujet
        </a>
    </div>

    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-header bg-light py-4">
            <h3 class="card-title mb-0">Tous les sujets</h3>
        </div>

        <div class="card-body p-0">
            {% if topics is empty %}
                <div class="text-center py-5 my-5">
                    <i class="fas fa-comments fa-5x text-muted opacity-50 mb-4"></i>
                    <h4 class="text-muted">Aucun sujet pour le moment</h4>
                    <p class="text-muted">Soyez le premier à partager votre expérience !</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Titre</th>
                                <th>Auteur</th>
                                <th>Créé le</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for topic in topics %}
                            <tr>
                                <td class="ps-4 fw-medium">{{ topic.title|length > 80 ? (topic.title|slice(0, 77) ~ '...') : topic.title }}</td>
                                <td>
                                    {{ topic.author.prenom }} {{ topic.author.nom }}
                                </td>
                                <td>{{ topic.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('forum_show', {id: topic.id}) }}"
                                           class="btn btn-outline-primary">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('forum_edit', {id: topic.id}) }}"
                                           class="btn btn-outline-secondary">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="post" action="{{ path('forum_delete', {id: topic.id}) }}"
                                              class="d-inline" onsubmit="return confirm('Vraiment supprimer ce sujet ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="fas fa-trash-alt"></i> Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}