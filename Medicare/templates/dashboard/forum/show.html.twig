{% extends 'admin_base.html.twig' %}

{% block title %}{{ topic.title }} - Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/forum-modern.css') }}">
{% endblock %}

{% block body %}
<div class="dashboard-content forum-modern forum-page">
    <div class="forum-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <p class="forum-kicker mb-1">Sujet</p>
            <h1 class="page-title mb-2">{{ topic.title }}</h1>
            <p class="page-subtitle mb-0">
                Par {{ topic.author.prenom }} {{ topic.author.nom }} | {{ topic.createdAt|date('d/m/Y H:i') }}
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_admin_forum_index') }}" class="btn btn-outline-secondary">Retour</a>
            <a href="{{ path('app_admin_forum_edit', {id: topic.id}) }}" class="btn btn-outline-secondary">Modifier</a>
            <form method="post" action="{{ path('app_admin_forum_delete', {id: topic.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce sujet ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                <button type="submit" class="btn btn-outline-danger">Supprimer</button>
            </form>
        </div>
    </div>

    <article class="forum-topic-main mb-4">
        <p class="forum-topic-main-content">{{ topic.content|nl2br }}</p>
    </article>

    <section class="forum-comments mb-4">
        <div class="forum-section-head">
            <h2 class="h4 mb-0">Commentaires</h2>
            <span class="forum-pill">{{ topic.comments|length }}</span>
        </div>

        {% if topic.comments is empty %}
            <div class="forum-empty-sm mt-3">Aucun commentaire pour le moment.</div>
        {% else %}
            <div class="forum-comments-list mt-3">
                {% for comment in topic.comments %}
                    <article class="forum-comment-card">
                        <div class="forum-comment-meta">
                            <strong>{{ comment.author.prenom }} {{ comment.author.nom }}</strong>
                            <span>{{ comment.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                        <p class="mb-0">{{ comment.content }}</p>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="forum-reply-box">
        <div class="forum-section-head">
            <h2 class="h5 mb-0">Ajouter un commentaire</h2>
        </div>
        <div class="mt-3">
            {{ form_start(form) }}
                {{ form_row(form.content, {
                    'label': false,
                    'attr': {
                        'rows': 4,
                        'class': 'form-control forum-textarea',
                        'placeholder': 'Ecrivez votre commentaire...'
                    }
                }) }}
                <button type="submit" class="btn btn-primary mt-2">
                    <i class="fas fa-paper-plane me-2"></i>Publier
                </button>
            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}

