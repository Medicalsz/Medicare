{% extends 'dashboard_base.html.twig' %}

{% block title %}{{ topic.title }} - Forum{% endblock %}

{% block body %}
<div class="dashboard-content">
    <div class="page-header">
        <div>
            <h1 class="page-title">{{ topic.title }}</h1>
            <p class="page-subtitle">Par {{ topic.author.prenom }} {{ topic.author.nom }} • {{ topic.createdAt|date('d/m/Y H:i') }}</p>
        </div>
        <div>
            <a href="{{ path('dashboard_forum') }}" class="btn btn-secondary">Retour</a>
            <a href="{{ path('forum_edit', {id: topic.id}) }}" class="btn btn-secondary">Modifier</a>
            <form method="post" action="{{ path('forum_delete', {id: topic.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce sujet ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                <button class="btn btn-secondary" type="submit">Supprimer</button>
            </form>
        </div>
    </div>

    <div class="card" style="margin-bottom: 20px;">
        <p style="white-space: pre-line; line-height: 1.6;">{{ topic.content }}</p>
    </div>

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h3 class="card-title">Commentaires ({{ topic.comments|length }})</h3>
        </div>

        {% if topic.comments is empty %}
            <p style="color: #666;">Aucun commentaire pour le moment.</p>
        {% else %}
            <div class="comments-list">
                {% for c in topic.comments %}
                    <div class="comment-item">
                        <div class="comment-meta">
                            <strong>{{ c.author.prenom }} {{ c.author.nom }}</strong>
                            <span>{{ c.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                        <p>{{ c.content }}</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Ajouter un commentaire</h3>
        </div>
        {{ form_start(form) }}
            {{ form_row(form.content) }}
            <button class="btn btn-primary" type="submit">Publier</button>
        {{ form_end(form) }}
    </div>
</div>

<style>
    .comments-list { display: flex; flex-direction: column; gap: 15px; }
    .comment-item { padding: 12px 14px; background: #f9fcff; border-radius: 10px; border: 1px solid #e6f0f7; }
    .comment-meta { display: flex; justify-content: space-between; font-size: 13px; color: #666; margin-bottom: 6px; }
</style>
{% endblock %}
