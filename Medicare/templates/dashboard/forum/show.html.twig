{% extends 'dashboard_base.html.twig' %}

{% block title %}{{ topic.title }} - Forum{% endblock %}

{% block body %}
<div class="dashboard-content">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">{{ topic.title }}</h1>
            <p class="page-subtitle text-muted">
                Par {{ topic.author.prenom }} {{ topic.author.nom }} • {{ topic.createdAt|date('d/m/Y H:i') }}
            </p>
        </div>
        <div class="btn-group">
            <a href="{{ path('dashboard_forum') }}" class="btn btn-outline-secondary">Retour</a>
            <a href="{{ path('forum_edit', {id: topic.id}) }}" class="btn btn-outline-secondary">Modifier</a>
            <form method="post" action="{{ path('forum_delete', {id: topic.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce sujet ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                <button type="submit" class="btn btn-outline-danger">Supprimer</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <p class="lead" style="white-space: pre-line; line-height: 1.7;">{{ topic.content }}</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light">
            <h3 class="card-title mb-0">Commentaires ({{ topic.comments|length }})</h3>
        </div>
        <div class="card-body">
            {% if topic.comments is empty %}
                <p class="text-center text-muted py-4">Aucun commentaire pour le moment.</p>
            {% else %}
                <div class="comments-list">
                    {% for comment in topic.comments %}
                    <div class="comment-item p-3 bg-light rounded mb-3">
                        <div class="d-flex justify-content-between mb-2 small text-muted">
                            <strong>{{ comment.author.prenom }} {{ comment.author.nom }}</strong>
                            <span>{{ comment.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                        <p class="mb-0">{{ comment.content }}</p>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h3 class="card-title mb-0">Ajouter un commentaire</h3>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.content, {
                    'label': false,
                    'attr': {'rows': 5, 'placeholder': 'Votre commentaire...', 'required': true}
                }) }}
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Publier le commentaire</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}