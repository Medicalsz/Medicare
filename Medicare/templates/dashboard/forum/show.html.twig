{% extends 'admin_base.html.twig' %}

{% block title %}{{ topic.title }} - Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/forum-modern.css') }}?v=20260305-1">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const menuButtons = document.querySelectorAll('.forum-modern .forum-ellipsis-btn');

            const closeAllMenus = function () {
                document.querySelectorAll('.forum-modern .dropdown-menu.show').forEach(function (menu) {
                    menu.classList.remove('show');
                });
                document.querySelectorAll('.forum-modern .forum-ellipsis-btn[aria-expanded="true"]').forEach(function (btn) {
                    btn.setAttribute('aria-expanded', 'false');
                });
            };

            menuButtons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const dropdown = button.closest('.dropdown');
                    const menu = dropdown ? dropdown.querySelector('.dropdown-menu') : null;
                    const isOpen = menu && menu.classList.contains('show');
                    closeAllMenus();
                    if (menu && !isOpen) {
                        menu.classList.add('show');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            document.querySelectorAll('.forum-modern .dropdown-menu').forEach(function (menu) {
                menu.addEventListener('click', function (event) {
                    event.stopPropagation();
                });
            });

            document.addEventListener('click', function () {
                closeAllMenus();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllMenus();
                }
            });

            document.querySelectorAll('.forum-summary-toggle').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    const targetId = button.getAttribute('data-summary-target');
                    const panel = targetId ? document.getElementById(targetId) : null;
                    if (!panel) {
                        return;
                    }

                    const isOpen = panel.classList.toggle('is-open');
                    button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    button.classList.toggle('active', isOpen);
                    button.innerHTML = isOpen
                        ? '<i class="fas fa-chevron-up me-2"></i>Masquer le resume'
                        : '<i class="fas fa-chevron-down me-2"></i>Afficher le resume';

                    if (isOpen) {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                });
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="dashboard-content forum-modern forum-page forum-detail-page">
    <section class="forum-topic-hero mb-4">
        <div class="forum-topic-header-stack">
            <span class="forum-topic-label">SUJET</span>
            <h1 class="forum-topic-heading forum-title-emphasis">{{ topic.title }}</h1>
            <p class="forum-topic-submeta mb-0">
                Discussion ouverte par {{ topic.author.prenom }} {{ topic.author.nom }}
                {% if topic.author and 'ROLE_ADMIN' in topic.author.roles %}
                    <span class="badge bg-dark ms-1">Admin</span>
                {% endif %}
            </p>

            <div class="d-flex flex-wrap gap-2 forum-topic-actions">
                <a href="{{ path('app_admin_forum_index') }}" class="btn btn-outline-secondary forum-btn-back forum-btn-back-spacing">
                    <i class="fas fa-arrow-left me-2"></i>Retour
                </a>
                <a href="{{ path('app_admin_forum_edit', {id: topic.id}) }}" class="btn btn-outline-secondary">Modifier</a>
                <button type="button" class="btn btn-outline-secondary forum-summary-toggle active" data-summary-target="topic-summary-panel-admin" aria-expanded="true">
                    <i class="fas fa-chevron-up me-2"></i>Masquer le resume
                </button>
                <a href="{{ path('app_chat_resume', {topicId: topic.id}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-robot me-2"></i>{{ topic.isVideoType ? 'Resumer la video' : 'Chatbot resume' }}
                </a>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light forum-ellipsis-btn" type="button" aria-expanded="false">...</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form method="post" action="{{ path('app_admin_forum_report_topic', {id: topic.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('report_topic_' ~ topic.id) }}">
                                <input type="hidden" name="reason" value="Sujet signale par administrateur">
                                <button type="submit" class="dropdown-item">Signaler</button>
                            </form>
                        </li>
                        <li>
                            <form method="post" action="{{ path('app_admin_forum_hide', {id: topic.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('hide_topic_' ~ topic.id) }}">
                                <button type="submit" class="dropdown-item">Masquer</button>
                            </form>
                        </li>
                        <li>
                            <form method="post" action="{{ path('app_admin_forum_delete', {id: topic.id}) }}" onsubmit="return confirm('Supprimer ce sujet ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                                <button type="submit" class="dropdown-item text-danger">Supprimer</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="forum-topic-badges forum-topic-badges-spaced mt-3">
            <span class="forum-meta-badge">
                <i class="fas fa-user-circle"></i>{{ topic.author.prenom }} {{ topic.author.nom }}
                {% if topic.author and 'ROLE_ADMIN' in topic.author.roles %}
                    <span class="badge bg-dark ms-1">Admin</span>
                {% endif %}
            </span>
            <span class="forum-meta-badge"><i class="fas fa-clock"></i>{{ topic.createdAt|date('d/m/Y H:i') }}</span>
            <span class="forum-meta-badge"><i class="fas fa-comments"></i>{{ visible_comments_count }} commentaires</span>
            {% if topic.isVideoType %}
                <span class="forum-meta-badge"><i class="fas fa-play-circle"></i>Video medicale</span>
            {% endif %}
            {% if topic.isReported %}
                <span class="forum-meta-badge" style="background:#fff0f0;color:#b03a3a;border-color:#f5c2c2;">
                    <i class="fas fa-flag"></i>Signale
                </span>
            {% endif %}
            {% if topic.isHidden %}
                <span class="forum-meta-badge" style="background:#f5f5f5;color:#6a6a6a;border-color:#d9d9d9;">
                    Masque
                </span>
            {% endif %}
        </div>

        {% if topic.tags is not empty %}
            <div class="d-flex flex-wrap gap-2 mt-3">
                {% for tag in topic.tags %}
                    <span class="tag-badge">{{ tag }}</span>
                {% endfor %}
            </div>
        {% endif %}

        <div class="forum-reaction-bar forum-reaction-bar-spaced mt-3">
            <form method="post" action="{{ path('app_user_forum_react', {id: topic.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('react_topic_' ~ topic.id) }}">
                <input type="hidden" name="type" value="like">
                <button type="submit" class="forum-react-btn {{ user_reaction == 'like' ? 'active' : '' }}">
                    👍 J'aime <span class="count">{{ reaction_counts.like }}</span>
                </button>
            </form>
            <form method="post" action="{{ path('app_user_forum_react', {id: topic.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('react_topic_' ~ topic.id) }}">
                <input type="hidden" name="type" value="love">
                <button type="submit" class="forum-react-btn love {{ user_reaction == 'love' ? 'active' : '' }}">
                    ❤️ J'adore <span class="count">{{ reaction_counts.love }}</span>
                </button>
            </form>
            {% if user_reaction %}
                <span class="badge bg-dark-subtle text-dark ms-2">Reaction admin</span>
            {% endif %}
        </div>
    </section>

    <article class="forum-topic-main mb-4">
        {% include 'dashboard/forum/_video_player.html.twig' with {topic: topic} %}
        <p class="forum-topic-main-content">{{ topic.content|nl2br }}</p>
    </article>

    <section class="forum-ai-summary-panel is-open mb-4" id="topic-summary-panel-admin">
        <div class="forum-ai-summary-head">
            <span class="forum-ai-chip"><i class="fas fa-sparkles"></i>IA</span>
            <strong>Resume intelligent</strong>
        </div>
        <p class="forum-topic-main-content mt-2 mb-0 forum-ai-summary-text">
            {{ topic.summary ?: 'Le resume n\'est pas encore disponible pour ce sujet.' }}
        </p>
    </section>

    <section class="forum-comments mb-4">
        <div class="forum-section-head forum-section-head-modern">
            <h2 class="h4 mb-0 forum-section-title">
                <i class="fas fa-lightbulb forum-heading-icon"></i>
                <span class="forum-heading-text">Sujets recommandes pour vous</span>
            </h2>
            <span class="forum-pill">IA</span>
        </div>

        {% if recommended_topics is empty %}
            <div class="forum-empty-sm mt-3">Aucune recommandation disponible pour le moment.</div>
        {% else %}
            <p class="text-muted mt-2 mb-3">
                {{ recommendations_fallback ? 'Sujets populaires cette semaine.' : 'Recommande car similaire a ce sujet.' }}
            </p>
            <div class="forum-topic-grid forum-showcase-grid">
                {% for item in recommended_topics %}
                    {% set recommended = item.topic %}
                    <article class="forum-topic-card forum-showcase-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="forum-meta-badge"><i class="fas fa-robot"></i>IA</span>
                            {% if not item.is_fallback %}
                                <span class="forum-meta-badge">Score {{ item.score }}</span>
                            {% endif %}
                        </div>
                        <h3 class="forum-showcase-title mb-2">
                            <a href="{{ path('app_admin_forum_show', {id: recommended.id}) }}" class="text-decoration-none">{{ recommended.title }}</a>
                        </h3>
                        <p class="forum-showcase-excerpt mb-2">
                            {{ recommended.content|striptags|slice(0, 120) }}{% if recommended.content|length > 120 %}...{% endif %}
                        </p>
                        <p class="forum-showcase-date mb-2">
                            {{ recommended.createdAt|date('d/m/Y H:i') }}
                        </p>
                        <a href="{{ path('app_admin_forum_show', {id: recommended.id}) }}" class="btn btn-sm btn-outline-secondary">Voir le sujet</a>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="forum-comments mb-4">
        <div class="forum-section-head forum-section-head-modern">
            <h2 class="h4 mb-0 forum-section-title">
                <i class="fas fa-comments forum-heading-icon"></i>
                <span class="forum-heading-text">Commentaires</span>
            </h2>
            <span class="forum-pill">{{ visible_comments_count }}</span>
        </div>

        {% if (comment_tree[0] ?? []) is empty %}
            <div class="forum-empty-sm mt-3">Aucun commentaire pour le moment.</div>
        {% else %}
            <div class="forum-comments-list mt-3 forum-thread">
                {% for comment in comment_tree[0] ?? [] %}
                    {% include 'dashboard/forum/_comment_item.html.twig' with {
                        topic: topic,
                        comment: comment,
                        comment_tree: comment_tree,
                        comment_reaction_counts: comment_reaction_counts,
                        comment_user_reaction_map: comment_user_reaction_map,
                        level: 0
                    } only %}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="forum-reply-box forum-reply-box-modern">
        <div class="forum-reply-head">
            <div class="forum-reply-head-icon">
                <i class="fas fa-comment-medical"></i>
            </div>
            <div>
                <h2 class="h5 mb-1 forum-section-title">
                    <i class="fas fa-pen-nib forum-heading-icon"></i>
                    <span class="forum-heading-text">Ajouter un commentaire</span>
                </h2>
                <p class="mb-0 text-muted">Partagez une reponse claire et utile.</p>
            </div>
        </div>
        <div class="mt-3" id="comment-form">
            {{ form_start(form, {'attr': {'class': 'forum-reply-form'}}) }}
                <input type="hidden" name="parent_id" value="{{ reply_parent ? reply_parent.id : 0 }}">
                {% if reply_parent %}
                    <div class="forum-reply-target mb-2">
                        Reponse a <strong>{{ reply_parent.author.prenom }} {{ reply_parent.author.nom }}</strong>
                        <a href="{{ path('app_admin_forum_show', {id: topic.id}) }}#comment-form" class="ms-2">Annuler</a>
                    </div>
                {% endif %}
                <div class="forum-field-shell forum-field-shell-lg">
                    <span class="forum-field-icon"><i class="fas fa-pen"></i></span>
                    {{ form_widget(form.content, {
                        'attr': {
                            'rows': 4,
                            'class': 'form-control forum-textarea forum-input-neo forum-textarea-neo forum-reply-textarea',
                            'placeholder': 'Votre avis compte: ecrivez un commentaire utile et precis...'
                        }
                    }) }}
                </div>
                <div class="forum-field-errors">{{ form_errors(form.content) }}</div>

                <div class="forum-reply-actions">
                    <button type="submit" class="btn btn-primary forum-btn-publish">
                        <i class="fas fa-paper-plane me-2"></i>Publier
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}
