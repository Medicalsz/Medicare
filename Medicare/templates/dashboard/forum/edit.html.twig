{% extends 'dashboard_base.html.twig' %}

{% block title %}Modifier le sujet - Medicare{% endblock %}

{% block body %}
<div class="dashboard-content">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">Modifier le sujet</h1>
            <p class="page-subtitle text-muted">Mettez à jour votre publication.</p>
        </div>
        <a href="{{ path('dashboard_forum') }}" class="btn btn-outline-secondary">
            ← Retour au forum
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': ''}}) }}
                {{ form_row(form.title, {
                    'label': 'Titre',
                    'attr': {'placeholder': 'Sujet clair et précis...', 'required': true}
                }) }}
                {{ form_row(form.content, {
                    'label': 'Contenu',
                    'attr': {'rows': 10, 'placeholder': 'Modifiez votre message ici...', 'required': true}
                }) }}

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a href="{{ path('forum_show', {id: topic.id}) }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary">Mettre à jour</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}