{% extends 'dashboard_base.html.twig' %}

{% block title %}Forum - Medicare{% endblock %}

{% block body %}
<div class="dashboard-content">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">Forum</h1>
            <p class="page-subtitle text-muted">Échangez avec la communauté Medicare</p>
        </div>
        <a href="{{ path('forum_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Nouveau sujet
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h3 class="card-title mb-0">Tous les sujets</h3>
        </div>
        <div class="card-body p-0">
            {% if topics is empty %}
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-comments fa-3x mb-3 opacity-50"></i>
                    <p>Aucun sujet pour le moment.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0 forum-table">
                        <thead class="table-light">
                            <tr>
                                <th>Titre</th>
                                <th>Auteur</th>
                                <th>Créé le</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for topic in topics %}
                            <tr>
                                <td class="fw-medium">{{ topic.title }}</td>
                                <td>{{ topic.author.prenom }} {{ topic.author.nom }}</td>
                                <td>{{ topic.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('forum_show', {id: topic.id}) }}" class="btn btn-outline-primary">Voir</a>
                                        <a href="{{ path('forum_edit', {id: topic.id}) }}" class="btn btn-outline-secondary">Modifier</a>
                                        <form method="post" action="{{ path('forum_delete', {id: topic.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce sujet ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                                            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}