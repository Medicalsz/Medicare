{% extends 'admin_base.html.twig' %}

{% block title %}Forum - Medicare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/forum-modern.css') }}?v=20260221-2">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const menuButtons = document.querySelectorAll('.forum-modern .forum-ellipsis-btn');

            const closeAllMenus = function () {
                document.querySelectorAll('.forum-modern .dropdown-menu.show').forEach(function (menu) {
                    menu.classList.remove('show');
                });
            };

            menuButtons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const menu = button.parentElement.querySelector('.dropdown-menu');
                    const isOpen = menu && menu.classList.contains('show');
                    closeAllMenus();
                    if (menu && !isOpen) {
                        menu.classList.add('show');
                    }
                });
            });

            document.addEventListener('click', function () {
                closeAllMenus();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllMenus();
                }
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="dashboard-content forum-modern forum-page">
    <div class="forum-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <p class="forum-kicker mb-1">Forum Medicare</p>
            <h1 class="page-title mb-2">Discussions de la communaute</h1>
            <p class="page-subtitle mb-0">Posez une question, partagez une experience, aidez les autres.</p>
        </div>
        <a href="{{ path('app_admin_forum_new') }}" class="btn btn-primary forum-cta">
            <i class="fas fa-plus me-2"></i>Nouveau sujet
        </a>
    </div>
    <div class="forum-kind-tabs mb-3">
        <a href="{{ path('app_admin_forum_index', {kind: 'article'}) }}" class="forum-kind-tab {{ current_kind == 'article' ? 'active' : '' }}">
            Articles
        </a>
        <a href="{{ path('app_admin_forum_index', {kind: 'video'}) }}" class="forum-kind-tab {{ current_kind == 'video' ? 'active' : '' }}">
            Videos medicales
        </a>
    </div>

    {% if topics is empty %}
        <div class="forum-empty text-center py-5">
            <div class="forum-empty-icon mb-3"><i class="fas fa-comments"></i></div>
            <h2 class="h4 mb-2">Aucun sujet pour le moment</h2>
            <p class="text-muted mb-4">Demarrez la premiere discussion de la communaute.</p>
            <a href="{{ path('app_admin_forum_new') }}" class="btn btn-primary">Creer un sujet</a>
        </div>
    {% else %}
        <div class="forum-topic-grid forum-showcase-grid">
            {% for topic in topics %}
                {% set commentsCount = topic.comments|length %}
                {% set latestComment = commentsCount > 0 ? (topic.comments|last) : null %}
                {% set viewsCount = topic.content|length + (commentsCount * 17) %}
                <article class="forum-topic-card forum-showcase-card">
                    <div class="forum-topic-card-menu dropdown">
                        <button class="btn btn-sm btn-light forum-ellipsis-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">...</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" action="{{ path('app_admin_forum_report_topic', {id: topic.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('report_topic_' ~ topic.id) }}">
                                    <input type="hidden" name="reason" value="Sujet signale par administrateur">
                                    <button type="submit" class="dropdown-item">Signaler</button>
                                </form>
                            </li>
                            <li>
                                <form method="post" action="{{ path('app_admin_forum_hide', {id: topic.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('hide_topic_' ~ topic.id) }}">
                                    <button type="submit" class="dropdown-item">Masquer</button>
                                </form>
                            </li>
                            <li>
                                <form method="post" action="{{ path('app_admin_forum_delete', {id: topic.id}) }}" onsubmit="return confirm('Supprimer ce sujet ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_topic_' ~ topic.id) }}">
                                    <button type="submit" class="dropdown-item text-danger">Supprimer</button>
                                </form>
                            </li>
                        </ul>
                    </div>

                    <h3 class="forum-showcase-title">
                        {{ topic.title|slice(0, 56) }}{% if topic.title|length > 56 %}...{% endif %}
                    </h3>
                    {% if topic.isVideoType %}
                        <span class="forum-kind-badge mb-2"><i class="fas fa-play-circle me-1"></i>Video medicale</span>
                        {% include 'dashboard/forum/_video_player.html.twig' with {topic: topic} %}
                    {% endif %}

                    <p class="forum-showcase-excerpt">
                        {% set preview = topic.summary ?: topic.content %}
                        {{ preview|striptags|slice(0, 120) }}{% if preview|length > 120 %}...{% endif %}
                    </p>

                    <p class="forum-showcase-date">
                        Dernier commentaire : {{ (latestComment ? latestComment.createdAt : topic.createdAt)|date('d/m/Y') }}
                    </p>
                    {% if topic.isHidden %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis mb-2">Masque</span>
                    {% endif %}

                    <div class="forum-showcase-avatars">
                        {% set shown = 0 %}
                        {% for comment in topic.comments|reverse %}
                            {% if shown < 3 %}
                                <span class="forum-avatar-mini" title="{{ comment.author.prenom }} {{ comment.author.nom }}">
                                    {{ (comment.author.prenom|first ~ comment.author.nom|first)|upper }}
                                </span>
                                {% set shown = shown + 1 %}
                            {% endif %}
                        {% endfor %}
                        {% if shown == 0 %}
                            <span class="forum-avatar-mini" title="{{ topic.author.prenom }} {{ topic.author.nom }}">
                                {{ (topic.author.prenom|first ~ topic.author.nom|first)|upper }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="forum-showcase-footer">
                        <div class="forum-showcase-metrics">
                            <span><i class="bi bi-eye-fill"></i>{{ viewsCount }}</span>
                            <span><i class="bi bi-chat-left-text-fill"></i>{{ commentsCount }}</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_admin_forum_show', {id: topic.id}) }}" class="btn btn-sm btn-outline-secondary forum-btn-back">
                                <i class="bi bi-eye-fill me-2"></i>Voir
                            </a>
                            <a href="{{ path('app_admin_forum_show', {id: topic.id}) }}" class="btn forum-comment-btn">
                                <i class="bi bi-reply-fill me-2"></i>Commenter
                            </a>
                        </div>
                    </div>

                    <div class="forum-admin-row">
                        <a href="{{ path('app_admin_forum_edit', {id: topic.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}


