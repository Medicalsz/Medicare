{% use 'form_div_layout.html.twig' %}

{% block form_start %}
    {% set attr = attr|merge({'novalidate': 'novalidate'}) %}
    {{ parent() }}
{% endblock %}

{% block form_row %}
    {% set rowClass = row_attr.class|default('') %}
    {% set row_attr = row_attr|merge({'class': (rowClass ~ ' mb-3')|trim}) %}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="invalid-feedback d-block error-text">
            {% for error in errors %}
                <div>{{ error.message }}</div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {% set classes = attr.class|default('') %}
    {% if errors|length > 0 %}
        {% set classes = (classes ~ ' is-invalid')|trim %}
    {% endif %}
    {% set attr = attr|merge({'class': classes}) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set classes = attr.class|default('') %}
    {% if errors|length > 0 %}
        {% set classes = (classes ~ ' is-invalid')|trim %}
    {% endif %}
    {% set attr = attr|merge({'class': classes}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set classes = attr.class|default('') %}
    {% if errors|length > 0 %}
        {% set classes = (classes ~ ' is-invalid')|trim %}
    {% endif %}
    {% set attr = attr|merge({'class': classes}) %}
    {{ parent() }}
{% endblock %}
