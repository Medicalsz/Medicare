<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Medicare - Gestion de rendez-vous en ligne{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏥</text></svg>">
        
        {# Bootstrap CSS #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        {# Font Awesome pour les icônes #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        {# Google Fonts #}
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        {# Global CSS #}
        <link rel="stylesheet" href="/css/global.css">
        
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {# Bootstrap JS #}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            
            <script>
                // Effet scroll sur la navbar
                window.addEventListener('scroll', function() {
                    const navbar = document.querySelector('.navbar-medicare');
                    if (window.scrollY > 50) {
                        navbar.classList.add('scrolled');
                    } else {
                        navbar.classList.remove('scrolled');
                    }
                });
            </script>
        {% endblock %}
    </head>
    <body>
        {# Navigation Bar Component #}
        {% include 'components/navbar/navbar.html.twig' %}
        
        {# Main Content #}
        <main>
            {% block body %}{% endblock %}
        </main>
        
        {# Footer Component #}
        {% include 'components/footer/footer.html.twig' %}
        
        {# Scroll to Top Button #}
        <button id="scrollToTop" class="scroll-to-top" title="Retour en haut">
            <i class="fas fa-chevron-up"></i>
        </button>
        
        <style>
            .scroll-to-top {
                position: fixed;
                right: 30px;
                bottom: 30px;
                width: 50px;
                height: 50px;
                background: linear-gradient(135deg, #56CCF2 0%, #2F80ED 100%);
                color: white;
                border: none;
                border-radius: 50%;
                font-size: 1.2rem;
                cursor: pointer;
                box-shadow: 0 5px 20px rgba(47, 128, 237, 0.4);
                opacity: 0;
                visibility: hidden;
                transition: all 0.3s ease;
                z-index: 1000;
            }
            
            .scroll-to-top.show {
                opacity: 1;
                visibility: visible;
            }
            
            .scroll-to-top:hover {
                transform: translateY(-5px) scale(1.1);
                box-shadow: 0 8px 30px rgba(47, 128, 237, 0.6);
            }
            
            @media (max-width: 768px) {
                .scroll-to-top {
                    right: 20px;
                    bottom: 20px;
                    width: 45px;
                    height: 45px;
                    font-size: 1rem;
                }
            }
        </style>
        
        <script>
            // Scroll to Top Button
            const scrollToTopBtn = document.getElementById('scrollToTop');
            
            window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                    scrollToTopBtn.classList.add('show');
                } else {
                    scrollToTopBtn.classList.remove('show');
                }
            });
            
            scrollToTopBtn.addEventListener('click', function() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        </script>
    </body>
</html>
