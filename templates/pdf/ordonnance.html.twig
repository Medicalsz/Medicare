<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Ordonnance #{{ consultation.id }}</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            color: #0f172a;
            font-size: 13px;
            margin: 0;
            padding: 28px 30px;
            background: #ffffff;
        }

        .sheet {
            border: 2px solid #0ea5e9;
            border-radius: 14px;
            padding: 18px 18px 16px;
        }

        .top {
            display: table;
            width: 100%;
            margin-bottom: 14px;
        }

        .left, .right {
            display: table-cell;
            vertical-align: top;
            width: 50%;
        }

        .right {
            text-align: right;
        }

        .brand {
            font-size: 18px;
            font-weight: 800;
            color: #0369a1;
        }

        .subtitle {
            margin-top: 3px;
            color: #475569;
            font-size: 12px;
        }

        .doc {
            margin-top: 10px;
            background: #f8fbff;
            border: 1px solid #dbeafe;
            border-radius: 10px;
            padding: 10px 11px;
        }

        .doc-line {
            margin-bottom: 3px;
        }

        .section-title {
            margin: 18px 0 7px;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #0369a1;
        }

        .box {
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 10px 11px;
            line-height: 1.5;
            white-space: pre-line;
            background: #ffffff;
        }

        .signature {
            margin-top: 24px;
            text-align: right;
            font-size: 12px;
            color: #475569;
        }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="top">
            <div class="left">
                <div class="brand">MEDICARE</div>
                <div class="subtitle">Ordonnance medicale</div>
            </div>
            <div class="right">
                <strong>Date d edition:</strong> {{ generatedAt|date('d/m/Y H:i') }}<br>
                <strong>Document:</strong> #{{ consultation.id }}
            </div>
        </div>

        <div class="doc">
            <div class="doc-line"><strong>Medecin:</strong> Dr {{ consultation.medecin.user.prenom }} {{ consultation.medecin.user.nom }}</div>
            <div class="doc-line"><strong>Specialite:</strong> {{ consultation.medecin.specialite }}</div>
            <div class="doc-line"><strong>Cabinet:</strong> {{ consultation.medecin.cabinet ?: '-' }}</div>
            <div class="doc-line"><strong>Patient:</strong> {{ consultation.patient.user.prenom }} {{ consultation.patient.user.nom }}</div>
            <div class="doc-line"><strong>Date consultation:</strong> {{ consultation.dateConsultation|date('d/m/Y H:i') }}</div>
        </div>

        <div class="section-title">Compte rendu</div>
        <div class="box">{{ consultation.description }}</div>

        <div class="section-title">Prescription</div>
        <div class="box">{{ consultation.ordonnance ?: '-' }}</div>

        <div class="signature">
            Signature medecin<br>
            Dr {{ consultation.medecin.user.prenom }} {{ consultation.medecin.user.nom }}
        </div>
    </div>
</body>
</html>
