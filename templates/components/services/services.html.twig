{# Services Component #}
<link rel="stylesheet" href="/css/components/services.css">

<section class="services-section" id="services">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <span class="section-subtitle">NOS SERVICES</span>
            <h2 class="section-title">Des soins de qualité pour tous</h2>
            <p class="section-description">
                Découvrez nos services médicaux complets adaptés à tous vos besoins de santé
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-video"></i>
                    </div>
                    <h3 class="service-title">Consultation en ligne</h3>
                    <p class="service-description">
                        Consultez nos médecins par vidéoconférence depuis chez vous, en toute sécurité et confidentialité.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> Disponible 24/7</li>
                        <li><i class="fas fa-check"></i> Réponse rapide</li>
                        <li><i class="fas fa-check"></i> Ordonnance électronique</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3 class="service-title">Prise de rendez-vous</h3>
                    <p class="service-description">
                        Réservez facilement un créneau avec le médecin de votre choix en quelques clics seulement.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> Réservation simple</li>
                        <li><i class="fas fa-check"></i> Rappels automatiques</li>
                        <li><i class="fas fa-check"></i> Annulation gratuite</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-ambulance"></i>
                    </div>
                    <h3 class="service-title">Urgences médicales</h3>
                    <p class="service-description">
                        Service d'urgence disponible 24h/24 pour répondre à vos besoins médicaux immédiats.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> Intervention rapide</li>
                        <li><i class="fas fa-check"></i> Équipe qualifiée</li>
                        <li><i class="fas fa-check"></i> Suivi assuré</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <h3 class="service-title">Suivi médical</h3>
                    <p class="service-description">
                        Un suivi personnalisé de votre état de santé avec historique complet de vos consultations.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> Dossier médical</li>
                        <li><i class="fas fa-check"></i> Historique complet</li>
                        <li><i class="fas fa-check"></i> Alertes santé</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="500">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-pills"></i>
                    </div>
                    <h3 class="service-title">Pharmacie en ligne</h3>
                    <p class="service-description">
                        Commandez vos médicaments en ligne avec livraison rapide et sécurisée à domicile.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> Livraison rapide</li>
                        <li><i class="fas fa-check"></i> Prix compétitifs</li>
                        <li><i class="fas fa-check"></i> Conseils gratuits</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="600">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-file-medical"></i>
                    </div>
                    <h3 class="service-title">Analyses médicales</h3>
                    <p class="service-description">
                        Analyses et examens médicaux avec résultats accessibles en ligne en toute confidentialité.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> Résultats en ligne</li>
                        <li><i class="fas fa-check"></i> Confidentialité</li>
                        <li><i class="fas fa-check"></i> Sans RDV</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
