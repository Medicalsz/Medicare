{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Partenaires{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Nos Partenaires</h1>
            <p class="text-muted small mb-0">Gérez les relations avec vos partenaires de santé</p>
        </div>
        <a href="{{ path('app_partner_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Nouveau Partenaire
        </a>
    </div>

    <form method="get" class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label class="form-label small text-muted mb-1">Recherche</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input name="q" value="{{ q|default('') }}" class="form-control" placeholder="Nom, email, téléphone, adresse…">
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small text-muted mb-1">Statut</label>
                    <select name="status" class="form-select">
                        <option value="">Tous</option>
                        <option value="ACTIF" {% if status|default('') == 'ACTIF' %}selected{% endif %}>ACTIF</option>
                        <option value="SUSPENDU" {% if status|default('') == 'SUSPENDU' %}selected{% endif %}>SUSPENDU</option>
                        <option value="INACTIF" {% if status|default('') == 'INACTIF' %}selected{% endif %}>INACTIF</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label class="form-label small text-muted mb-1">Trier par</label>
                    <select name="sort" class="form-select">
                        <option value="newest" {% if sort|default('newest') == 'newest' %}selected{% endif %}>Plus récent</option>
                        <option value="oldest" {% if sort|default('') == 'oldest' %}selected{% endif %}>Plus ancien</option>
                        <option value="name" {% if sort|default('') == 'name' %}selected{% endif %}>Nom</option>
                        <option value="date" {% if sort|default('') == 'date' %}selected{% endif %}>Date partenariat</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-flex gap-2">
                    <input type="hidden" name="dir" value="{{ dir|default('desc') }}">
                    <button class="btn btn-primary w-100"><i class="bi bi-funnel me-2"></i>Appliquer</button>
                    <a class="btn btn-outline-secondary" href="{{ path('app_partner_index') }}" title="Réinitialiser"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </div>
        </div>
    </form>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% if partners is not empty %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            {% for partner in partners %}
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-hover position-relative">
                        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                            <span class="badge 
                                {% if partner.statut.value == 'ACTIF' %}bg-success-subtle text-success
                                {% elseif partner.statut.value == 'SUSPENDU' %}bg-warning-subtle text-warning
                                {% else %}bg-danger-subtle text-danger{% endif %} border-0 px-3 py-2">
                                <i class="bi bi-circle-fill me-1 small"></i>{{ partner.statut.value }}
                            </span>
                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li><a class="dropdown-item" href="{{ path('app_partner_show', {'id': partner.id}) }}"><i class="bi bi-eye me-2"></i>Détails</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_partner_edit', {'id': partner.id}) }}"><i class="bi bi-pencil me-2"></i>Modifier</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_partner_pdf', {'id': partner.id}) }}"><i class="bi bi-file-pdf me-2"></i>Exporter PDF</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        {{ include('partner/_delete_form.html.twig', {'button_class': 'dropdown-item text-danger'}) }}
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-body text-center pt-0">
                            <a href="{{ path('app_partner_show', {'id': partner.id}) }}" class="stretched-link" aria-label="Voir le profil"></a>
                            <div class="mb-3 mx-auto shadow-sm rounded-circle d-flex align-items-center justify-content-center bg-light" style="width: 100px; height: 100px; overflow: hidden;">
                                {% if partner.imageName %}
                                    <img src="{{ vich_uploader_asset(partner, 'imageFile') }}" alt="{{ partner.name }}" class="img-fluid">
                                {% else %}
                                    <i class="bi bi-building text-secondary" style="font-size: 2.5rem;"></i>
                                {% endif %}
                            </div>
                            <h5 class="card-title fw-bold mb-1">{{ partner.name }}</h5>
                            <p class="text-primary small fw-semibold mb-3">
                                {% set icon = 'bi-briefcase' %}
                                {% if partner.typePartenaire.value == 'PHARMACIE' %}{% set icon = 'bi-capsule' %}
                                {% elseif partner.typePartenaire.value == 'LABORATOIRE' %}{% set icon = 'bi-eyedropper' %}
                                {% elseif partner.typePartenaire.value == 'ASSURANCE' %}{% set icon = 'bi-shield-check' %}
                                {% elseif partner.typePartenaire.value == 'CLINIQUE' %}{% set icon = 'bi-hospital' %}{% endif %}
                                <i class="bi {{ icon }} me-1"></i>{{ partner.typePartenaire.value }}
                            </p>
                            
                            <div class="text-start small text-muted bg-light rounded p-3 mb-3">
                                <div class="mb-2"><i class="bi bi-geo-alt me-2"></i>{{ partner.adresse }}</div>
                                <div class="mb-2"><i class="bi bi-telephone me-2"></i>{{ partner.telephone }}</div>
                                <div><i class="bi bi-envelope me-2 text-truncate"></i>{{ partner.email }}</div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3 d-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
                            <small class="text-muted">Partenaire depuis le {{ partner.datePartenariat|date('d/m/Y') }}</small>
                            <div class="d-flex gap-2">
                                <a href="#" class="text-muted qr-trigger"
                                   data-bs-toggle="modal"
                                   data-bs-target="#qrModal"
                                   data-qr-title="Profil partenaire"
                                   data-qr-url="{{ absolute_url(path('app_partner_show', {id: partner.id})) }}"
                                   title="QR Code">
                                    <i class="bi bi-qr-code fs-5"></i>
                                </a>
                                <a href="{{ path('app_partner_pdf', {'id': partner.id}) }}" class="text-muted" title="Exporter PDF">
                                    <i class="bi bi-file-earmark-pdf fs-5"></i>
                                </a>
                                <a href="#" class="text-muted copy-link-trigger" data-copy-url="{{ absolute_url(path('app_partner_show', {id: partner.id})) }}" title="Copier le lien">
                                    <i class="bi bi-link-45deg copy-link-icon fs-5"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-center mt-5">
            {{ knp_pagination_render(partners) }}
        </div>
    {% else %}
        <div class="text-center py-5 shadow-sm bg-white rounded-4">
            <div class="mb-3">
                <i class="bi bi-briefcase text-light-emphasis" style="font-size: 4rem;"></i>
            </div>
            <h3>Aucun partenaire trouvé</h3>
            <p class="text-muted">Commencez par ajouter votre premier partenaire de santé.</p>
            <a href="{{ path('app_partner_new') }}" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-2"></i>Ajouter un partenaire
            </a>
        </div>
    {% endif %}
</div>

<div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="qrModalTitle">QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="small text-muted mb-2" id="qrModalUrlText"></div>
                <div class="d-flex justify-content-center">
                    <img id="qrModalImg" alt="QR Code" style="width: 220px; height: 220px;">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <a class="btn btn-primary" id="qrModalOpenBtn" href="#" target="_blank" rel="noopener">Ouvrir le lien</a>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-warning-subtle { background-color: #fff3cd; }
    .bg-danger-subtle { background-color: #f8d7da; }
</style>
{% endblock %}

{% block custom_js %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.copy-link-trigger').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var url = this.getAttribute('data-copy-url');
                    if (navigator.clipboard && url) {
                        navigator.clipboard.writeText(url).then(function() {
                            var icon = btn.querySelector('.copy-link-icon');
                            if (icon) { icon.classList.replace('bi-link-45deg', 'bi-check'); }
                            setTimeout(function() {
                                if (icon) { icon.classList.replace('bi-check', 'bi-link-45deg'); }
                            }, 2000);
                        });
                    }
                });
            });

            var qrModal = document.getElementById('qrModal');
            if (qrModal) {
                qrModal.addEventListener('show.bs.modal', function (event) {
                    var trigger = event.relatedTarget;
                    if (!trigger) { return; }
                    var url = trigger.getAttribute('data-qr-url') || '';
                    var title = trigger.getAttribute('data-qr-title') || 'QR Code';

                    var titleEl = document.getElementById('qrModalTitle');
                    var urlTextEl = document.getElementById('qrModalUrlText');
                    var imgEl = document.getElementById('qrModalImg');
                    var openBtn = document.getElementById('qrModalOpenBtn');

                    if (titleEl) { titleEl.textContent = title; }
                    if (urlTextEl) { urlTextEl.textContent = url; }
                    if (openBtn) { openBtn.setAttribute('href', url); }
                    if (imgEl) { imgEl.removeAttribute('src'); }

                    if (imgEl && url) {
                        imgEl.alt = 'QR Code';
                        imgEl.style.display = 'block';
                        imgEl.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=10&data=' + encodeURIComponent(url);
                    }
                });
            }
        });
    </script>
{% endblock %}