{% extends 'admin/base.html.twig' %}

{% block title %}Détails Partenaire{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a href="{{ path('app_partner_index') }}" class="btn btn-light border rounded-circle" style="width: 40px; height: 40px; line-height: 1;">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 mb-0 text-gray-800">Partner Profile</h1>
            </div>

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center mb-4 mb-md-0">
                            <div class="bg-light rounded-circle p-2 mx-auto shadow-sm" style="width: 120px; height: 120px;">
                                {% if partner.imageName %}
                                    <img src="{{ vich_uploader_asset(partner, 'imageFile') }}" alt="{{ partner.name }}" class="img-fluid rounded-circle w-100 h-100 object-fit-cover">
                                {% else %}
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-white rounded-circle border">
                                        <i class="bi bi-building fs-1 text-secondary"></i>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h2 class="h4 mb-1 fw-bold">{{ partner.name }}</h2>
                            <span class="badge bg-primary-soft text-primary rounded-pill fs-6 px-3 py-2 mb-3 d-inline-block">
                                {{ partner.typePartenaire.value }}
                            </span>
                            <div class="d-flex align-items-center">
                                {% set average_rating = partner.getAverageRating() %}
                                {% if average_rating is not null %}
                                    <div class="star-rating me-2" title="{{ average_rating|round(1) }} out of 5 stars">
                                        {% for i in 1..5 %}
                                            <i class="bi bi-star{% if i <= average_rating %}-fill{% endif %}"></i>
                                        {% endfor %}
                                    </div>
                                    <span class="fw-bold text-dark">{{ average_rating|round(1) }} / 5</span>
                                {% else %}
                                    <span class="text-muted">No ratings yet</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <div class="d-flex justify-content-center justify-content-md-end gap-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm px-3"
                                        data-bs-toggle="modal"
                                        data-bs-target="#qrModal"
                                        data-qr-title="Profil partenaire"
                                        data-qr-url="{{ absolute_url(path('app_partner_show', {id: partner.id})) }}">
                                    <i class="bi bi-qr-code me-1"></i>QR
                                </button>
                                <a href="{{ path('app_partner_pdf', {'id': partner.id}) }}" class="btn btn-outline-danger btn-sm px-3">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                </a>
                                <a href="{{ path('app_partner_edit', {'id': partner.id}) }}" class="btn btn-outline-primary btn-sm px-3">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                {{ include('partner/_delete_form.html.twig', {'button_class': 'btn btn-outline-danger btn-sm px-3'}) }}
                            </div>
                        </div>
                    </div>
                    <hr class="my-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex">
                                <div class="feature-icon bg-light text-primary rounded-3 p-3 me-3">
                                    <i class="bi bi-geo-alt fs-5"></i>
                                </div>
                                <div>
                                    <label class="text-muted small text-uppercase fw-bold">Address</label>
                                    <p class="mb-0 fw-medium">{{ partner.adresse }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex">
                                <div class="feature-icon bg-light text-primary rounded-3 p-3 me-3">
                                    <i class="bi bi-telephone fs-5"></i>
                                </div>
                                <div>
                                    <label class="text-muted small text-uppercase fw-bold">Phone</label>
                                    <p class="mb-0 fw-medium">{{ partner.telephone }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex">
                                <div class="feature-icon bg-light text-primary rounded-3 p-3 me-3">
                                    <i class="bi bi-envelope fs-5"></i>
                                </div>
                                <div>
                                    <label class="text-muted small text-uppercase fw-bold">Email</label>
                                    <p class="mb-0 fw-medium">{{ partner.email }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex">
                                <div class="feature-icon bg-light text-primary rounded-3 p-3 me-3">
                                    <i class="bi bi-calendar-check fs-5"></i>
                                </div>
                                <div>
                                    <label class="text-muted small text-uppercase fw-bold">Partner Since</label>
                                    <p class="mb-0 fw-medium">{{ partner.datePartenariat|date('d F Y') }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                     <hr class="my-4">
                     <div class="d-flex align-items-center">
                        <span class="text-muted me-3">Status:</span>
                        <span class="badge 
                            {% if partner.statut.value == 'ACTIF' %}bg-success-soft text-success
                            {% elseif partner.statut.value == 'SUSPENDU' %}bg-warning-soft text-warning
                            {% else %}bg-danger-soft text-danger{% endif %} fs-6 px-3 py-2">
                            {{ partner.statut.value }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4 mb-4">
                        <div class="card-header bg-white border-0 py-3">
                            <h3 class="h6 mb-0 text-gray-800">Rate this Partner</h3>
                        </div>
                        <div class="card-body p-4">
                            {% if is_granted('ROLE_USER') %}
                                {{ form_start(rating_form, {'attr': {'class': 'rating-form'}}) }}
                                <div class="mb-3 text-center">
                                    <label class="form-label fs-6 mb-3">{{ form_label(rating_form.rating) }}</label>
                                    <div class="rating-stars justify-content-center">
                                        {{ form_widget(rating_form.rating) }}
                                    </div>
                                    <div class="text-danger mt-2">
                                        {{ form_errors(rating_form.rating) }}
                                    </div>
                                </div>
                                <div class="mb-3">
                                    {{ form_label(rating_form.comment, 'Feedback', {'label_attr': {'class': 'form-label fs-6'}}) }}
                                    {{ form_widget(rating_form.comment, {
                                        'attr': {'placeholder': 'Share your experience...', 'rows': 4}
                                    }) }}
                                    <div class="text-danger mt-2">
                                        {{ form_errors(rating_form.comment) }}
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">Submit Rating</button>
                                {{ form_end(rating_form) }}
                            {% else %}
                                <p class="text-muted text-center mb-0">
                                    You must be <a href="{{ path('app_login') }}">logged in</a> to rate this partner.
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4 mb-4">
                        <div class="card-header bg-white border-0 py-3">
                            <h3 class="h6 mb-0 text-gray-800">AI-Powered Suggestions</h3>
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted">Click to generate creative collaboration ideas for this partner.</p>
                            <button id="suggest-btn" class="btn btn-info text-white w-100">
                                <i class="bi bi-magic me-2"></i>Get Suggestions
                            </button>
                            <div id="loading-spinner" class="mt-4 text-center" style="display: none;">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Generating ideas...</p>
                            </div>
                            <div id="suggestions-container" class="mt-4" style="display: none;">
                                <h4 class="h6">Here are a few ideas:</h4>
                                <ul id="suggestions-list" class="list-group list-group-flush">
                                    <!-- Suggestions will be injected here -->
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="qrModalTitle">QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="small text-muted mb-2" id="qrModalUrlText"></div>
                <div class="d-flex justify-content-center">
                    <img id="qrModalImg" alt="QR Code" style="width: 220px; height: 220px;">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <a class="btn btn-primary" id="qrModalOpenBtn" href="#" target="_blank" rel="noopener">Ouvrir le lien</a>
            </div>
        </div>
    </div>
</div>

<style>
    body { background-color: #f8f9fa; }
    .bg-primary-soft { background-color: rgba(var(--bs-primary-rgb), 0.1); }
    .bg-success-soft { background-color: rgba(var(--bs-success-rgb), 0.1); }
    .bg-warning-soft { background-color: rgba(var(--bs-warning-rgb), 0.1); }
    .bg-danger-soft { background-color: rgba(var(--bs-danger-rgb), 0.1); }
    .object-fit-cover { object-fit: cover; }
    .feature-icon { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; }
    
    .star-rating {
        color: #ffc107;
        font-size: 1.2rem;
    }

    .rating-form .rating-stars > div {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
    }
    .rating-form .rating-stars input[type="radio"] {
        display: none;
    }
    .rating-form .rating-stars label {
        font-size: 0; /* Hide original label text */
        color: #e0e0e0;
        cursor: pointer;
        transition: color 0.2s, transform 0.2s;
        padding: 0 0.2em;
    }
    .rating-form .rating-stars label:hover,
    .rating-form .rating-stars label:hover ~ label,
    .rating-form .rating-stars input[type="radio"]:checked ~ label {
        color: #ffc107;
        transform: scale(1.1);
    }
    .rating-form .rating-stars label::before {
        content: '★';
        font-size: 2.5rem;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const qrModal = document.getElementById('qrModal');
    if (qrModal) {
        qrModal.addEventListener('show.bs.modal', function (event) {
            var trigger = event.relatedTarget;
            if (!trigger) { return; }
            var url = trigger.getAttribute('data-qr-url') || '';
            var title = trigger.getAttribute('data-qr-title') || 'QR Code';

            var titleEl = document.getElementById('qrModalTitle');
            var urlTextEl = document.getElementById('qrModalUrlText');
            var imgEl = document.getElementById('qrModalImg');
            var openBtn = document.getElementById('qrModalOpenBtn');

            if (titleEl) { titleEl.textContent = title; }
            if (urlTextEl) { urlTextEl.textContent = url; }
            if (openBtn) { openBtn.setAttribute('href', url); }

            if (imgEl && url) {
                imgEl.alt = 'QR Code';
                imgEl.style.display = 'block';
                imgEl.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=10&data=' + encodeURIComponent(url);
            }
        });
    }

    const suggestBtn = document.getElementById('suggest-btn');
    const suggestionsContainer = document.getElementById('suggestions-container');
    const suggestionsList = document.getElementById('suggestions-list');
    const loadingSpinner = document.getElementById('loading-spinner');
    const partnerId = {{ partner.id }};

    suggestBtn.addEventListener('click', function () {
        // Show spinner and hide previous suggestions
        loadingSpinner.style.display = 'block';
        suggestionsContainer.style.display = 'none';
        suggestionsList.innerHTML = '';
        suggestBtn.disabled = true;

        fetch(`/api/partners/${partnerId}/suggest-collaboration`, {
            method: 'POST',
        })
        .then(response => response.json())
        .then(data => {
            loadingSpinner.style.display = 'none';
            suggestionsContainer.style.display = 'block';
            suggestBtn.disabled = false;

            if (data && data.error) {
                const errorItem = document.createElement('li');
                errorItem.className = 'list-group-item text-danger';
                errorItem.textContent = data.error;
                suggestionsList.appendChild(errorItem);
                return;
            }

            if (data && Array.isArray(data.suggestions) && data.suggestions.length > 0) {
                data.suggestions.forEach(suggestion => {
                    const listItem = document.createElement('li');
                    listItem.className = 'list-group-item';
                    listItem.textContent = suggestion;
                    suggestionsList.appendChild(listItem);
                });
                return;
            }

            const noSuggestionItem = document.createElement('li');
            noSuggestionItem.className = 'list-group-item text-muted';
            noSuggestionItem.textContent = 'Aucune suggestion disponible pour le moment.';
            suggestionsList.appendChild(noSuggestionItem);
        })
        .catch(error => {
            console.error('Error fetching AI suggestions:', error);
            loadingSpinner.style.display = 'none';
            suggestionsContainer.style.display = 'block';
            suggestBtn.disabled = false;

            const errorItem = document.createElement('li');
            errorItem.className = 'list-group-item text-danger';
            errorItem.textContent = 'An error occurred while trying to get suggestions.';
            suggestionsList.appendChild(errorItem);
        });
    });
});
</script>
{% endblock %}