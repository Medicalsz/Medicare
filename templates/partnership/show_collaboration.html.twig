{% extends 'base.html.twig' %}

{% block title %}{{ collaboration.titre }} - Medicare{% endblock %}

{% block stylesheets %}
  <style>
    .collab-detail-header {
      padding: 120px 0 60px 0;
      background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), 
                  {% if collaboration.imageName %}url('{{ vich_uploader_asset(collaboration, 'imageFile') }}'){% else %}url('{{ asset('assets/img/health/facilities-1.webp') }}'){% endif %};
      background-size: cover;
      background-position: center;
      color: white;
      text-align: center;
    }

    .collab-container {
      background: white;
      border-radius: 30px;
      margin-top: -50px;
      padding: 50px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.1);
      position: relative;
      z-index: 10;
    }

    .collab-meta {
      display: flex;
      gap: 30px;
      margin-bottom: 30px;
      padding-bottom: 30px;
      border-bottom: 1px solid #eee;
      flex-wrap: wrap;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #666;
    }

    .meta-item i {
      font-size: 1.2rem;
      color: var(--accent-color);
    }

    .collab-description {
      font-size: 1.1rem;
      line-height: 1.8;
      color: #444;
      margin-bottom: 40px;
    }

    .partner-sidebar {
      background: #f8f9fa;
      border-radius: 20px;
      padding: 30px;
      text-align: center;
    }

    .sidebar-logo {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: white;
      margin: 0 auto 20px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      overflow: hidden;
    }

    .sidebar-logo img {
      max-width: 70%;
      max-height: 70%;
      object-fit: contain;
    }
  </style>
{% endblock %}

{% block body %}
  <main class="main">

    <section class="collab-detail-header">
      <div class="container">
        <h1 data-aos="fade-up">{{ collaboration.titre }}</h1>
        <span class="badge rounded-pill px-4 py-2 mt-3 {% if collaboration.statut.value == 'EN_COURS' %}bg-info{% else %}bg-success{% endif %}" data-aos="fade-up" data-aos-delay="100">
            {{ collaboration.statut.value }}
        </span>
      </div>
    </section>

    <section class="collab-details py-5">
      <div class="container">
        <div class="row collab-container g-5">
          <div class="col-lg-8" data-aos="fade-right">
            <div class="collab-meta">
                <div class="meta-item">
                    <i class="bi bi-calendar-event"></i>
                    <span>Début: {{ collaboration.dateDebut|date('d/m/Y') }}</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-calendar-check"></i>
                    <span>Fin: {{ collaboration.dateFin|date('d/m/Y') }}</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-building"></i>
                    <span>Partenaire: {{ collaboration.partner.name }}</span>
                </div>
            </div>

            <div class="collab-description">
                {{ collaboration.description|nl2br }}
            </div>

            <a href="{{ path('app_front_collaborations') }}" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Retour aux collaborations
            </a>
          </div>

          <div class="col-lg-4" data-aos="fade-left">
            <div class="partner-sidebar shadow-sm">
                <h4 class="mb-4">Partenaire du Projet</h4>
                <div class="sidebar-logo">
                    {% if collaboration.partner.imageName %}
                        <img src="{{ vich_uploader_asset(collaboration.partner, 'imageFile') }}" alt="{{ collaboration.partner.name }}">
                    {% else %}
                        <i class="bi bi-building fs-1 text-muted"></i>
                    {% endif %}
                </div>
                <h5 class="fw-bold mb-2">{{ collaboration.partner.name }}</h5>
                <p class="text-primary small mb-4">{{ collaboration.partner.typePartenaire.value }}</p>
                
                <div class="text-start small text-muted">
                    <p class="mb-2"><i class="bi bi-geo-alt me-2"></i>{{ collaboration.partner.adresse }}</p>
                    <p class="mb-0"><i class="bi bi-envelope me-2"></i>{{ collaboration.partner.email }}</p>
                </div>
                
                <hr class="my-4">
                
                <a href="{{ path('app_front_partners') }}" class="btn btn-primary w-100 rounded-pill">Voir tous les partenaires</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
{% endblock %}
