{% extends 'frontend/base.html.twig' %}

{% block title %}Nos Collaborations - Medicare{% endblock %}

{% block stylesheets %}
  <style>
    .collaboration-header {
      padding: 120px 0 60px 0;
      background: linear-gradient(135deg, #067d87 0%, #2487ce 100%);
      color: white;
      text-align: center;
    }

    .collab-card {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      transition: all 0.3s ease;
      height: 100%;
      border: 1px solid rgba(0,0,0,0.02);
      display: flex;
      flex-direction: column;
    }

    .collab-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
    }

    .collab-img-container {
      height: 200px;
      background: #f8f9fa;
      position: relative;
    }

    .collab-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .collab-status {
      position: absolute;
      top: 15px;
      right: 15px;
      padding: 5px 15px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .status-en-cours { background: #e0f7fa; color: #00acc1; }
    .status-terminee { background: #e8f5e9; color: #43a047; }

    .collab-content {
      padding: 25px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .collab-partner {
      font-size: 0.8rem;
      color: var(--accent-color);
      font-weight: 700;
      margin-bottom: 5px;
      display: flex;
      align-items: center;
    }

    .collab-partner i { margin-right: 5px; }

    .collab-title {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 15px;
      color: #1e1e2d;
    }

    .collab-desc {
      font-size: 0.95rem;
      color: #6c757d;
      line-height: 1.6;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    .collab-footer {
      border-top: 1px solid #f1f1f1;
      padding: 15px 25px;
      background: #fafafa;
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: #999;
    }

    .collab-date {
      display: flex;
      align-items: center;
    }

    .collab-date i { margin-right: 5px; }

    .empty-state {
      text-align: center;
      padding: 100px 0;
    }
  </style>
{% endblock %}

{% block body %}
  <main class="main">

    <section class="collaboration-header">
      <div class="container">
        <h1 data-aos="fade-up">Impact de nos Collaborations</h1>
        <p data-aos="fade-up" data-aos-delay="100">Découvrez comment nos efforts conjoints avec nos partenaires améliorent concrètement les soins de santé.</p>
      </div>
    </section>

    <section id="collaborations" class="collaborations section py-5">
      <div class="container">

        <div class="filter-form-container border-bottom pb-4 mb-5" data-aos="fade-up">
          <form action="{{ path('app_front_collaborations') }}" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
              <label for="search" class="form-label">Rechercher</label>
              <input type="text" id="search" name="search" class="form-control" placeholder="Titre, nom du partenaire..." value="{{ searchTerm }}">
            </div>
            <div class="col-md-4">
              <label for="status" class="form-label">Statut</label>
              <select id="status" name="status" class="form-select">
                <option value="">Tous (Actifs)</option>
                {% for status in ['EN_COURS', 'TERMINEE'] %}
                  <option value="{{ status }}" {{ selectedStatus == status ? 'selected' : '' }}>{{ status|replace({'_': ' '})|capitalize }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="d-grid w-100">
                    <button type="submit" class="btn btn-primary">Filtrer</button>
                </div>
                <a href="{{ path('app_front_collaborations') }}" class="btn btn-link btn-sm ms-2 text-nowrap">Réinitialiser</a>
            </div>
          </form>
        </div>

        <div class="row gy-4">
          {% for collaboration in collaborations %}
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
              <div class="collab-card">
                <div class="collab-img-container">
                    {% if collaboration.imageName %}
                        <img src="{{ vich_uploader_asset(collaboration, 'imageFile') }}" alt="{{ collaboration.titre }}" class="collab-img">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                            <i class="bi bi-person-badge" style="font-size: 4rem;"></i>
                        </div>
                    {% endif %}
                    <span class="collab-status {% if collaboration.statut.value == 'EN_COURS' %}status-en-cours{% else %}status-terminee{% endif %}">
                        {{ collaboration.statut.value }}
                    </span>
                </div>

                <div class="collab-content">
                  <div class="collab-partner">
                    <i class="bi bi-building"></i> {{ collaboration.partner.name }}
                  </div>
                  <h3 class="collab-title">{{ collaboration.titre }}</h3>
                  <p class="collab-desc">{{ collaboration.description|slice(0, 150) }}...</p>
                  <a href="{{ path('app_front_collaboration_show', {'id': collaboration.id}) }}" class="btn btn-outline-primary rounded-pill btn-sm align-self-start">En savoir plus</a>
                </div>

                <div class="collab-footer">
                    <div class="collab-date">
                        <i class="bi bi-calendar-event"></i> Début: {{ collaboration.dateDebut|date('d/m/Y') }}
                    </div>
                    <div class="collab-date">
                        <i class="bi bi-calendar-check"></i> Fin: {{ collaboration.dateFin|date('d/m/Y') }}
                    </div>
                </div>
              </div>
            </div>
          {% else %}
            <div class="col-12">
              <div class="empty-state">
                <i class="bi bi-person-badge text-light-emphasis" style="font-size: 4rem;"></i>
                <h3>Aucun projet de collaboration affiché</h3>
                <p>Nos équipes travaillent activement sur de nouveaux projets.</p>
                <a href="{{ path('app_home') }}" class="btn btn-outline-primary mt-3">Retour à l'accueil</a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

  </main>
{% endblock %}