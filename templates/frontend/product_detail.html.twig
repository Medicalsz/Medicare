{% extends 'frontend/base.html.twig' %}

{% block title %}{{ product.name }} - Medicare{% endblock %}
{% block body_class %}product-detail-page{% endblock %}

{% block body %}
<!-- Page Title -->
<div class="page-title" data-aos="fade">
  <div class="heading">
    <div class="container">
      <div class="row d-flex justify-content-center text-center">
        <div class="col-lg-8">
          <h1>{{ product.name }}</h1>
          <p class="mb-0">Product Details</p>
        </div>
      </div>
    </div>
  </div>
  <nav class="breadcrumbs">
    <div class="container">
      <ol>
        <li><a href="{{ path('app_home') }}">Home</a></li>
        <li><a href="{{ path('app_products') }}">Products</a></li>
        <li class="current">{{ product.name }}</li>
      </ol>
    </div>
  </nav>
</div>

<section id="product-detail" class="section">
  <div class="container">

    {% for message in app.flashes('success') %}
      <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle"></i> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}

    <div class="row gy-4">
      <div class="col-lg-8" data-aos="fade-right">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <span class="badge {{ product.type.badgeClass }} fs-6">{{ product.type.label }}</span>
              {% if product.quantity > 0 %}
                <span class="badge bg-success">In Stock</span>
              {% else %}
                <span class="badge bg-danger">Out of Stock</span>
              {% endif %}
            </div>

            <h2 class="mb-3">{{ product.name }}</h2>

            <div class="row mb-4">
              <div class="col-md-6">
                <table class="table table-borderless">
                  <tr><th>SKU</th><td>{{ product.sku }}</td></tr>
                  <tr><th>Price</th><td class="text-primary fw-bold fs-4">${{ product.price|number_format(2) }}</td></tr>
                  <tr><th>Available Qty</th><td>{{ product.quantity }}</td></tr>
                  {% if product.dosage %}
                  <tr><th>Dosage</th><td>{{ product.dosage }}</td></tr>
                  {% endif %}
                  {% if product.expiryDate %}
                  <tr><th>Expiry Date</th><td>{{ product.expiryDate|date('Y-m-d') }}</td></tr>
                  {% endif %}
                </table>
              </div>
            </div>

            <h5>Description</h5>
            <p class="text-muted">{{ product.description ?? 'No detailed description available.' }}</p>

            {% if product.quantity > 0 %}
            <div class="mt-4">
              <a href="{{ path('app_product_order', {id: product.id}) }}" class="btn btn-primary">
                <i class="bi bi-cart-plus"></i> Place an Order
              </a>
            </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-left">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <h5 class="card-title">Quick Info</h5>
            <ul class="list-unstyled">
              <li class="mb-2"><i class="bi bi-tag text-primary"></i> <strong>Type:</strong> {{ product.type.label }}</li>
              <li class="mb-2"><i class="bi bi-upc text-primary"></i> <strong>SKU:</strong> {{ product.sku }}</li>
              <li class="mb-2"><i class="bi bi-currency-dollar text-primary"></i> <strong>Price:</strong> ${{ product.price|number_format(2) }}</li>
              <li class="mb-2"><i class="bi bi-box text-primary"></i> <strong>Stock:</strong> {{ product.quantity }} units</li>
              {% if product.dosage %}
              <li class="mb-2"><i class="bi bi-capsule text-primary"></i> <strong>Dosage:</strong> {{ product.dosage }}</li>
              {% endif %}
            </ul>
          </div>
        </div>

        <a href="{{ path('app_products') }}" class="btn btn-outline-secondary w-100">
          <i class="bi bi-arrow-left"></i> Back to Products
        </a>
      </div>
    </div>

    <!-- Recommended Products -->
    {% if recommendations is defined and recommendations|length > 0 %}
    <div class="row mt-5" data-aos="fade-up">
      <div class="col-12">
        <h3 class="mb-4"><i class="bi bi-stars text-primary"></i> Recommended Products</h3>
      </div>
      {% for rec in recommendations %}
      <div class="col-lg-3 col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; transition: transform 0.2s;">
          <div class="card-body p-3">
            <span class="badge {{ rec.type.badgeClass }} mb-2">{{ rec.type.label }}</span>
            <h6 class="card-title mb-2">{{ rec.name }}</h6>
            <p class="text-primary fw-bold mb-1">${{ rec.price|number_format(2) }}</p>
            <p class="text-muted mb-2" style="font-size: 12px;">
              {% if rec.quantity > 0 %}
                <i class="bi bi-check-circle text-success"></i> In Stock ({{ rec.quantity }})
              {% else %}
                <i class="bi bi-x-circle text-danger"></i> Out of Stock
              {% endif %}
            </p>
            <a href="{{ path('app_product_detail', {id: rec.id}) }}" class="btn btn-outline-primary btn-sm w-100">
              View Details
            </a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</section>
{% endblock %}
