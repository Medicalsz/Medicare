{% extends 'frontend/base.html.twig' %}

{% block title %}Order {{ product.name }} - Medicare{% endblock %}
{% block body_class %}product-order-page{% endblock %}

{% block body %}
<!-- Page Title -->
<div class="page-title" data-aos="fade">
  <div class="heading">
    <div class="container">
      <div class="row d-flex justify-content-center text-center">
        <div class="col-lg-8">
          <h1>Place an Order</h1>
          <p class="mb-0">Ordering: {{ product.name }}</p>
        </div>
      </div>
    </div>
  </div>
  <nav class="breadcrumbs">
    <div class="container">
      <ol>
        <li><a href="{{ path('app_home') }}">Home</a></li>
        <li><a href="{{ path('app_products') }}">Products</a></li>
        <li><a href="{{ path('app_product_detail', {id: product.id}) }}">{{ product.name }}</a></li>
        <li class="current">Order</li>
      </ol>
    </div>
  </nav>
</div>

<section id="order-form" class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8" data-aos="fade-up">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <div class="row mb-4">
              <div class="col-md-8">
                <h4>{{ product.name }}</h4>
                <span class="badge {{ product.type.badgeClass }}">{{ product.type.label }}</span>
                {% if product.dosage %} <small class="text-muted ms-2">{{ product.dosage }}</small>{% endif %}
              </div>
              <div class="col-md-4 text-end">
                <span class="text-primary fw-bold fs-4">${{ product.price|number_format(2) }}</span>
                <br><small class="text-muted">per unit</small>
              </div>
            </div>

            <hr>

            {% if errors is defined and errors|length > 0 %}
              <div class="alert alert-danger">
                <ul class="mb-0">
                  {% for error in errors %}
                    <li>{{ error }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <form method="post" action="{{ path('app_product_order', {id: product.id}) }}">
              <div class="mb-3">
                <label for="quantity" class="form-label">Quantity</label>
                <input type="number" class="form-control" id="quantity" name="quantity" value="1" min="1" max="{{ product.quantity }}" required>
                <small class="text-muted">Available: {{ product.quantity }} units</small>
              </div>

              <div class="mb-3">
                <label for="notes" class="form-label">Notes (optional)</label>
                <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Any special instructions..."></textarea>
              </div>

              <div class="bg-light p-3 rounded mb-4">
                <div class="d-flex justify-content-between">
                  <span>Unit Price:</span>
                  <span>${{ product.price|number_format(2) }}</span>
                </div>
                <div class="d-flex justify-content-between mt-1">
                  <span>Quantity:</span>
                  <span id="display-qty">1</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between fw-bold fs-5">
                  <span>Total:</span>
                  <span class="text-primary" id="display-total">${{ product.price|number_format(2) }}</span>
                </div>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-check-circle"></i> Confirm Order
                </button>
                <a href="{{ path('app_product_detail', {id: product.id}) }}" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const qtyInput = document.getElementById('quantity');
    const displayQty = document.getElementById('display-qty');
    const displayTotal = document.getElementById('display-total');
    const unitPrice = {{ product.price }};

    qtyInput.addEventListener('input', function() {
      const qty = parseInt(this.value) || 1;
      displayQty.textContent = qty;
      displayTotal.textContent = '$' + (unitPrice * qty).toFixed(2);
    });
  });
</script>
{% endblock %}
