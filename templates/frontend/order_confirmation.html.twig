{% extends 'frontend/base.html.twig' %}

{% block title %}Order Confirmation - Medicare{% endblock %}
{% block body_class %}order-confirmation-page{% endblock %}

{% block stylesheets %}
<style>
  .confirmation-card {
    border: none;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .success-header {
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: white;
    padding: 30px;
    text-align: center;
  }
  .success-header .check-icon {
    width: 64px; height: 64px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    margin-bottom: 12px;
    animation: scale-in 0.5s ease;
  }
  @keyframes scale-in {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
  .pending-header {
    background: linear-gradient(135deg, #eab308, #ca8a04);
    color: white;
    padding: 30px;
    text-align: center;
  }
  .cancelled-header {
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    color: white;
    padding: 30px;
    text-align: center;
  }
  .detail-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #f3f4f6;
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-label { color: #6b7280; }
  .detail-value { font-weight: 600; }
  .invoice-btn {
    background: linear-gradient(135deg, #2563eb, #1e40af);
    border: none;
    padding: 10px 24px;
    border-radius: 8px;
    font-weight: 600;
  }
</style>
{% endblock %}

{% block body %}
<div class="page-title" data-aos="fade">
  <div class="heading">
    <div class="container">
      <div class="row d-flex justify-content-center text-center">
        <div class="col-lg-8">
          <h1>Order Confirmation</h1>
          <p class="mb-0">{{ commande.commandeNumber }}</p>
        </div>
      </div>
    </div>
  </div>
  <nav class="breadcrumbs">
    <div class="container">
      <ol>
        <li><a href="{{ path('app_home') }}">Home</a></li>
        <li><a href="{{ path('app_products') }}">Products</a></li>
        <li class="current">Confirmation</li>
      </ol>
    </div>
  </nav>
</div>

<section id="confirmation" class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7" data-aos="fade-up">
        <div class="confirmation-card card">
          {% if commande.status == 'PAID' %}
          <div class="success-header">
            <div class="check-icon"><i class="bi bi-check-lg"></i></div>
            <h3>Payment Successful!</h3>
            <p class="mb-0 opacity-75">Your order has been confirmed and is being processed.</p>
          </div>
          {% elseif commande.status == 'CANCELLED' %}
          <div class="cancelled-header">
            <div class="check-icon"><i class="bi bi-x-lg"></i></div>
            <h3>Order Cancelled</h3>
            <p class="mb-0 opacity-75">This order has been cancelled.</p>
          </div>
          {% else %}
          <div class="pending-header">
            <div class="check-icon"><i class="bi bi-clock"></i></div>
            <h3>Payment Pending</h3>
            <p class="mb-0 opacity-75">Your payment is still being processed.</p>
          </div>
          {% endif %}

          <div class="card-body p-4">
            <h5 class="mb-3">Order Details</h5>

            <div class="detail-row">
              <span class="detail-label">Order Number</span>
              <span class="detail-value">{{ commande.commandeNumber }}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Product</span>
              <span class="detail-value">{{ commande.product.name }}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Quantity</span>
              <span class="detail-value">{{ commande.quantity }}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Unit Price</span>
              <span class="detail-value">${{ commande.product.price|number_format(2) }}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Total</span>
              <span class="detail-value text-primary fs-5">${{ commande.totalPrice|number_format(2) }}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Status</span>
              <span class="badge {{ commande.statusBadgeClass }}">{{ commande.status }}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Date</span>
              <span class="detail-value">{{ commande.commandeDate|date('F j, Y H:i') }}</span>
            </div>
            {% if commande.notes %}
            <div class="detail-row">
              <span class="detail-label">Notes</span>
              <span class="detail-value">{{ commande.notes }}</span>
            </div>
            {% endif %}

            <div class="d-flex gap-2 mt-4">
              {% if commande.status == 'PAID' %}
              <a href="{{ path('app_order_invoice', {id: commande.id}) }}" class="btn btn-primary invoice-btn">
                <i class="bi bi-file-earmark-pdf"></i> Download Invoice
              </a>
              {% endif %}
              <a href="{{ path('app_products') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Continue Shopping
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
