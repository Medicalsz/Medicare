{% extends 'dashboard_base.html.twig' %}

{% block title %}Details rendez-vous - Medicare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sidebar,
        .sidebar-overlay {
            display: none !important;
        }

        .dashboard-container {
            margin-left: 0 !important;
            padding-top: 0 !important;
            width: 100% !important;
            min-height: 100vh;
            background:
                radial-gradient(circle at 15% 20%, rgba(0, 191, 255, 0.2), transparent 42%),
                radial-gradient(circle at 85% 0, rgba(56, 189, 248, 0.22), transparent 35%),
                linear-gradient(180deg, #f7fbff 0%, #eff6ff 100%);
        }

        .appointment-details-page {
            max-width: 1120px;
            margin: 0 auto;
            padding: 40px 24px 54px;
        }

        .details-header {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .details-title {
            margin: 0;
            font-size: 34px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
            width: 100%;
            text-align: center;
        }

        .back-link {
            text-decoration: none;
            color: #0284c7;
            font-weight: 700;
            display: inline-flex;
            gap: 7px;
            align-items: center;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(2, 132, 199, 0.08);
            border: 1px solid rgba(2, 132, 199, 0.2);
            transition: all 0.2s ease;
        }

        .back-link:hover {
            color: #0369a1;
            background: rgba(2, 132, 199, 0.13);
            transform: translateY(-1px);
        }

        .details-card {
            background: #fff;
            border: 1px solid #dbeafe;
            border-radius: 24px;
            box-shadow: 0 18px 45px rgba(14, 116, 144, 0.14);
            padding: 28px;
        }

        .rdv-status {
            display: inline-flex;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 22px;
            letter-spacing: 0.03em;
        }

        .status-confirme {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #86efac;
        }

        .status-en_attente {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fcd34d;
        }

        .status-annule {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        .rdv-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
            gap: 12px;
            margin-bottom: 22px;
        }

        .info-box {
            background: linear-gradient(180deg, #f8fcff 0%, #f1f5f9 100%);
            border: 1px solid #dbeafe;
            border-radius: 14px;
            padding: 13px 14px;
        }

        .info-label {
            color: #475569;
            font-size: 12px;
            margin-bottom: 4px;
            font-weight: 600;
        }

        .info-value {
            color: #0f172a;
            font-weight: 700;
        }

        .edit-form {
            border-top: 1px solid #dbeafe;
            padding-top: 20px;
            margin-top: 4px;
        }

        .edit-form-title {
            margin: 0 0 15px;
            font-size: 19px;
            color: #111827;
            letter-spacing: -0.01em;
        }

        .edit-fields {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 14px;
        }

        .edit-field label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            color: #475569;
            font-weight: 600;
        }

        .edit-field input {
            width: 100%;
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            padding: 11px 12px;
            font-size: 14px;
            color: #0f172a;
            background: #fff;
            transition: all 0.2s ease;
        }

        .edit-field input:focus {
            outline: none;
            border-color: #0ea5e9;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
        }

        .edit-field input:disabled {
            color: #64748b;
            background: #f8fafc;
            cursor: not-allowed;
            border-color: #dbeafe;
        }

        .appointment-actions {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: nowrap;
            margin-top: 16px;
        }

        .action-form {
            margin: 0;
        }

        .btn-action {
            border: none;
            border-radius: 12px;
            padding: 11px 18px;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-edit {
            background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%);
            color: #fff;
            box-shadow: 0 8px 18px rgba(14, 165, 233, 0.3);
        }

        .btn-save {
            background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
            color: #fff;
            box-shadow: 0 8px 18px rgba(34, 197, 94, 0.25);
        }

        .btn-cancel-rdv {
            background: #ffffff;
            color: #b91c1c;
            border: 1px solid #fca5a5;
            box-shadow: 0 6px 14px rgba(185, 28, 28, 0.12);
        }

        .btn-cancel-edit {
            background: #e2e8f0;
            color: #0f172a;
            border: 1px solid #cbd5e1;
        }

        .btn-edit:hover,
        .btn-save:hover,
        .btn-cancel-edit:hover,
        .btn-cancel-rdv:hover {
            transform: translateY(-1px);
        }

        .btn-disabled {
            background: #e2e8f0;
            color: #64748b;
            cursor: not-allowed;
            box-shadow: none;
        }

        .is-hidden {
            display: none;
        }

        .alert-error {
            margin-bottom: 14px;
            background: #fee2e2;
            color: #991b1b;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 600;
        }

        .ordonnance-box {
            border: 1px solid #dbeafe;
            background: #f8fbff;
            border-radius: 14px;
            padding: 12px 14px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .ordonnance-box p {
            margin: 0;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

        .ordonnance-btn {
            border: none;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            color: #fff;
            background: #0f172a;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .action-success-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.45);
            z-index: 10010;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .action-success-modal.show {
            display: flex;
        }

        .action-success-content {
            background: #fff;
            border-radius: 16px;
            width: min(420px, 100%);
            padding: 28px 24px;
            text-align: center;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.22);
        }

        .action-success-content h3 {
            margin: 8px 0 6px;
            font-size: 24px;
            color: #0f172a;
        }

        .action-success-content p {
            margin: 0;
            color: #475569;
        }

        .success-icon {
            width: 62px;
            height: 62px;
            border-radius: 999px;
            margin: 0 auto;
            display: grid;
            place-items: center;
            background: #dcfce7;
            color: #166534;
            font-size: 28px;
        }

        .action-confirm-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.52);
            z-index: 10020;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .action-confirm-modal.show {
            display: flex;
        }

        .action-confirm-content {
            background: #fff;
            border-radius: 16px;
            width: min(460px, 100%);
            padding: 24px 22px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.25);
        }

        .action-confirm-content h3 {
            margin: 0 0 8px;
            font-size: 22px;
            color: #0f172a;
        }

        .action-confirm-content p {
            margin: 0;
            color: #475569;
            line-height: 1.5;
        }

        .action-confirm-actions {
            margin-top: 18px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .confirm-btn-neutral,
        .confirm-btn-danger {
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            padding: 10px 14px;
            cursor: pointer;
        }

        .confirm-btn-neutral {
            background: #e2e8f0;
            color: #0f172a;
        }

        .confirm-btn-danger {
            background: #0284c7;
            color: #fff;
        }

        @media (max-width: 768px) {
            .appointment-details-page {
                padding: 18px 14px 30px;
            }

            .details-title {
                font-size: 24px;
            }

            .btn-action {
                width: 100%;
                justify-content: center;
            }

            .appointment-actions {
                flex-wrap: wrap;
            }
        }
    </style>
{% endblock %}

{% block body %}
{% set successMessages = app.flashes('success') %}

<div class="appointment-details-page">
    <div class="details-header">
        <a href="{{ path('app_appointments') }}" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Retour a mes rendez-vous
        </a>
        <h1 class="details-title">Details du rendez-vous</h1>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert-error">{{ message }}</div>
    {% endfor %}

    <div class="details-card">
        <div class="rdv-status status-{{ rendezVous.statut.value|lower }}">
            {{ rendezVous.statut.value|replace({'_': ' '}) }}
        </div>

        <div class="rdv-grid">
            <div class="info-box">
                <div class="info-label">Medecin</div>
                <div class="info-value">Dr {{ rendezVous.medecin.user.prenom }} {{ rendezVous.medecin.user.nom }}</div>
            </div>
            <div class="info-box">
                <div class="info-label">Specialite</div>
                <div class="info-value">
                    {{ rendezVous.medecin.specialiteRef ? rendezVous.medecin.specialiteRef.nom : rendezVous.medecin.specialite }}
                </div>
            </div>
            <div class="info-box">
                <div class="info-label">Cabinet</div>
                <div class="info-value">{{ rendezVous.medecin.cabinet ?: '-' }}</div>
            </div>
            <div class="info-box">
                <div class="info-label">Date actuelle</div>
                <div class="info-value">{{ rendezVous.date|date('d/m/Y') }}</div>
            </div>
            <div class="info-box">
                <div class="info-label">Heure actuelle</div>
                <div class="info-value">{{ rendezVous.heure|date('H:i') }}</div>
            </div>
            <div class="info-box">
                <div class="info-label">Patient</div>
                <div class="info-value">{{ app.user.prenom }} {{ app.user.nom }}</div>
            </div>
        </div>

        {% if consultation %}
            <div class="ordonnance-box">
                <p>Votre ordonnance est disponible pour ce rendez-vous.</p>
                <a class="ordonnance-btn" href="{{ path('app_consultation_ordonnance_pdf', {'id': consultation.id}) }}">
                    <i class="fas fa-file-pdf"></i>
                    Telecharger le PDF
                </a>
            </div>
        {% elseif rendezVous.statut.value == 'CONFIRME' %}
            <div class="ordonnance-box">
                <p>L ordonnance sera visible ici apres la consultation.</p>
            </div>
        {% endif %}

        <form id="appointmentEditForm" class="edit-form" method="post" action="{{ path('app_appointment_update', {'id': rendezVous.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('update_appointment_' ~ rendezVous.id) }}">
            <h2 class="edit-form-title">Modifier la date ou l heure</h2>
            <div class="edit-fields">
                <div class="edit-field">
                    <label for="dateRdv">Date du rendez-vous</label>
                    <input id="dateRdv" type="date" name="date_rdv" value="{{ rendezVous.date|date('Y-m-d') }}" disabled required>
                </div>
                <div class="edit-field">
                    <label for="heureRdv">Heure du rendez-vous</label>
                    <input id="heureRdv" type="time" step="1800" name="heure_rdv" value="{{ rendezVous.heure|date('H:i') }}" disabled required>
                </div>
            </div>
        </form>

        {% if rendezVous.statut.value != 'ANNULE' %}
            <div class="appointment-actions">
                <button type="button" id="enableEditBtn" class="btn-action btn-edit">
                    <i class="fas fa-pen"></i>
                    Modifier
                </button>
                <button type="button" id="saveEditBtn" class="btn-action btn-save is-hidden">
                    <i class="fas fa-check"></i>
                    Modifier
                </button>
                <button type="button" id="cancelEditBtn" class="btn-action btn-cancel-edit is-hidden">
                    <i class="fas fa-times"></i>
                    Annuler
                </button>
                <form id="cancelAppointmentForm" class="action-form" method="post" action="{{ path('app_appointment_cancel', {'id': rendezVous.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_appointment_' ~ rendezVous.id) }}">
                    <button type="button" id="cancelRdvBtn" class="btn-action btn-cancel-rdv">
                        <i class="fas fa-ban"></i>
                        Annuler le rendez-vous
                    </button>
                </form>
            </div>
        {% else %}
            <div class="appointment-actions">
                <button type="button" class="btn-action btn-disabled" disabled>Rendez-vous annule</button>
            </div>
        {% endif %}
    </div>
</div>

{% if successMessages is not empty %}
    <div id="actionSuccessModal" class="action-success-modal">
        <div class="action-success-content">
            <div class="success-icon">
                <i class="fas fa-check"></i>
            </div>
            <h3>Action reussie</h3>
            <p>{{ successMessages|first }}</p>
        </div>
    </div>
{% endif %}

<div id="actionConfirmModal" class="action-confirm-modal" aria-hidden="true">
    <div class="action-confirm-content">
        <h3 id="actionConfirmTitle">Confirmation</h3>
        <p id="actionConfirmMessage">Voulez-vous confirmer cette action ?</p>
        <div class="action-confirm-actions">
            <button type="button" id="confirmCancelBtn" class="confirm-btn-neutral">Non</button>
            <button type="button" id="confirmActionBtn" class="confirm-btn-danger">Oui, confirmer</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editBtn = document.getElementById('enableEditBtn');
            const saveBtn = document.getElementById('saveEditBtn');
            const cancelEditBtn = document.getElementById('cancelEditBtn');
            const cancelRdvBtn = document.getElementById('cancelRdvBtn');
            const dateInput = document.getElementById('dateRdv');
            const timeInput = document.getElementById('heureRdv');
            const editForm = document.getElementById('appointmentEditForm');
            const cancelForm = document.getElementById('cancelAppointmentForm');
            const confirmModal = document.getElementById('actionConfirmModal');
            const confirmMessage = document.getElementById('actionConfirmMessage');
            const confirmCancelBtn = document.getElementById('confirmCancelBtn');
            const confirmActionBtn = document.getElementById('confirmActionBtn');
            let pendingConfirmAction = null;
            let originalDateValue = dateInput ? dateInput.value : '';
            let originalTimeValue = timeInput ? timeInput.value : '';

            if (editBtn && saveBtn && cancelEditBtn && dateInput && timeInput) {
                editBtn.addEventListener('click', function () {
                    originalDateValue = dateInput.value;
                    originalTimeValue = timeInput.value;
                    dateInput.disabled = false;
                    timeInput.disabled = false;
                    saveBtn.classList.remove('is-hidden');
                    cancelEditBtn.classList.remove('is-hidden');
                    editBtn.classList.add('is-hidden');
                    if (cancelForm) {
                        cancelForm.classList.add('is-hidden');
                    }
                    dateInput.focus();
                });

                cancelEditBtn.addEventListener('click', function () {
                    dateInput.value = originalDateValue;
                    timeInput.value = originalTimeValue;
                    dateInput.disabled = true;
                    timeInput.disabled = true;
                    saveBtn.classList.add('is-hidden');
                    cancelEditBtn.classList.add('is-hidden');
                    editBtn.classList.remove('is-hidden');
                    if (cancelForm) {
                        cancelForm.classList.remove('is-hidden');
                    }
                });
            }

            function openConfirmModal(message, onConfirm) {
                if (!confirmModal || !confirmMessage) {
                    onConfirm();
                    return;
                }

                confirmMessage.textContent = message;
                pendingConfirmAction = onConfirm;
                confirmModal.classList.add('show');
                confirmModal.setAttribute('aria-hidden', 'false');
            }

            function closeConfirmModal() {
                if (!confirmModal) {
                    return;
                }
                confirmModal.classList.remove('show');
                confirmModal.setAttribute('aria-hidden', 'true');
                pendingConfirmAction = null;
            }

            if (saveBtn && editForm) {
                saveBtn.addEventListener('click', function () {
                    openConfirmModal('Confirmer la modification de ce rendez-vous ?', function () {
                        editForm.submit();
                    });
                });
            }

            if (cancelRdvBtn && cancelForm) {
                cancelRdvBtn.addEventListener('click', function () {
                    openConfirmModal('Confirmer l annulation de ce rendez-vous ?', function () {
                        cancelForm.submit();
                    });
                });
            }

            if (confirmCancelBtn) {
                confirmCancelBtn.addEventListener('click', closeConfirmModal);
            }

            if (confirmActionBtn) {
                confirmActionBtn.addEventListener('click', function () {
                    const callback = pendingConfirmAction;
                    closeConfirmModal();
                    if (typeof callback === 'function') {
                        callback();
                    }
                });
            }

            if (confirmModal) {
                confirmModal.addEventListener('click', function (event) {
                    if (event.target === confirmModal) {
                        closeConfirmModal();
                    }
                });
            }

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && confirmModal && confirmModal.classList.contains('show')) {
                    closeConfirmModal();
                }
            });

            const successModal = document.getElementById('actionSuccessModal');
            if (successModal) {
                successModal.classList.add('show');
                setTimeout(function () {
                    successModal.classList.remove('show');
                    window.location.href = '{{ path('app_appointments') }}';
                }, 1800);
            }
        });
    </script>
{% endblock %}
