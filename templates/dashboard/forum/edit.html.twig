{% extends 'admin/base.html.twig' %}

{% block title %}Modifier le sujet - Medicare{% endblock %}

{% block plugin_css %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/forum-modern.css') }}?v=20260218-1">
{% endblock %}

{% block custom_js %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeInputs = document.querySelectorAll('input[name$="[type]"]');
            const videoBlock = document.getElementById('video-url-block');
            if (!typeInputs.length || !videoBlock) {
                return;
            }

            const syncVideoBlock = function () {
                let selectedValue = 'text';
                typeInputs.forEach(function (input) {
                    if (input.checked) {
                        selectedValue = input.value;
                    }
                });
                videoBlock.style.display = selectedValue === 'video' ? 'block' : 'none';
            };

            typeInputs.forEach(function (input) {
                input.addEventListener('change', syncVideoBlock);
            });

            syncVideoBlock();
        });
    </script>
{% endblock %}

{% block content %}
<div class="forum-modern forum-page">
    <div class="forum-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <p class="forum-kicker mb-1">Edition</p>
            <h1 class="page-title mb-2">Modifier le sujet</h1>
            <p class="page-subtitle mb-0">Mettez a jour votre publication puis enregistrez.</p>
        </div>
        <a href="{{ path('app_admin_forum_show', {id: topic.id}) }}" class="btn btn-outline-secondary">Retour au sujet</a>
    </div>

    <section class="forum-form-card">
        {{ form_start(form) }}
            {{ form_row(form.type, {
                'label': 'Type de sujet',
                'attr': {'class': 'forum-type-choice'}
            }) }}
            {{ form_row(form.title, {
                'label': 'Titre',
                'attr': {
                    'class': 'form-control forum-input',
                    'placeholder': 'Titre du sujet'
                }
            }) }}
            <div id="video-url-block">
                {{ form_row(form.videoUrl, {
                    'label': 'URL video',
                    'attr': {
                        'class': 'form-control forum-input',
                        'placeholder': 'https://www.youtube.com/watch?v=...'
                    }
                }) }}
            </div>
            {{ form_row(form.content, {
                'label': 'Contenu',
                'attr': {
                    'rows': 10,
                    'class': 'form-control forum-textarea',
                    'placeholder': 'Mettez a jour les details du sujet...'
                }
            }) }}
            <div class="d-flex justify-content-end gap-2">
                <a href="{{ path('app_admin_forum_show', {id: topic.id}) }}" class="btn btn-outline-secondary">Annuler</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}

