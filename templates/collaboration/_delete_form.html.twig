<form method="post" action="{{ path('app_collaboration_delete', {'id': collaboration.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ collaboration.id) }}">
    <button class="{{ button_class|default('btn btn-danger btn-sm') }}">
        <i class="bi bi-trash me-1"></i>{{ button_text|default('Supprimer') }}
    </button>
</form>