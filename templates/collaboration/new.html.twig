{% extends 'admin_base.html.twig' %}

{% block title %}Nouvelle Collaboration{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a href="{{ path('app_collaboration_index') }}" class="btn btn-outline-secondary btn-sm rounded-circle me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 mb-0 text-gray-800">Lancer une Collaboration</h1>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    {{ form_errors(form) }}
                    {{ include('collaboration/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}