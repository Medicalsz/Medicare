<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {% set current_route = app.request.attributes.get('_route')|default('') %}
    <title>{% block title %}Espace Utilisateur - Medicare{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('admin/vendors/feather/feather.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/mdi/css/materialdesignicons.min.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/ti-icons/css/themify-icons.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/font-awesome/css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/typicons/typicons.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/simple-line-icons/css/simple-line-icons.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/css/vendor.bundle.base.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css') }}">
    {% block plugin_css %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('admin/css/style.css') }}">
    <link rel="shortcut icon" href="{{ asset('admin/images/favicon.png') }}" />
  </head>
  <body class="{% block body_class %}with-welcome-text{% endblock %}">
    <div class="container-scroller">
      <nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
        <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
          <div class="me-3">
            <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-bs-toggle="minimize">
              <span class="icon-menu"></span>
            </button>
          </div>
          <div>
            <a class="navbar-brand brand-logo" href="{{ path('app_user_forum_index') }}">
              <span style="font-size: 2rem; font-weight: 700; color: #1f3bb3;">Medicare User</span>
            </a>
            <a class="navbar-brand brand-logo-mini" href="{{ path('app_user_forum_index') }}">
              <span style="font-size: 1.2rem; font-weight: 700; color: #1f3bb3;">MU</span>
            </a>
          </div>
        </div>
        <div class="navbar-menu-wrapper d-flex align-items-top">
          <ul class="navbar-nav">
            <li class="nav-item fw-semibold d-none d-lg-block ms-0">
              <h1 class="welcome-text">Bienvenue, <span class="text-black fw-bold">{% if app.user %}{{ app.user.prenom }}{% else %}Utilisateur{% endif %}</span></h1>
              <h3 class="welcome-sub-text">Votre espace communautaire est prêt.</h3>
            </li>
          </ul>
          <ul class="navbar-nav ms-auto">
            <li class="nav-item d-none d-lg-block">
              <div id="datepicker-popup" class="input-group date datepicker navbar-date-picker">
                <span class="input-group-addon input-group-prepend border-right">
                  <span class="icon-calendar input-group-text calendar-icon"></span>
                </span>
                <input type="text" class="form-control">
              </div>
            </li>
            <li class="nav-item dropdown d-none d-lg-block user-dropdown">
              <a class="nav-link" id="UserDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                <img class="img-xs rounded-circle" src="{{ asset('admin/images/faces/face8.jpg') }}" alt="Profile image">
              </a>
              <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="UserDropdown">
                <div class="dropdown-header text-center">
                  <img class="img-md rounded-circle" src="{{ asset('admin/images/faces/face8.jpg') }}" alt="Profile image">
                  {% if app.user %}
                    <p class="mb-1 mt-3 fw-semibold">{{ app.user.prenom }} {{ app.user.nom }}</p>
                    <p class="fw-light text-muted mb-0">{{ app.user.email }}</p>
                  {% endif %}
                </div>
                <a class="dropdown-item" href="{{ path('app_user_forum_index') }}"><i class="dropdown-item-icon mdi mdi-forum text-primary me-2"></i>Forum</a>
                <a class="dropdown-item" href="{{ path('app_products') }}"><i class="dropdown-item-icon mdi mdi-pill text-primary me-2"></i>Produits</a>
                <a class="dropdown-item" href="{{ path('app_front_partners') }}"><i class="dropdown-item-icon mdi mdi-handshake text-primary me-2"></i>Partenaires</a>
                <a class="dropdown-item" href="{{ path('app_front_collaborations') }}"><i class="dropdown-item-icon mdi mdi-account-group text-primary me-2"></i>Collaborations</a>
                <a class="dropdown-item" href="{{ path('app_home') }}"><i class="dropdown-item-icon mdi mdi-home text-primary me-2"></i>Retour au site</a>
                <a class="dropdown-item" href="{{ path('app_logout') }}"><i class="dropdown-item-icon mdi mdi-power text-primary me-2"></i>Déconnexion</a>
              </div>
            </li>
          </ul>
          <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-bs-toggle="offcanvas">
            <span class="mdi mdi-menu"></span>
          </button>
        </div>
      </nav>
      <div class="container-fluid page-body-wrapper">
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
          <ul class="nav">
            <li class="nav-item nav-category">Espace User</li>
            <li class="nav-item">
              <a class="nav-link {{ current_route starts with 'app_user_forum' ? 'active' : '' }}" href="{{ path('app_user_forum_index') }}">
                <i class="menu-icon mdi mdi-forum"></i>
                <span class="menu-title">Forum</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link {{ current_route starts with 'app_product' or current_route == 'app_products' ? 'active' : '' }}" href="{{ path('app_products') }}">
                <i class="menu-icon mdi mdi-pill"></i>
                <span class="menu-title">Produits</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link {{ current_route == 'app_front_partners' ? 'active' : '' }}" href="{{ path('app_front_partners') }}">
                <i class="menu-icon mdi mdi-handshake"></i>
                <span class="menu-title">Partenaires</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link {{ current_route starts with 'app_front_collaboration' or current_route == 'app_front_collaborations' ? 'active' : '' }}" href="{{ path('app_front_collaborations') }}">
                <i class="menu-icon mdi mdi-account-group"></i>
                <span class="menu-title">Collaborations</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link {{ current_route starts with 'app_notifications' ? 'active' : '' }}" href="{{ path('app_notifications_index') }}">
                <i class="menu-icon mdi mdi-bell"></i>
                <span class="menu-title">Notifications</span>
              </a>
            </li>
          </ul>
        </nav>
        <div class="main-panel">
          <div class="content-wrapper">
            {% block content %}{% endblock %}
          </div>
          <footer class="footer">
            <div class="d-sm-flex justify-content-center justify-content-sm-between">
              <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Medicare User Space</span>
              <span class="float-none float-sm-end d-block mt-1 mt-sm-0 text-center">Copyright Â© 2025. All rights reserved.</span>
            </div>
          </footer>
        </div>
      </div>
    </div>
    <script src="{{ asset('admin/vendors/js/vendor.bundle.base.js') }}"></script>
    <script src="{{ asset('admin/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js') }}"></script>
    {% block plugin_js %}{% endblock %}
    <script src="{{ asset('admin/js/off-canvas.js') }}"></script>
    <script src="{{ asset('admin/js/template.js') }}"></script>
    <script src="{{ asset('admin/js/settings.js') }}"></script>
    <script src="{{ asset('admin/js/hoverable-collapse.js') }}"></script>
    <script src="{{ asset('admin/js/todolist.js') }}"></script>
    {% block custom_js %}{% endblock %}
  </body>
</html>
