<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medicare AI Assistant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            height: 100vh;
            margin: 0;
            color: #444;
        }
        .chat-container {
            flex-grow: 1;
            overflow-y: auto;
            padding: 25px 20px;
            background-color: #f9f9f9;
        }
        .chat-message {
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
        }
        .chat-message .message-bubble {
            padding: 12px 18px;
            border-radius: 18px;
            max-width: 85%;
            word-wrap: break-word;
            line-height: 1.5;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .chat-message.user {
            align-items: flex-end;
        }
        .chat-message.user .message-bubble {
            background-image: linear-gradient(to right, #007bff, #0056b3);
            color: white;
            border-bottom-right-radius: 4px;
        }
        .chat-message.bot {
            align-items: flex-start;
        }
        .chat-message.bot .message-bubble {
            background-color: #eef1f5;
            color: #333;
            border-bottom-left-radius: 4px;
        }
        .chat-input-form {
            display: flex;
            padding: 15px 20px;
            background-color: #fff;
            border-top: 1px solid #e0e0e0;
            gap: 10px;
        }
        .chat-input-form input {
            flex-grow: 1;
            border-radius: 25px;
            border: 1px solid #ddd;
            padding: 10px 20px;
            font-size: 15px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .chat-input-form input:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
            outline: none;
        }
        .chat-input-form button {
            border-radius: 50%;
            width: 50px;
            height: 50px;
            flex-shrink: 0;
            background-image: linear-gradient(to right, #007bff, #0056b3);
            border: none;
            transition: transform 0.2s;
        }
        .chat-input-form button:hover {
            transform: scale(1.05);
        }
        .typing-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background-color: #b0b0b0;
            margin: 0 2px;
            animation: typing 1.5s infinite ease-in-out;
        }
        .typing-dot:nth-child(1) { animation-delay: -0.30s; }
        .typing-dot:nth-child(2) { animation-delay: -0.15s; }
        .typing-dot:nth-child(3) { animation-delay: 0s; }
        @keyframes typing {
            0%, 80%, 100% {
                transform: scale(0);
            } 40% {
                transform: scale(1.0);
            }
        }
    </style>
</head>
<body>

    <div class="chat-container" id="chat-container">
        <div class="chat-message bot">
            <div class="message-bubble">
                Hello there! I'm your AI assistant from Medicare. How can I help you today?
                <br><br>
                Please remember, I can provide information and support, but I cannot offer medical advice, diagnose conditions, or recommend treatments. For any health concerns, please consult a qualified healthcare professional.
            </div>
        </div>
    </div>

    <form class="chat-input-form" id="chat-form">
        <input type="text" id="chat-input" class="form-control" placeholder="Type your message..." autocomplete="off">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-send-fill"></i>
        </button>
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chatForm = document.getElementById('chat-form');
            const chatInput = document.getElementById('chat-input');
            const chatContainer = document.getElementById('chat-container');

            chatForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const userMessage = chatInput.value.trim();

                if (userMessage === '') {
                    return;
                }

                appendMessage(userMessage, 'user');
                chatInput.value = '';
                showTypingIndicator();

                fetch('{{ path('app_chatbot_ask') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ message: userMessage })
                })
                .then(response => response.json())
                .then(data => {
                    removeTypingIndicator();
                    if (data.reply) {
                        appendMessage(data.reply, 'bot');
                    } else {
                        appendMessage('Sorry, I encountered an error. Please try again.', 'bot');
                    }
                })
                .catch(error => {
                    removeTypingIndicator();
                    console.error('Error:', error);
                    appendMessage('Sorry, I was unable to connect. Please check your connection and try again.', 'bot');
                });
            });

            function appendMessage(message, sender) {
                const messageWrapper = document.createElement('div');
                messageWrapper.classList.add('chat-message', sender);

                const messageBubble = document.createElement('div');
                messageBubble.classList.add('message-bubble');
                messageBubble.textContent = message;

                messageWrapper.appendChild(messageBubble);
                chatContainer.appendChild(messageWrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function showTypingIndicator() {
                const typingIndicator = document.createElement('div');
                typingIndicator.id = 'typing-indicator';
                typingIndicator.classList.add('chat-message', 'bot');
                
                const bubble = document.createElement('div');
                bubble.classList.add('message-bubble');
                bubble.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
                
                typingIndicator.appendChild(bubble);
                chatContainer.appendChild(typingIndicator);
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function removeTypingIndicator() {
                const typingIndicator = document.getElementById('typing-indicator');
                if (typingIndicator) {
                    typingIndicator.remove();
                }
            }
        });
    </script>
</body>
</html>