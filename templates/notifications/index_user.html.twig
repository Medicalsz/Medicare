{% extends 'user/base.html.twig' %}

{% block title %}Notifications - Medicare{% endblock %}

{% block content %}
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1">Notifications</h1>
            <p class="text-muted mb-0">Retrouvez les nouvelles activites du forum.</p>
        </div>
        <form method="post" action="{{ path('app_notifications_read_all') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
            <button type="submit" class="btn btn-outline-secondary">Tout marquer comme lu</button>
        </form>
    </div>

    {% if notifications is empty %}
        <div class="card">
            <div class="card-body">Aucune notification pour le moment.</div>
        </div>
    {% else %}
        <div class="card">
            <div class="list-group list-group-flush">
                {% for notification in notifications %}
                    <div class="list-group-item d-flex justify-content-between align-items-start gap-3 {{ not notification.isRead ? 'bg-light' : '' }}">
                        <div>
                            <div class="fw-semibold">{{ notification.message }}</div>
                            <div class="small text-muted">
                                {{ notification.authorName }} - {{ notification.createdAt|date('d/m/Y H:i') }}
                            </div>
                            <a href="{{ notification.link }}" class="small">Ouvrir le sujet</a>
                        </div>
                        {% if not notification.isRead %}
                            <form method="post" action="{{ path('app_notifications_read', {id: notification.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Marquer lu</button>
                            </form>
                        {% else %}
                            <span class="badge text-bg-success">Lu</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

