        padding: 30px;
        box-shadow: 0px 0 30px rgba(0, 0, 0, 0.08);
        transition: 0.3s;
        border-radius: 15px;
        text-align: center;
        width: 100%;
      }
      .partner-item:hover {
        transform: translateY(-10px);
      }
      .partner-img img {
        max-height: 80px;
        margin-bottom: 20px;
      }
      .collaboration-card {
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0px 0 30px rgba(0, 0, 0, 0.08);
        height: 100%;
      }
      .collaboration-content {
        padding: 20px;
      }
      .collaboration-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
      }
      .btn-link {
        color: var(--accent-color);
        text-decoration: none;
        font-weight: 600;
      }
    </style>


