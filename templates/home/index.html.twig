    <!-- Partners & Collaborations Section -->
    <section id="partners" class="partners section">
      <div class="container section-title" data-aos="fade-up">
        <h2>Nos Partenaires & Collaborations</h2>
        <p>Nous travaillons avec les meilleurs pour vous offrir des soins d'excellence</p>
      </div>

      <div class="container">
        <div class="row gy-4">
          {% for partner in partners %}
            <div class="col-xl-3 col-md-6 d-flex align-items-stretch" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
              <div class="partner-item">
                <div class="partner-img">
                  {% if partner.imageName %}
                    <img src="{{ vich_uploader_asset(partner, 'imageFile') }}" class="img-fluid" alt="{{ partner.name }}">
                  {% else %}
                    <img src="{{ asset('assets/img/health/staff-1.webp') }}" class="img-fluid" alt="{{ partner.name }}">
                  {% endif %}
                </div>
                <div class="partner-info">
                  <h4>{{ partner.name }}</h4>
                  <span>{{ partner.typePartenaire.value }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="row mt-5 gy-4">
          <div class="col-12 text-center mb-4">
            <h3>Dernières Collaborations</h3>
          </div>
          {% for collaboration in collaborations|slice(0, 3) %}
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
              <div class="collaboration-card">
                {% if collaboration.imageName %}
                  <img src="{{ vich_uploader_asset(collaboration, 'imageFile') }}" class="img-fluid" alt="{{ collaboration.titre }}">
                {% endif %}
                <div class="collaboration-content">
                  <h4>{{ collaboration.titre }}</h4>
                  <p>{{ collaboration.description|slice(0, 100) }}...</p>
                  <div class="collaboration-footer">
                    <span class="badge bg-info">{{ collaboration.statut.value }}</span>
                    <a href="{{ path('app_collaboration_show', {'id': collaboration.id}) }}" class="btn-link">Détails <i class="bi bi-arrow-right"></i></a>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <style>
