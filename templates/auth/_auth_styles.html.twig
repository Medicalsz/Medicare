{# Shared auth page styles - matches frontend accent (Login button) #}
<style>
.auth-page-wrapper {
  padding-top: 100px;
  padding-bottom: 60px;
  min-height: 80vh;
  background: linear-gradient(180deg, #f7f9f9 0%, #fff 100%);
}
.auth-page-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--accent-color, #099aa7);
  font-size: 15px;
  margin-bottom: 24px;
  padding: 8px 0;
  text-decoration: none;
  transition: opacity 0.2s;
}
.auth-page-back-btn:hover {
  color: var(--accent-color, #099aa7);
  opacity: 0.85;
}
.auth-container {
  max-width: 440px;
  margin: 0 auto;
  background: var(--surface-color, #fff);
  border-radius: 12px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  padding: 40px 36px;
  border: 1px solid rgba(0,0,0,0.06);
}
.auth-container.auth-container--wide {
  max-width: 520px;
}
.auth-header {
  text-align: center;
  margin-bottom: 28px;
}
.auth-header h1 {
  font-size: 26px;
  font-weight: 700;
  color: var(--heading-color, #1f2f31);
  margin: 0 0 8px;
  letter-spacing: -0.02em;
}
.auth-header p {
  font-size: 15px;
  color: var(--default-color, #363f40);
  margin: 0;
  opacity: 0.9;
}
.auth-container .alert {
  border-radius: 8px;
  margin-bottom: 20px;
  font-size: 14px;
}
.auth-container .alert-danger {
  background: #fef2f2;
  border-color: #fecaca;
  color: #b91c1c;
}
.auth-container .alert-success {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #166534;
}
.auth-container .form-group {
  margin-bottom: 20px;
}
.auth-container .form-group label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--heading-color, #1f2f31);
  margin-bottom: 8px;
}
.auth-container .form-control {
  width: 100%;
  padding: 12px 14px;
  font-size: 15px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.auth-container .form-control:focus {
  border-color: var(--accent-color, #099aa7);
  outline: none;
  box-shadow: 0 0 0 3px rgba(9, 154, 167, 0.15);
}
.auth-container .form-control.is-invalid {
  border-color: #dc2626;
}
.auth-container .form-control.is-valid {
  border-color: #16a34a;
}
.auth-container .invalid-feedback {
  font-size: 13px;
  color: #dc2626;
  margin-top: 6px;
}
.auth-container .btn-submit {
  width: 100%;
  padding: 14px 24px;
  font-size: 16px;
  font-weight: 600;
  color: var(--contrast-color, #fff);
  background: var(--accent-color, #099aa7);
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s, transform 0.05s;
  margin-top: 8px;
}
.auth-container .btn-submit:hover {
  background: color-mix(in srgb, var(--accent-color, #099aa7), transparent 15%);
  color: var(--contrast-color, #fff);
}
.auth-container .btn-submit:active {
  transform: scale(0.99);
}
.auth-footer {
  text-align: center;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid #f1f5f9;
}
.auth-footer p {
  margin: 0;
  font-size: 15px;
  color: var(--default-color, #363f40);
}
.auth-footer a {
  color: var(--accent-color, #099aa7);
  font-weight: 600;
  text-decoration: none;
}
.auth-footer a:hover {
  text-decoration: underline;
}
.auth-container .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media (max-width: 500px) {
  .auth-container .form-row {
    grid-template-columns: 1fr;
  }
  .auth-container {
    padding: 28px 20px;
  }
}
.auth-container .checkbox-group {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 20px 0 24px;
}
.auth-container .checkbox-group input[type="checkbox"] {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  accent-color: var(--accent-color, #099aa7);
}
.auth-container .checkbox-group label {
  font-size: 14px;
  color: var(--default-color, #363f40);
  font-weight: 400;
  cursor: pointer;
}
.auth-container .form-errors ul {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
  font-size: 14px;
  color: #b91c1c;
}
</style>
