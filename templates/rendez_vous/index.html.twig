{% extends 'base.html.twig' %}

{% block title %}Prendre Rendez-vous - Medicare{% endblock %}

{% block body %}
<link rel="stylesheet" href="/css/rendez-vous.css">

<section class="rendez-vous-section">
    <div class="container">
        <div class="rdv-header text-center">
            <h1 class="rdv-title">Prendre Rendez-vous</h1>
            <p class="rdv-subtitle">Réservez votre consultation en quelques clics</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="rdv-form-wrapper">
                    <form id="rdvForm" class="rdv-form">
                        <div class="form-step" id="step1">
                            <h3 class="step-title"><i class="fas fa-user-md"></i> Choisir un médecin</h3>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="specialite"><i class="fas fa-stethoscope"></i> Spécialité</label>
                                        <select class="form-control" id="specialite" required>
                                            <option value="">Choisir une spécialité</option>
                                            <option value="cardiologue">Cardiologue</option>
                                            <option value="dentiste">Dentiste</option>
                                            <option value="pediatre">Pédiatre</option>
                                            <option value="chirurgien">Chirurgien</option>
                                            <option value="dermatologue">Dermatologue</option>
                                            <option value="neurologue">Neurologue</option>
                                        </select>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="medecin"><i class="fas fa-user-doctor"></i> Médecin</label>
                                        <select class="form-control" id="medecin" required>
                                            <option value="">Choisir un médecin</option>
                                            <option value="1">Dr. Sarah Martin - Cardiologue</option>
                                            <option value="2">Dr. Ahmed Benali - Dentiste</option>
                                            <option value="3">Dr. Marie Dubois - Pédiatre</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <h3 class="step-title mt-4"><i class="fas fa-calendar-alt"></i> Date et Heure</h3>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="date"><i class="fas fa-calendar"></i> Date</label>
                                        <input type="date" class="form-control" id="date" required>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="heure"><i class="fas fa-clock"></i> Heure</label>
                                        <select class="form-control" id="heure" required>
                                            <option value="">Choisir une heure</option>
                                            <option value="08:00">08:00</option>
                                            <option value="09:00">09:00</option>
                                            <option value="10:00">10:00</option>
                                            <option value="11:00">11:00</option>
                                            <option value="14:00">14:00</option>
                                            <option value="15:00">15:00</option>
                                            <option value="16:00">16:00</option>
                                            <option value="17:00">17:00</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <h3 class="step-title mt-4"><i class="fas fa-user"></i> Vos Informations</h3>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="nom"><i class="fas fa-id-card"></i> Nom complet</label>
                                        <input type="text" class="form-control" id="nom" placeholder="Votre nom" required>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="email"><i class="fas fa-envelope"></i> Email</label>
                                        <input type="email" class="form-control" id="email" placeholder="votre@email.fr" required>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="telephone"><i class="fas fa-phone"></i> Téléphone</label>
                                        <input type="tel" class="form-control" id="telephone" placeholder="+216 XX XXX XXX" required>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="age"><i class="fas fa-birthday-cake"></i> Âge</label>
                                        <input type="number" class="form-control" id="age" placeholder="Votre âge" required>
                                    </div>
                                </div>
                                
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label for="motif"><i class="fas fa-comment-medical"></i> Motif de consultation</label>
                                        <textarea class="form-control" id="motif" rows="3" placeholder="Décrivez brièvement votre motif de consultation..." required></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn-submit-rdv">
                                    <i class="fas fa-check-circle"></i> Confirmer le rendez-vous
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="rdv-info-box">
                    <div class="info-item">
                        <i class="fas fa-clock"></i>
                        <div>
                            <h5>Confirmation immédiate</h5>
                            <p>Vous recevrez un email de confirmation</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <i class="fas fa-calendar-check"></i>
                        <div>
                            <h5>Rappel automatique</h5>
                            <p>Notification 24h avant votre RDV</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <i class="fas fa-times-circle"></i>
                        <div>
                            <h5>Annulation gratuite</h5>
                            <p>Jusqu'à 24h avant le rendez-vous</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.getElementById('rdvForm').addEventListener('submit', function(e) {
    e.preventDefault();
    alert('Votre rendez-vous a été enregistré avec succès ! Vous recevrez un email de confirmation.');
});
</script>
{% endblock %}
