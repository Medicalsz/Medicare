{% extends 'base.html.twig' %}

{% block title %}Donnations - Medicare{% endblock %}

{% block stylesheets %}
  <style>
    .donation-header {
      padding: 120px 0 60px 0;
      background: linear-gradient(135deg, var(--accent-color) 0%, #067d87 100%);
      color: white;
      text-align: center;
    }

    #header {
      background-color: rgba(255, 255, 255, 0.95);
      box-shadow: 0px 2px 15px rgba(0, 0, 0, 0.1);
    }

    .cause-card {
      background: var(--surface-color);
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(0,0,0,0.05);
    }

    .cause-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
    }

    .cause-img {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    .cause-content {
      padding: 25px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .cause-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--heading-color);
      margin-bottom: 15px;
      font-family: var(--heading-font);
    }

    .cause-description {
      color: var(--default-color);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    .btn-donner {
      background: var(--accent-color);
      color: white;
      border: none;
      padding: 12px 25px;
      border-radius: 50px;
      font-weight: 600;
      transition: 0.3s;
      width: 100%;
      text-align: center;
    }

    .btn-donner:hover {
      background: #067d87;
      color: white;
      box-shadow: 0 5px 15px rgba(9, 154, 167, 0.3);
    }

    .empty-state {
      text-align: center;
      padding: 100px 0;
    }
    
    .empty-state i {
      font-size: 4rem;
      color: #dee2e6;
      margin-bottom: 20px;
    }
  </style>
{% endblock %}

{% block body %}
  <main class="main">

    <section class="donation-header">
      <div class="container">
        <h1 data-aos="fade-up">Soutenez nos causes</h1>
        <p data-aos="fade-up" data-aos-delay="100">Votre générosité peut sauver des vies et améliorer le quotidien de nombreux patients.</p>
      </div>
    </section>

    <section id="causes" class="causes section py-5">
      <div class="container">
        <div class="row gy-4">
          {% for cause in causes %}
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
              <div class="cause-card">
                {% if cause.images|length > 0 %}
                  {% set image = cause.images[0] %}
                  {% if image.imageFile %}
                    <img src="{{ vich_uploader_asset(image, 'imageFile') }}" alt="{{ cause.titre }}" class="cause-img">
                  {% else %}
                    <img src="{{ image.urlImage }}" alt="{{ cause.titre }}" class="cause-img">
                  {% endif %}
                {% else %}
                  <img src="{{ asset('assets/img/health/facilities-3.webp') }}" alt="Default Cause" class="cause-img">
                {% endif %}
                <div class="cause-content">
                  <h3 class="cause-title">{{ cause.titre }}</h3>
                  <p class="cause-description">{{ cause.description|slice(0, 150) }}...</p>
                  <a href="{{ path('app_donation_show', {'id': cause.id}) }}" class="btn-donner">En savoir plus</a>
                </div>
              </div>
            </div>
          {% else %}
            <div class="col-12">
              <div class="empty-state">
                <i class="bi bi-heart-pulse"></i>
                <h3>Aucune cause active pour le moment</h3>
                <p>Revenez bientôt pour découvrir de nouvelles opportunités de soutenir nos patients.</p>
                <a href="{{ path('app_home') }}" class="btn btn-outline-primary mt-3">Retour à l'accueil</a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

  </main>
{% endblock %}
