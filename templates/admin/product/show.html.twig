{% extends 'admin/base.html.twig' %}

{% block title %}{{ product.name }} - Product Details{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="card-title mb-0">Product Details</h4>
          <div>
            <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-warning btn-sm">
              <i class="mdi mdi-pencil"></i> Edit
            </a>
            <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary btn-sm">
              <i class="mdi mdi-arrow-left"></i> Back to List
            </a>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <table class="table table-borderless">
              <tr><th width="35%">ID</th><td>{{ product.id }}</td></tr>
              <tr><th>Name</th><td>{{ product.name }}</td></tr>
              <tr><th>SKU</th><td><code>{{ product.sku }}</code></td></tr>
              <tr><th>Type</th><td><span class="badge {{ product.type.badgeClass }}">{{ product.type.label }}</span></td></tr>
              <tr><th>Price</th><td>${{ product.price|number_format(2) }}</td></tr>
              <tr><th>Quantity</th><td>{{ product.quantity }}</td></tr>
              <tr><th>Dosage</th><td>{{ product.dosage ?? 'N/A' }}</td></tr>
              <tr><th>Status</th><td>
                {% if product.isActive %}
                  <span class="badge bg-success">Active</span>
                {% else %}
                  <span class="badge bg-secondary">Inactive</span>
                {% endif %}
              </td></tr>
              <tr><th>Expiry Date</th><td>{{ product.expiryDate ? product.expiryDate|date('Y-m-d') : 'N/A' }}</td></tr>
              <tr><th>Created</th><td>{{ product.createdAt|date('Y-m-d H:i') }}</td></tr>
            </table>
          </div>
          <div class="col-md-6">
            <h5>Description</h5>
            <p class="text-muted">{{ product.description ?? 'No description provided.' }}</p>

            <h5 class="mt-4">Commandes ({{ product.commandes|length }})</h5>
            {% if product.commandes|length > 0 %}
            <div class="table-responsive">
              <table class="table table-sm table-striped">
                <thead>
                  <tr><th>#</th><th>Number</th><th>Qty</th><th>Total</th><th>Status</th></tr>
                </thead>
                <tbody>
                  {% for cmd in product.commandes %}
                  <tr>
                    <td>{{ cmd.id }}</td>
                    <td><a href="{{ path('admin_commande_show', {id: cmd.id}) }}">{{ cmd.commandeNumber }}</a></td>
                    <td>{{ cmd.quantity }}</td>
                    <td>${{ cmd.totalPrice|number_format(2) }}</td>
                    <td><span class="badge {{ cmd.statusBadgeClass }}">{{ cmd.status }}</span></td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% else %}
              <p class="text-muted">No commandes for this product.</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
