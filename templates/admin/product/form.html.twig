{% extends 'admin/base.html.twig' %}

{% block title %}{{ is_edit ? 'Edit' : 'New' }} Product - Admin{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-8 grid-margin stretch-card mx-auto">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="card-title mb-0">{{ is_edit ? 'Edit Product: ' ~ product.name : 'New Product' }}</h4>
          <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="mdi mdi-arrow-left"></i> Back
          </a>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
          <div class="row">
            <div class="col-md-6 mb-3">
              {{ form_label(form.name) }}
              {{ form_widget(form.name) }}
              {{ form_errors(form.name) }}
            </div>
            <div class="col-md-6 mb-3">
              {{ form_label(form.sku) }}
              {{ form_widget(form.sku) }}
              {{ form_errors(form.sku) }}
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              {{ form_label(form.type) }}
              {{ form_widget(form.type) }}
              {{ form_errors(form.type) }}
            </div>
            <div class="col-md-4 mb-3">
              {{ form_label(form.price) }}
              {{ form_widget(form.price) }}
              {{ form_errors(form.price) }}
            </div>
            <div class="col-md-4 mb-3">
              {{ form_label(form.quantity) }}
              {{ form_widget(form.quantity) }}
              {{ form_errors(form.quantity) }}
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              {{ form_label(form.dosage) }}
              {{ form_widget(form.dosage) }}
              {{ form_errors(form.dosage) }}
            </div>
            <div class="col-md-4 mb-3">
              {{ form_label(form.expiryDate) }}
              {{ form_widget(form.expiryDate) }}
              {{ form_errors(form.expiryDate) }}
            </div>
            <div class="col-md-4 mb-3 d-flex align-items-center pt-4">
              <div class="form-check">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive) }}
              </div>
            </div>
          </div>
          <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="mdi mdi-content-save"></i> {{ is_edit ? 'Update' : 'Create' }}
            </button>
            <a href="{{ path('admin_product_index') }}" class="btn btn-light">Cancel</a>
          </div>
        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
