{% extends 'admin/base.html.twig' %}

{% block title %}Products - Admin{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="card-title mb-0">Products</h4>
          <a href="{{ path('admin_product_new') }}" class="btn btn-primary btn-sm">
            <i class="mdi mdi-plus"></i> Add Product
          </a>
        </div>

        {% for message in app.flashes('success') %}
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}

        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>#</th>
                <th>Name</th>
                <th>SKU</th>
                <th>Type</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for product in products %}
              <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td><code>{{ product.sku }}</code></td>
                <td><span class="badge {{ product.type.badgeClass }}">{{ product.type.label }}</span></td>
                <td>${{ product.price|number_format(2) }}</td>
                <td>{{ product.quantity }}</td>
                <td>
                  {% if product.isActive %}
                    <span class="badge bg-success">Active</span>
                  {% else %}
                    <span class="badge bg-secondary">Inactive</span>
                  {% endif %}
                </td>
                <td>
                  <a href="{{ path('admin_product_show', {id: product.id}) }}" class="btn btn-info btn-sm" title="View">
                    <i class="mdi mdi-eye"></i>
                  </a>
                  <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-warning btn-sm" title="Edit">
                    <i class="mdi mdi-pencil"></i>
                  </a>
                  <form action="{{ path('admin_product_delete', {id: product.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                    <button class="btn btn-danger btn-sm" title="Delete"><i class="mdi mdi-delete"></i></button>
                  </form>
                </td>
              </tr>
              {% else %}
              <tr>
                <td colspan="8" class="text-center text-muted py-4">No products found.</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {% if totalPages > 1 %}
        <nav class="mt-4">
          <ul class="pagination justify-content-center">
            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
              <a class="page-link" href="{{ path('admin_product_index', {page: currentPage - 1}) }}">Previous</a>
            </li>
            {% for i in 1..totalPages %}
            <li class="page-item {% if i == currentPage %}active{% endif %}">
              <a class="page-link" href="{{ path('admin_product_index', {page: i}) }}">{{ i }}</a>
            </li>
            {% endfor %}
            <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
              <a class="page-link" href="{{ path('admin_product_index', {page: currentPage + 1}) }}">Next</a>
            </li>
          </ul>
        </nav>
        {% endif %}

        <p class="text-muted mt-2">Total: {{ total }} product(s)</p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
