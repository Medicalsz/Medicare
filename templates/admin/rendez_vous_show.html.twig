<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actions rendez-vous - Medicare</title>
    <link href="{{ asset('assets/img/logomedicare.png') }}" rel="icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ asset('assets/css/admintopbar.css') }}">
    <style>
        body {
            margin: 0;
            background: #f6f8fb;
            font-family: Arial, sans-serif;
            color: #0f172a;
        }

        .admin-rdv-show-wrap {
            max-width: 980px;
            margin: 88px auto 24px;
            padding: 0 16px;
        }

        .admin-rdv-show-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 18px 40px rgba(2, 8, 23, 0.08);
            padding: 20px;
        }

        .admin-rdv-show-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .admin-rdv-back {
            color: #0369a1;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

        .admin-rdv-title {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
        }

        .admin-rdv-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .admin-rdv-item {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 12px;
            background: #f8fafc;
        }

        .admin-rdv-item-label {
            font-size: 12px;
            color: #64748b;
            margin-bottom: 4px;
            font-weight: 700;
        }

        .admin-rdv-item-value {
            font-weight: 700;
            font-size: 14px;
            word-break: break-word;
        }

        .admin-rdv-status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .admin-rdv-status.confirme {
            background: #dcfce7;
            color: #166534;
        }

        .admin-rdv-status.annule {
            background: #fee2e2;
            color: #991b1b;
        }

        .admin-rdv-status.en_attente {
            background: #fff7d6;
            color: #8a6500;
        }

        .admin-rdv-section {
            margin-top: 16px;
            padding-top: 14px;
            border-top: 1px solid #e2e8f0;
        }

        .admin-rdv-section-title {
            margin: 0 0 10px;
            font-size: 16px;
            font-weight: 800;
        }

        .admin-rdv-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .admin-rdv-btn {
            border: none;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .admin-rdv-btn.confirm {
            background: #00bfff;
            color: #fff;
        }

        .admin-rdv-btn.reject {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .admin-rdv-btn.delete {
            background: #0f172a;
            color: #fff;
        }

        .admin-rdv-report-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
        }

        .admin-rdv-input-wrap {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .admin-rdv-input-wrap label {
            font-size: 12px;
            font-weight: 700;
            color: #475569;
        }

        .admin-rdv-input-wrap input {
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 9px 10px;
            font-size: 13px;
            font-weight: 600;
            outline: none;
        }

        .admin-rdv-input-wrap input:focus {
            border-color: #7dd3fc;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.14);
        }

        .admin-rdv-alert {
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 10px;
            font-size: 13px;
            font-weight: 700;
        }

        .admin-rdv-alert.success {
            background: #dcfce7;
            color: #14532d;
        }

        .admin-rdv-alert.error {
            background: #fee2e2;
            color: #991b1b;
        }

        .admin-rdv-alert.info {
            background: #e0f2fe;
            color: #075985;
        }

        .admin-rdv-note {
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e3a8a;
        }

        .admin-rdv-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            box-shadow: none;
        }
    </style>
</head>
<body>
    {% include '_admintopbar.html.twig' %}

    <div class="admin-rdv-show-wrap">
        {% for message in app.flashes('success') %}
            <div class="admin-rdv-alert success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="admin-rdv-alert error">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="admin-rdv-alert info">{{ message }}</div>
        {% endfor %}

        {% set statut = rendezVous.statut.value|lower %}
        {% set canAdminConfirm = statut != 'confirme' %}
        {% set canAdminReject = statut != 'annule' %}
        <div class="admin-rdv-show-card">
            <div class="admin-rdv-show-top">
                <a href="{{ path('app_admin_rendez_vous') }}" class="admin-rdv-back">
                    <i class="bi bi-arrow-left"></i> Retour liste rendez-vous
                </a>
                <span class="admin-rdv-status {{ statut }}">{{ rendezVous.statut.value|replace({'_': ' '}) }}</span>
            </div>

            <h1 class="admin-rdv-title">Rendez-vous #{{ rendezVous.id }}</h1>

            <div class="admin-rdv-grid">
                <div class="admin-rdv-item">
                    <div class="admin-rdv-item-label">Patient</div>
                    <div class="admin-rdv-item-value">{{ rendezVous.patient.user.prenom }} {{ rendezVous.patient.user.nom }}</div>
                </div>
                <div class="admin-rdv-item">
                    <div class="admin-rdv-item-label">Medecin</div>
                    <div class="admin-rdv-item-value">Dr {{ rendezVous.medecin.user.prenom }} {{ rendezVous.medecin.user.nom }}</div>
                </div>
                <div class="admin-rdv-item">
                    <div class="admin-rdv-item-label">Specialite</div>
                    <div class="admin-rdv-item-value">{{ rendezVous.medecin.specialiteRef ? rendezVous.medecin.specialiteRef.nom : rendezVous.medecin.specialite }}</div>
                </div>
                <div class="admin-rdv-item">
                    <div class="admin-rdv-item-label">Date / Heure actuelle</div>
                    <div class="admin-rdv-item-value">{{ rendezVous.date|date('d/m/Y') }} a {{ rendezVous.heure|date('H:i') }}</div>
                </div>
            </div>

            {% if rendezVous.reportPendingMedecinResponse and rendezVous.proposedDate and rendezVous.proposedHeure %}
                <div class="admin-rdv-note">
                    Report admin en attente de decision medecin: propose pour le {{ rendezVous.proposedDate|date('d/m/Y') }} a {{ rendezVous.proposedHeure|date('H:i') }}.
                </div>
            {% elseif rendezVous.reportPendingPatientResponse and rendezVous.proposedDate and rendezVous.proposedHeure %}
                <div class="admin-rdv-note">
                    Report en attente de decision patient: propose pour le {{ rendezVous.proposedDate|date('d/m/Y') }} a {{ rendezVous.proposedHeure|date('H:i') }}.
                </div>
            {% endif %}

            <div class="admin-rdv-section">
                <h2 class="admin-rdv-section-title">Actions administration</h2>
                <div class="admin-rdv-actions">
                    <form method="post" action="{{ path('app_admin_confirm_rendez_vous', {'id': rendezVous.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_confirm_rdv_' ~ rendezVous.id) }}">
                        <button
                            type="submit"
                            class="admin-rdv-btn confirm"
                            {{ canAdminConfirm ? '' : 'disabled' }}
                            title="{{ canAdminConfirm ? 'Confirmer ce rendez-vous' : 'Deja confirme' }}"
                        >
                            Confirmer
                        </button>
                    </form>
                    <form method="post" action="{{ path('app_admin_reject_rendez_vous', {'id': rendezVous.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_reject_rdv_' ~ rendezVous.id) }}">
                        <button
                            type="submit"
                            class="admin-rdv-btn reject"
                            {{ canAdminReject ? '' : 'disabled' }}
                            title="{{ canAdminReject ? 'Annuler ce rendez-vous' : 'Deja annule' }}"
                        >
                            Rejeter / Annuler
                        </button>
                    </form>
                </div>

                <form method="post" action="{{ path('app_admin_report_rendez_vous', {'id': rendezVous.id}) }}" style="margin-top: 12px;">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_report_rdv_' ~ rendezVous.id) }}">
                    <div class="admin-rdv-report-row">
                        <div class="admin-rdv-input-wrap">
                            <label for="date_rdv">Nouvelle date</label>
                            <input
                                id="date_rdv"
                                type="date"
                                name="date_rdv"
                                value="{{ rendezVous.proposedDate ? rendezVous.proposedDate|date('Y-m-d') : rendezVous.date|date('Y-m-d') }}"
                                required
                            >
                        </div>
                        <div class="admin-rdv-input-wrap">
                            <label for="heure_rdv">Nouvelle heure</label>
                            <input
                                id="heure_rdv"
                                type="time"
                                step="1800"
                                name="heure_rdv"
                                value="{{ rendezVous.proposedHeure ? rendezVous.proposedHeure|date('H:i') : rendezVous.heure|date('H:i') }}"
                                required
                            >
                        </div>
                    </div>
                    <div class="admin-rdv-actions">
                        <button type="submit" class="admin-rdv-btn confirm">Reporter (validation medecin d abord)</button>
                    </div>
                </form>
            </div>

            <div class="admin-rdv-section">
                <h2 class="admin-rdv-section-title">Ordonnance</h2>
                {% if consultation and consultation.ordonnance %}
                    <div class="admin-rdv-item">
                        <div class="admin-rdv-item-label">Contenu ordonnance</div>
                        <div class="admin-rdv-item-value">{{ consultation.ordonnance|nl2br }}</div>
                    </div>
                    <div class="admin-rdv-actions">
                        <form method="post" action="{{ path('app_admin_delete_rendez_vous_ordonnance', {'id': rendezVous.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_ordonnance_rdv_' ~ rendezVous.id) }}">
                            <button type="submit" class="admin-rdv-btn delete">Supprimer ordonnance</button>
                        </form>
                    </div>
                {% else %}
                    <div class="admin-rdv-note">Aucune ordonnance liee a ce rendez-vous.</div>
                {% endif %}
            </div>
        </div>
    </div>
</body>
</html>
