{% extends 'admin/base.html.twig' %}

{% block title %}Commandes - Admin{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="card-title mb-0">Commandes</h4>
          <a href="{{ path('admin_commande_new') }}" class="btn btn-primary btn-sm">
            <i class="mdi mdi-plus"></i> New Commande
          </a>
        </div>

        {% for message in app.flashes('success') %}
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}

        <div class="card border-0 bg-light mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h5 class="mb-0"><i class="mdi mdi-robot"></i> AI Order Summary (Finance & HR)</h5>
              <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" id="exportOrderSummaryPdfBtn" disabled>
                  <i class="mdi mdi-file-pdf-box"></i> Export PDF
                </button>
                <button class="btn btn-primary btn-sm" id="generateOrderSummaryBtn">
                  <i class="mdi mdi-file-document-outline"></i> Generate AI Summary
                </button>
              </div>
            </div>
            <p class="text-muted mb-2" style="font-size: 13px;">
              Generates a professional summary of orders (items, quantities, and special notes), ranked best-first.
            </p>
            <div id="orderSummaryBadge" class="badge badge-info mb-2" style="display:none;">Generated by AI (OpenRouter)</div>
            <div id="orderSummaryContainer" class="p-3 bg-white border rounded" style="min-height: 140px;">
              <div class="mb-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark">Internal Report</h6>
                <small class="text-muted" id="orderSummaryGeneratedAt">Not generated yet</small>
              </div>
              <div id="orderSummaryContent" class="text-muted">Click "Generate AI Summary" to create the report.</div>
            </div>
          </div>
        </div>

        <!-- Filters -->
        <form method="get" class="row g-3 mb-4">
          <div class="col-auto">
            <select name="status" class="form-select form-select-sm">
              <option value="">All Statuses</option>
              {% for val in ['PENDING','PAID','CANCELLED'] %}
                <option value="{{ val }}" {% if currentStatus == val %}selected{% endif %}>{{ val }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-auto">
            <button class="btn btn-outline-primary btn-sm" type="submit">Filter</button>
            <a href="{{ path('admin_commande_index') }}" class="btn btn-outline-secondary btn-sm">Clear</a>
          </div>
        </form>

        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>#</th>
                <th>Number</th>
                <th>Product</th>
                <th>Qty</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for cmd in commandes %}
              <tr>
                <td>{{ cmd.id }}</td>
                <td><code>{{ cmd.commandeNumber }}</code></td>
                <td>{{ cmd.product ? cmd.product.name : 'N/A' }}</td>
                <td>{{ cmd.quantity }}</td>
                <td>${{ cmd.totalPrice|number_format(2) }}</td>
                <td><span class="badge {{ cmd.statusBadgeClass }}">{{ cmd.status }}</span></td>
                <td>{{ cmd.commandeDate ? cmd.commandeDate|date('Y-m-d') : 'N/A' }}</td>
                <td>
                  <a href="{{ path('admin_commande_show', {id: cmd.id}) }}" class="btn btn-info btn-sm" title="View">
                    <i class="mdi mdi-eye"></i>
                  </a>
                  <a href="{{ path('admin_commande_edit', {id: cmd.id}) }}" class="btn btn-warning btn-sm" title="Edit">
                    <i class="mdi mdi-pencil"></i>
                  </a>
                  <form action="{{ path('admin_commande_delete', {id: cmd.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Delete this commande?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cmd.id) }}">
                    <button class="btn btn-danger btn-sm" title="Delete"><i class="mdi mdi-delete"></i></button>
                  </form>
                </td>
              </tr>
              {% else %}
              <tr>
                <td colspan="8" class="text-center text-muted py-4">No commandes found.</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {% if totalPages > 1 %}
        <nav class="mt-4">
          <ul class="pagination justify-content-center">
            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
              <a class="page-link" href="{{ path('admin_commande_index', {page: currentPage - 1, status: currentStatus}) }}">Previous</a>
            </li>
            {% for i in 1..totalPages %}
            <li class="page-item {% if i == currentPage %}active{% endif %}">
              <a class="page-link" href="{{ path('admin_commande_index', {page: i, status: currentStatus}) }}">{{ i }}</a>
            </li>
            {% endfor %}
            <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
              <a class="page-link" href="{{ path('admin_commande_index', {page: currentPage + 1, status: currentStatus}) }}">Next</a>
            </li>
          </ul>
        </nav>
        {% endif %}

        <p class="text-muted mt-2">Total: {{ total }} commande(s)</p>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block custom_js %}
{{ parent() }}
<script>
  (function () {
    const button = document.getElementById('generateOrderSummaryBtn');
    const pdfButton = document.getElementById('exportOrderSummaryPdfBtn');
    const content = document.getElementById('orderSummaryContent');
    const badge = document.getElementById('orderSummaryBadge');
    const generatedAt = document.getElementById('orderSummaryGeneratedAt');
    let latestSummaryText = '';

    if (!button || !pdfButton || !content || !badge || !generatedAt) {
      return;
    }

    function escapeHtml(text) {
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function formatSummaryToHtml(text) {
      const safe = escapeHtml(text || '');
      const withBold = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      const lines = withBold.split(/\r?\n/);
      let html = '';
      let listOpen = false;

      for (const rawLine of lines) {
        const line = rawLine.trim();

        if (!line) {
          if (listOpen) {
            html += '</ul>';
            listOpen = false;
          }
          html += '<div class="mb-2"></div>';
          continue;
        }

        if (line.startsWith('###')) {
          if (listOpen) {
            html += '</ul>';
            listOpen = false;
          }
          html += `<h6 class="fw-bold mt-2 mb-2">${line.replace(/^###\s*/, '')}</h6>`;
          continue;
        }

        if (line.startsWith('-') || line.startsWith('*')) {
          if (!listOpen) {
            html += '<ul class="mb-2 ps-3">';
            listOpen = true;
          }
          html += `<li class="mb-1">${line.replace(/^[-*]\s*/, '')}</li>`;
          continue;
        }

        if (listOpen) {
          html += '</ul>';
          listOpen = false;
        }

        html += `<p class="mb-2 text-dark">${line}</p>`;
      }

      if (listOpen) {
        html += '</ul>';
      }

      return html || '<p class="text-muted mb-0">No summary returned.</p>';
    }

    button.addEventListener('click', async function () {
      button.disabled = true;
      pdfButton.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Generating...';
      content.innerHTML = '<p class="text-muted mb-0">Generating professional summary...</p>';

      try {
        const response = await fetch('{{ path('admin_commande_ai_summary') }}', {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });
        const data = await response.json();

        latestSummaryText = data.summary || '';
        content.innerHTML = formatSummaryToHtml(latestSummaryText);
        badge.style.display = 'inline-block';
        badge.textContent = data.generatedBy || 'Generated by AI';
        generatedAt.textContent = 'Generated on ' + new Date().toLocaleString();
        pdfButton.disabled = latestSummaryText.trim() === '';
      } catch (error) {
        content.innerHTML = '<p class="text-danger mb-0">Failed to generate summary. Please try again.</p>';
        generatedAt.textContent = 'Generation failed';
      }

      button.disabled = false;
      button.innerHTML = '<i class="mdi mdi-file-document-outline"></i> Generate AI Summary';
    });

    pdfButton.addEventListener('click', function () {
      if (!latestSummaryText.trim()) {
        return;
      }

      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '{{ path('admin_commande_ai_summary_pdf') }}';

      const summaryField = document.createElement('input');
      summaryField.type = 'hidden';
      summaryField.name = 'summary';
      summaryField.value = latestSummaryText;
      form.appendChild(summaryField);

      const generatedByField = document.createElement('input');
      generatedByField.type = 'hidden';
      generatedByField.name = 'generatedBy';
      generatedByField.value = badge.textContent || 'Generated by AI (OpenRouter)';
      form.appendChild(generatedByField);

      document.body.appendChild(form);
      form.submit();
      document.body.removeChild(form);
    });
  })();
</script>
{% endblock %}
