{% extends 'admin/base.html.twig' %}

{% block title %}{{ is_edit ? 'Edit' : 'New' }} Commande - Admin{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-8 grid-margin stretch-card mx-auto">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="card-title mb-0">{{ is_edit ? 'Edit Commande: ' ~ commande.commandeNumber : 'New Commande' }}</h4>
          <a href="{{ path('admin_commande_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="mdi mdi-arrow-left"></i> Back
          </a>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
          <div class="row">
            <div class="col-md-8 mb-3">
              {{ form_label(form.product) }}
              {{ form_widget(form.product) }}
              {{ form_errors(form.product) }}
            </div>
            <div class="col-md-4 mb-3">
              {{ form_label(form.quantity) }}
              {{ form_widget(form.quantity) }}
              {{ form_errors(form.quantity) }}
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              {{ form_label(form.status) }}
              {{ form_widget(form.status) }}
              {{ form_errors(form.status) }}
            </div>
            <div class="col-md-6 mb-3">
              {{ form_label(form.deliveryDate) }}
              {{ form_widget(form.deliveryDate) }}
              {{ form_errors(form.deliveryDate) }}
            </div>
          </div>
          <div class="mb-3">
            {{ form_label(form.notes) }}
            {{ form_widget(form.notes) }}
            {{ form_errors(form.notes) }}
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="mdi mdi-content-save"></i> {{ is_edit ? 'Update' : 'Create' }}
            </button>
            <a href="{{ path('admin_commande_index') }}" class="btn btn-light">Cancel</a>
          </div>
        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
