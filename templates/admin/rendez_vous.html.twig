{% extends 'admin_base.html.twig' %}

{% block title %}Rendez-vous{% endblock %}

{% block body %}
<div class="admin-page-header">
    <h1 class="admin-page-title">Rendez-vous Plateforme</h1>
    <p class="admin-page-subtitle">Tous les rendez-vous pris, quel que soit le statut.</p>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title"><i class="bi bi-calendar-check"></i> Liste des rendez-vous</h3>
    </div>
    <div class="admin-card-body">
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Medecin</th>
                        <th>Specialite</th>
                        <th>Date RDV</th>
                        <th>Heure</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rdv in rendezVous %}
                        {% set statut = rdv.statut ? rdv.statut.value : 'INCONNU' %}
                        <tr>
                            <td>{{ rdv.id }}</td>
                            <td>{{ rdv.patient.user.prenom }} {{ rdv.patient.user.nom }}</td>
                            <td>Dr {{ rdv.medecin.user.prenom }} {{ rdv.medecin.user.nom }}</td>
                            <td>{{ rdv.medecin.specialiteRef ? rdv.medecin.specialiteRef.nom : rdv.medecin.specialite }}</td>
                            <td>{{ rdv.date ? rdv.date|date('d/m/Y') : '-' }}</td>
                            <td>{{ rdv.heure ? rdv.heure|date('H:i') : '-' }}</td>
                            <td>
                                {% if statut == 'CONFIRME' %}
                                    <span class="admin-badge success">Confirme</span>
                                {% elseif statut == 'ANNULE' %}
                                    <span class="admin-badge danger">Annule</span>
                                {% else %}
                                    <span class="admin-badge warning">En attente</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">Aucun rendez-vous trouve.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

