{% extends 'admin_base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/admindashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <h1 class="admin-page-title">Dashboard Administration</h1>
        <p class="admin-page-subtitle">Bienvenue dans votre espace d'administration Medicare</p>
    </div>

    {# Stats Cards #}
    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon primary">
                <i class="bi bi-people"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Total Utilisateurs</div>
                <div class="admin-stat-value">1,234</div>
                <div class="admin-stat-change positive">
                    <i class="bi bi-arrow-up"></i> +12% ce mois
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon success">
                <i class="bi bi-person-heart"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Patients Actifs</div>
                <div class="admin-stat-value">856</div>
                <div class="admin-stat-change positive">
                    <i class="bi bi-arrow-up"></i> +8% ce mois
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon warning">
                <i class="bi bi-hospital"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Médecins</div>
                <div class="admin-stat-value">142</div>
                <div class="admin-stat-change positive">
                    <i class="bi bi-arrow-up"></i> +5 ce mois
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon info">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="admin-stat-content">
                <div class="admin-stat-label">Rendez-vous</div>
                <div class="admin-stat-value">523</div>
                <div class="admin-stat-change negative">
                    <i class="bi bi-arrow-down"></i> -3% ce mois
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-calendar-event"></i> Rendez-vous Récents
                    </h3>
                    <button class="admin-btn admin-btn-primary">
                        <i class="bi bi-plus-circle"></i> Nouveau
                    </button>
                </div>
                <div class="admin-card-body">
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Médecin</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Marie Dupont</td>
                                    <td>Dr. Jean Martin</td>
                                    <td>15/02/2026 14:30</td>
                                    <td><span class="admin-badge success">Confirmé</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Pierre Lemoine</td>
                                    <td>Dr. Sophie Bernard</td>
                                    <td>16/02/2026 09:00</td>
                                    <td><span class="admin-badge warning">En attente</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Claire Dubois</td>
                                    <td>Dr. Luc Petit</td>
                                    <td>16/02/2026 11:00</td>
                                    <td><span class="admin-badge success">Confirmé</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Thomas Moreau</td>
                                    <td>Dr. Anne Lefebvre</td>
                                    <td>17/02/2026 15:45</td>
                                    <td><span class="admin-badge danger">Annulé</span></td>
                                    <td>
                                        <button class="admin-btn admin-btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-graph-up"></i> Activités
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="activity-item mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon primary" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-person-plus"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">Nouvel utilisateur</div>
                                <small style="color: #888;">Il y a 5 minutes</small>
                            </div>
                        </div>
                    </div>

                    <div class="activity-item mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon success" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">RDV confirmé</div>
                                <small style="color: #888;">Il y a 15 minutes</small>
                            </div>
                        </div>
                    </div>

                    <div class="activity-item mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon warning" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">Nouveau médecin</div>
                                <small style="color: #888;">Il y a 1 heure</small>
                            </div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-stat-icon info" style="width: 40px; height: 40px; font-size: 18px;">
                                <i class="bi bi-file-text"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1e1e2d;">Rapport généré</div>
                                <small style="color: #888;">Il y a 2 heures</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">
                        <i class="bi bi-bell"></i> Notifications
                    </h3>
                </div>
                <div class="admin-card-body">
                    <div class="alert alert-warning mb-2" role="alert">
                        <strong>5</strong> demandes médecins en attente
                    </div>
                    <div class="alert alert-info mb-2" role="alert">
                        <strong>12</strong> nouveaux messages
                    </div>
                    <div class="alert alert-success" role="alert">
                        Système à jour
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
