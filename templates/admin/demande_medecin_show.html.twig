{% extends 'base.html.twig' %}

{% block title %}Detail Demande Medecin{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ asset('assets/css/admindashboard.css') }}">
    <style>
        body {
            background: #f5f7fb;
        }

        .fullpage-wrap {
            width: 100%;
            min-height: 100vh;
            padding: 24px clamp(12px, 3vw, 36px) 32px;
        }

        .demande-header-title {
            text-align: right;
            margin-left: auto;
        }

        .doc-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .doc-sections-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 16px;
            align-items: start;
        }

        .doc-section {
            border: 1px solid #e5edf6;
            border-radius: 12px;
            padding: 12px;
            background: #fbfdff;
            min-height: 100%;
        }

        .single-doc-card {
            max-width: 220px;
        }

        .doc-card {
            border: 1px solid #dbe7f3;
            border-radius: 12px;
            background: #f8fbff;
            padding: 10px;
            text-decoration: none;
            color: #334155;
            display: grid;
            gap: 8px;
        }

        .doc-card:hover {
            border-color: #9ed8f5;
            box-shadow: 0 6px 18px rgba(0, 191, 255, 0.15);
        }

        .doc-preview {
            height: 92px;
            border-radius: 8px;
            border: 1px solid #dbe7f3;
            background: #fff;
            display: grid;
            place-items: center;
            overflow: hidden;
            font-size: 30px;
            color: #dc2626;
        }

        .doc-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .doc-name {
            font-size: 12px;
            line-height: 1.3;
            word-break: break-word;
        }

        .doc-modal-body {
            min-height: 360px;
        }

        .doc-modal-image {
            max-width: 100%;
            max-height: 70vh;
            display: none;
            margin: 0 auto;
            border-radius: 8px;
        }

        .doc-modal-frame {
            width: 100%;
            height: 70vh;
            border: 1px solid #dbe7f3;
            border-radius: 8px;
            display: none;
        }

        @media (max-width: 992px) {
            .doc-sections-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="fullpage-wrap">
    <div class="admin-page-header d-flex align-items-start flex-wrap gap-2">
        <a href="{{ path('app_admin_medecins') }}" class="admin-btn admin-btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <div class="demande-header-title">
            <h1 class="admin-page-title">Demande Medecin #{{ demande.id }}</h1>
            <p class="admin-page-subtitle">Informations saisies par le candidat</p>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info">{{ message }}</div>
    {% endfor %}

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title"><i class="bi bi-file-earmark-medical"></i> Informations demande</h3>
                </div>
                <div class="admin-card-body">
                    <p><strong>Specialite:</strong> {{ demande.specialiteRef ? demande.specialiteRef.nom : demande.specialite }}</p>
                    <p><strong>Cabinet:</strong> {{ demande.cabinet }}</p>
                    <p><strong>Adresse:</strong> {{ demande.adresse }}</p>
                    <p><strong>Bio:</strong> {{ demande.bio ?: 'Non renseignee' }}</p>
                    <p><strong>Date demande:</strong> {{ demande.dateDemande ? demande.dateDemande|date('d/m/Y H:i') : '-' }}</p>
                    <p><strong>Date traitement:</strong> {{ demande.dateTraitement ? demande.dateTraitement|date('d/m/Y H:i') : '-' }}</p>
                    <p>
                        <strong>Statut:</strong>
                        {% if demande.statut.value == 'acceptee' %}
                            <span class="admin-badge success">Acceptee</span>
                        {% elseif demande.statut.value == 'rejetee' %}
                            <span class="admin-badge danger">Rejetee</span>
                        {% else %}
                            <span class="admin-badge warning">En attente</span>
                        {% endif %}
                    </p>
                    {% if demande.raisonRejet %}
                        <p><strong>Raison rejet:</strong> {{ demande.raisonRejet }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title"><i class="bi bi-person-vcard"></i> Candidat</h3>
                </div>
                <div class="admin-card-body">
                    <p><strong>Nom:</strong> {{ demande.user.prenom }} {{ demande.user.nom }}</p>
                    <p><strong>Email:</strong> {{ demande.user.email }}</p>
                    <p><strong>Telephone:</strong> {{ demande.user.numero }}</p>
                    <p><strong>Adresse profil:</strong> {{ demande.user.adresse ?: '-' }}</p>
                </div>
            </div>
        </div>
    </div>

<div class="admin-card mt-4">
    <div class="admin-card-header">
        <h3 class="admin-card-title"><i class="bi bi-paperclip"></i> Documents fournis</h3>
    </div>
    <div class="admin-card-body">
        <div class="doc-sections-row">
            <div class="doc-section">
                <h6 class="mb-2">Certificats</h6>
                <div class="doc-grid">
                    {% for certificat in certificats %}
                        {% set ext = certificat|lower|split('.')|last %}
                        {% set isImage = ext in ['jpg', 'jpeg', 'png', 'webp', 'gif'] %}
                        <a href="#" class="doc-card js-doc-open" data-doc-url="{{ asset(certificat) }}" data-doc-type="{{ isImage ? 'image' : 'file' }}" data-doc-name="Certificat {{ loop.index }}">
                            <div class="doc-preview">
                                {% if isImage %}
                                    <img src="{{ asset(certificat) }}" alt="Certificat {{ loop.index }}">
                                {% else %}
                                    <i class="bi bi-file-earmark-pdf"></i>
                                {% endif %}
                            </div>
                            <div class="doc-name">Certificat {{ loop.index }}</div>
                        </a>
                    {% else %}
                        <span class="text-muted">Aucun certificat.</span>
                    {% endfor %}
                </div>
            </div>

            <div class="doc-section">
                <h6 class="mb-2">Carte de service</h6>
                {% if demande.carteService %}
                    {% set extService = demande.carteService|lower|split('.')|last %}
                    {% set isServiceImage = extService in ['jpg', 'jpeg', 'png', 'webp', 'gif'] %}
                    <a href="#" class="doc-card js-doc-open single-doc-card" data-doc-url="{{ asset(demande.carteService) }}" data-doc-type="{{ isServiceImage ? 'image' : 'file' }}" data-doc-name="Carte de service">
                        <div class="doc-preview">
                            {% if isServiceImage %}
                                <img src="{{ asset(demande.carteService) }}" alt="Carte de service">
                            {% else %}
                                <i class="bi bi-file-earmark-pdf"></i>
                            {% endif %}
                        </div>
                        <div class="doc-name">Carte de service</div>
                    </a>
                {% else %}
                    <span class="text-muted">Non fournie.</span>
                {% endif %}
            </div>

            <div class="doc-section">
                <h6 class="mb-2">Carte d'identite</h6>
                {% if demande.carteIdentite %}
                    {% set extIdentite = demande.carteIdentite|lower|split('.')|last %}
                    {% set isIdentiteImage = extIdentite in ['jpg', 'jpeg', 'png', 'webp', 'gif'] %}
                    <a href="#" class="doc-card js-doc-open single-doc-card" data-doc-url="{{ asset(demande.carteIdentite) }}" data-doc-type="{{ isIdentiteImage ? 'image' : 'file' }}" data-doc-name="Carte d'identite">
                        <div class="doc-preview">
                            {% if isIdentiteImage %}
                                <img src="{{ asset(demande.carteIdentite) }}" alt="Carte d identite">
                            {% else %}
                                <i class="bi bi-file-earmark-pdf"></i>
                            {% endif %}
                        </div>
                        <div class="doc-name">Carte d'identite</div>
                    </a>
                {% else %}
                    <span class="text-muted">Non fournie.</span>
                {% endif %}
            </div>
        </div>
    </div>
</div>

    {% if demande.statut.value == 'en_attente' %}
        <div class="admin-card mt-4">
            <div class="admin-card-header">
                <h3 class="admin-card-title"><i class="bi bi-check2-square"></i> Action Admin</h3>
            </div>
            <div class="admin-card-body">
                <div class="d-flex flex-wrap gap-3 align-items-center justify-content-center">
                    <form method="post" action="{{ path('app_admin_approve_medecin', {'id': demande.id}) }}">
                        <button type="submit" class="admin-btn admin-btn-success">
                            <i class="bi bi-check2-circle"></i> Approuver la demande
                        </button>
                    </form>

                    <button type="button" class="admin-btn admin-btn-danger" data-bs-toggle="modal" data-bs-target="#rejectDemandeModal">
                        <i class="bi bi-x-circle"></i> Rejeter la demande
                    </button>
                </div>
            </div>
        </div>

        <div class="modal fade" id="rejectDemandeModal" tabindex="-1" aria-labelledby="rejectDemandeModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="{{ path('app_admin_reject_medecin', {'id': demande.id}) }}">
                        <div class="modal-header">
                            <h5 class="modal-title" id="rejectDemandeModalLabel">Rejeter la demande</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="raison_rejet_modal"><strong>Raison du rejet (optionnel)</strong></label>
                            <textarea id="raison_rejet_modal" name="raison_rejet" class="form-control" rows="4" placeholder="Ex: document incomplet, informations incoherentes..."></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-danger">Confirmer le rejet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="modal fade" id="docViewerModal" tabindex="-1" aria-labelledby="docViewerTitle" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="docViewerTitle">Apercu document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body doc-modal-body">
                    <img id="docViewerImage" class="doc-modal-image" alt="Apercu image">
                    <iframe id="docViewerFrame" class="doc-modal-frame" title="Apercu fichier"></iframe>
                </div>
                <div class="modal-footer">
                    <a id="docViewerOpenLink" href="#" target="_blank" class="btn btn-outline-primary">Ouvrir dans un nouvel onglet</a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('docViewerModal');
            if (!modalEl || typeof bootstrap === 'undefined') {
                return;
            }

            const modal = new bootstrap.Modal(modalEl);
            const titleEl = document.getElementById('docViewerTitle');
            const imageEl = document.getElementById('docViewerImage');
            const frameEl = document.getElementById('docViewerFrame');
            const openLinkEl = document.getElementById('docViewerOpenLink');

            function resetViewer() {
                imageEl.style.display = 'none';
                frameEl.style.display = 'none';
                imageEl.removeAttribute('src');
                frameEl.removeAttribute('src');
            }

            document.querySelectorAll('.js-doc-open').forEach((trigger) => {
                trigger.addEventListener('click', function (event) {
                    event.preventDefault();

                    const url = this.dataset.docUrl;
                    const type = this.dataset.docType || 'file';
                    const name = this.dataset.docName || 'Document';

                    if (!url) {
                        return;
                    }

                    resetViewer();
                    titleEl.textContent = name;
                    openLinkEl.href = url;

                    if (type === 'image') {
                        imageEl.src = url;
                        imageEl.style.display = 'block';
                    } else {
                        frameEl.src = url;
                        frameEl.style.display = 'block';
                    }

                    modal.show();
                });
            });

            modalEl.addEventListener('hidden.bs.modal', resetViewer);
        });
    </script>
{% endblock %}
