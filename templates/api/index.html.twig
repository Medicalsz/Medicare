{% extends 'base.html.twig' %}

{% block title %}Explore Health Data - Medicare{% endblock %}

{% block body %}
<div class="container" style="margin-top: 120px; margin-bottom: 60px;">
    <div class="row">
        <div class="col-12 text-center mb-5">
            <h2 class="section-title">Explore Health Data</h2>
            <p class="text-muted">Real-time statistics and medical information from trusted APIs.</p>
        </div>
    </div>

    <div class="row g-4">
        {# Disease Stats Section #}
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-header bg-primary text-white" style="border-radius: 15px 15px 0 0; padding: 20px;">
                    <h4 class="mb-0"><i class="bi bi-graph-up me-2"></i> Global COVID-19 Statistics</h4>
                </div>
                <div class="card-body p-4">
                    {% if disease %}
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 text-center">
                                    <h6 class="text-muted mb-1">Total Cases</h6>
                                    <h4 class="text-primary mb-0">{{ disease.cases|number_format }}</h4>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 text-center">
                                    <h6 class="text-muted mb-1">Total Deaths</h6>
                                    <h4 class="text-danger mb-0">{{ disease.deaths|number_format }}</h4>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 text-center">
                                    <h6 class="text-muted mb-1">Recovered</h6>
                                    <h4 class="text-success mb-0">{{ disease.recovered|number_format }}</h4>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 text-center">
                                    <h6 class="text-muted mb-1">Today Cases</h6>
                                    <h4 class="text-warning mb-0">{{ disease.todayCases|number_format }}</h4>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-center text-muted">Unable to fetch disease data. Please check back later.</p>
                    {% endif %}
                </div>
                <div class="card-footer bg-white border-0 text-center pb-3">
                    <small class="text-muted">Source: disease.sh</small>
                </div>
            </div>
        </div>

        {# Drug Info Section #}
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-header bg-success text-white" style="border-radius: 15px 15px 0 0; padding: 20px;">
                    <h4 class="mb-0"><i class="bi bi-capsule me-2"></i> Relevant Drug Information</h4>
                </div>
                <div class="card-body p-4">
                    {% if drugs %}
                        <div class="list-group list-group-flush">
                            {% for drug in drugs %}
                                <div class="list-group-item px-0 border-0 mb-3">
                                    <h5 class="text-success">{{ drug.openfda.brand_name[0] ?? 'Generic Med' }}</h5>
                                    <p class="small text-muted mb-1"><strong>Generic:</strong> {{ drug.openfda.generic_name[0] ?? 'N/A' }}</p>
                                    <p class="small mb-0">{{ drug.description[0]|default('No description available')|slice(0, 150) }}...</p>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-center text-muted">Unable to fetch drug data. Please check back later.</p>
                    {% endif %}
                </div>
                <div class="card-footer bg-white border-0 text-center pb-3">
                    <small class="text-muted">Source: OpenFDA</small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
