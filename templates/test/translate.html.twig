<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Medicare Translator</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Fonts from parent template -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Style adjustments to match the Medicare template */
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f9f9f9;
        }
        .card {
            border: none;
            border-radius: 10px;
        }
        .card-header {
            /* Using a blue color similar to the site's primary theme */
            background-color: #3498db; /* A pleasant blue, adjust if you have a specific hex code */
            color: white;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
            padding: 1rem 1.5rem;
        }
        .card-header h1 {
            font-family: 'Roboto', sans-serif;
            font-weight: 700;
        }
        .form-label {
            font-weight: 600;
        }
        .form-control, .form-select {
            border-radius: 8px;
        }
        .btn-primary {
            background-color: #3498db; /* Matching header color */
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }
        .btn-primary:hover {
            background-color: #2980b9; /* A slightly darker shade for hover */
        }
        .card-body {
            padding: 1.5rem;
        }
        .result-card {
            background-color: #eef7ff;
            border: 1px solid #d1e7fd;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <main class="container-fluid p-3">
        <div class="card shadow-sm">
            <div class="card-header">
                <h1 class="h4 mb-0">Medicare Translator</h1>
            </div>
            <div class="card-body">
                <p class="card-text text-muted mb-4">Enter text, select a target language, and get an instant AI-powered translation.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_translate') }}">
                    <div class="mb-3">
                        <label for="text-to-translate" class="form-label">Text to Translate</label>
                        <textarea class="form-control" id="text-to-translate" name="text-to-translate" rows="5" required placeholder="Type or paste your text here...">{{ original_text }}</textarea>
                    </div>

                    <div class="mb-4">
                        <label for="target-language" class="form-label">Translate to</label>
                        <select class="form-select" id="target-language" name="target-language">
                            {% for lang in languages %}
                                <option value="{{ lang }}" {{ lang == target_language ? 'selected' : '' }}>{{ lang }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-translate me-2"></i>Translate
                        </button>
                    </div>
                </form>

                {% if translated_text %}
                    <hr class="my-4">
                    <div>
                        <h2 class="h5">Translation Result:</h2>
                        <div class="card result-card">
                            <div class="card-body">
                                <p class="card-text" style="font-size: 1.1rem;">{{ translated_text }}</p>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>